<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Gruvbox Light) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFFBF1C7" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFF2E5BC" />
    <SolidColorBrush x:Key="Panel" Color="#FFFBF1C7" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFE6D5A8" />
    <SolidColorBrush x:Key="Border" Color="#FFD5C4A1" />
    <!-- 明色テーマなので、ホバーは暗くする（暗色テーマの「明るくする」とは逆向き）。
         明るくすると Accent 上の白文字が読めなくなる。 -->
    <SolidColorBrush x:Key="Accent" Color="#FFB57614" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF8F5D0F" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF241A0A" />
    <SolidColorBrush x:Key="Fg" Color="#FF3C3836" />
    <SolidColorBrush x:Key="FgDim" Color="#FF7C6F64" />
    <!-- 検索ヒット文字の強調背景（明るい背景でも沈まない半透明アンバー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80D79921" />
    <!-- リストの選択行背景（明背景で文字が読める淡い帯。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFDCC79A" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF79740E" />
    <SolidColorBrush x:Key="Error" Color="#FF9D0006" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。明背景で読める Gruvbox Light。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF7C6F64" />
    <SolidColorBrush x:Key="SymType" Color="#FF427B58" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF076678" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFB57614" />
    <SolidColorBrush x:Key="SymMethod" Color="#FF8F3F71" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF1D6E8C" />
    <SolidColorBrush x:Key="SymField" Color="#FF79740E" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFAF3A03" />

</ResourceDictionary>
