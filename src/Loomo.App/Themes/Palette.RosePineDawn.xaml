<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Rosé Pine Dawn) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFFAF4ED" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFF2E9E1" />
    <SolidColorBrush x:Key="Panel" Color="#FFFAF4ED" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFE5D8CE" />
    <SolidColorBrush x:Key="Border" Color="#FFDFD8D0" />
    <!-- 明色テーマなので、ホバーは暗くする（暗色テーマの「明るくする」とは逆向き）。
         明るくすると Accent 上の白文字が読めなくなる。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF907AA9" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF75618A" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF1E1825" />
    <SolidColorBrush x:Key="Fg" Color="#FF575279" />
    <SolidColorBrush x:Key="FgDim" Color="#FF797593" />
    <!-- 検索ヒット文字の強調背景（明るい背景でも沈まない半透明ゴールド） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80EA9D34" />
    <!-- リストの選択行背景（明背景で文字が読める淡い帯。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFDFDAD9" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF3E7B7F" />
    <SolidColorBrush x:Key="Error" Color="#FFB4637A" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。明背景で読める Rosé Pine Dawn。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF797593" />
    <SolidColorBrush x:Key="SymType" Color="#FF3E7B7F" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF286983" />
    <SolidColorBrush x:Key="SymEnum" Color="#FF9A7414" />
    <SolidColorBrush x:Key="SymMethod" Color="#FF907AA9" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF56949F" />
    <SolidColorBrush x:Key="SymField" Color="#FF2C6E8E" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFB4637A" />

</ResourceDictionary>
