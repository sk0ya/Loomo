<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Kanagawa Lotus) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFF2ECBC" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFE7DBA0" />
    <SolidColorBrush x:Key="Panel" Color="#FFF2ECBC" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFDCD5AC" />
    <SolidColorBrush x:Key="PaneHeaderBg" Color="#FFE0DAAE" />
    <SolidColorBrush x:Key="Border" Color="#FFD5CEA3" />
    <!-- 明色テーマ：Accent 上の文字が白ならホバーは暗く、暗い文字ならホバーは明るくする。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF4D699B" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF3D5683" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFEBEEF4" />
    <SolidColorBrush x:Key="Fg" Color="#FF545464" />
    <SolidColorBrush x:Key="FgDim" Color="#FF8A8980" />
    <!-- 検索ヒット文字の強調背景 -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80E98A00" />
    <!-- リストの選択行背景（複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFC9CBD1" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF6F894E" />
    <SolidColorBrush x:Key="Error" Color="#FFC84053" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF8A8980" />
    <SolidColorBrush x:Key="SymType" Color="#FF597B75" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF4D699B" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFCC6D00" />
    <SolidColorBrush x:Key="SymMethod" Color="#FF624C83" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF4E8CA2" />
    <SolidColorBrush x:Key="SymField" Color="#FF6F894E" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFB35B79" />

</ResourceDictionary>
