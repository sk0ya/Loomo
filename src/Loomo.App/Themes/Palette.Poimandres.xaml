<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Poimandres) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF1B1E28" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF171922" />
    <SolidColorBrush x:Key="Panel" Color="#FF1B1E28" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF252B37" />
    <SolidColorBrush x:Key="PaneHeaderBg" Color="#FF292C35" />
    <SolidColorBrush x:Key="Border" Color="#FF303340" />
    <SolidColorBrush x:Key="Accent" Color="#FF5DE4C7" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF89F0DA" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF123F36" />
    <SolidColorBrush x:Key="Fg" Color="#FFE4F0FB" />
    <SolidColorBrush x:Key="FgDim" Color="#FFA6ACCD" />
    <!-- 検索ヒット文字の強調背景 -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80FFFAC2" />
    <!-- リストの選択行背景（複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF303340" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF5DE4C7" />
    <SolidColorBrush x:Key="Error" Color="#FFD0679D" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF767C9D" />
    <SolidColorBrush x:Key="SymType" Color="#FFFFFAC2" />
    <SolidColorBrush x:Key="SymInterface" Color="#FFADD7FF" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFFCC5E9" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFADD7FF" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF89DDFF" />
    <SolidColorBrush x:Key="SymField" Color="#FF5DE4C7" />
    <SolidColorBrush x:Key="SymConstant" Color="#FF5FB3A1" />

</ResourceDictionary>
