<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Everforest Light（medium）) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFFDF6E3" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFF4F0D9" />
    <SolidColorBrush x:Key="Panel" Color="#FFFDF6E3" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFE6E2CC" />
    <SolidColorBrush x:Key="PaneHeaderBg" Color="#FFEAE3D2" />
    <SolidColorBrush x:Key="Border" Color="#FFE0DCC7" />
    <!-- 明色テーマ：Accent 上の文字が白ならホバーは暗く、暗い文字ならホバーは明るくする。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF8DA101" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFA3B81A" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF2B2F0E" />
    <SolidColorBrush x:Key="Fg" Color="#FF5C6A72" />
    <SolidColorBrush x:Key="FgDim" Color="#FF829181" />
    <!-- 検索ヒット文字の強調背景 -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80DFA000" />
    <!-- リストの選択行背景（複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFE6E9C4" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF8DA101" />
    <SolidColorBrush x:Key="Error" Color="#FFF85552" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF939F91" />
    <SolidColorBrush x:Key="SymType" Color="#FFDFA000" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF3A94C5" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFF57D26" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFDF69BA" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF35A77C" />
    <SolidColorBrush x:Key="SymField" Color="#FF8DA101" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFF57D26" />

</ResourceDictionary>
