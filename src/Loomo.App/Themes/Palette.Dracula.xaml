<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Dracula) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF282A36" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF21222C" />
    <SolidColorBrush x:Key="Panel" Color="#FF282A36" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF44475A" />
    <SolidColorBrush x:Key="Border" Color="#FF44475A" />
    <SolidColorBrush x:Key="Accent" Color="#FFBD93F9" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFD6ACFF" />
    <!-- Accent が明色なので、その上の文字は背景色寄りの暗色にする -->
    <SolidColorBrush x:Key="AccentFg" Color="#FF25123F" />
    <SolidColorBrush x:Key="Fg" Color="#FFF8F8F2" />
    <SolidColorBrush x:Key="FgDim" Color="#FF9AA0BE" />
    <!-- 検索ヒット文字の強調背景（選択行・通常行どちらでも読めるよう半透明イエロー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80F1FA8C" />
    <!-- リストの選択行背景（はっきり見える紫寄りのグレー。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF4B4E6B" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF50FA7B" />
    <SolidColorBrush x:Key="Error" Color="#FFFF5555" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。Dracula の cyan/green/pink/purple 配色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF9AA0BE" />
    <SolidColorBrush x:Key="SymType" Color="#FF8BE9FD" />
    <SolidColorBrush x:Key="SymInterface" Color="#FFA4FFFF" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFF1FA8C" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFFF79C6" />
    <SolidColorBrush x:Key="SymProperty" Color="#FFBD93F9" />
    <SolidColorBrush x:Key="SymField" Color="#FFFFB86C" />
    <SolidColorBrush x:Key="SymConstant" Color="#FF50FA7B" />

</ResourceDictionary>
