<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Vesper（黒地に桃色ひとさじ）) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF101010" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF161616" />
    <SolidColorBrush x:Key="Panel" Color="#FF101010" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="PaneHeaderBg" Color="#FF212121" />
    <SolidColorBrush x:Key="Border" Color="#FF282828" />
    <SolidColorBrush x:Key="Accent" Color="#FFFFC799" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFFFD9B8" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF3F2712" />
    <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FgDim" Color="#FFA0A0A0" />
    <!-- 検索ヒット文字の強調背景 -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80FFC799" />
    <!-- リストの選択行背景（複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF343434" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF99FFE4" />
    <SolidColorBrush x:Key="Error" Color="#FFFF8080" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF8B8B8B" />
    <SolidColorBrush x:Key="SymType" Color="#FFFFC799" />
    <SolidColorBrush x:Key="SymInterface" Color="#FFFFC799" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFFFC799" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF99FFE4" />
    <SolidColorBrush x:Key="SymField" Color="#FF99FFE4" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFFFC799" />

</ResourceDictionary>
