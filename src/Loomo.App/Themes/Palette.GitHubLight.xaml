<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (GitHub Light Default) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFF6F8FA" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFEAEEF2" />
    <SolidColorBrush x:Key="PaneHeaderBg" Color="#FFECECEC" />
    <SolidColorBrush x:Key="Border" Color="#FFD1D9E0" />
    <!-- 明色テーマ：Accent 上の文字が白ならホバーは暗く、暗い文字ならホバーは明るくする。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF0969DA" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF0550AE" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFF0F3F7" />
    <SolidColorBrush x:Key="Fg" Color="#FF1F2328" />
    <SolidColorBrush x:Key="FgDim" Color="#FF59636E" />
    <!-- 検索ヒット文字の強調背景 -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80FFDF5D" />
    <!-- リストの選択行背景（複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFDDF4FF" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF1A7F37" />
    <SolidColorBrush x:Key="Error" Color="#FFCF222E" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF59636E" />
    <SolidColorBrush x:Key="SymType" Color="#FF953800" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF0550AE" />
    <SolidColorBrush x:Key="SymEnum" Color="#FF9A6700" />
    <SolidColorBrush x:Key="SymMethod" Color="#FF8250DF" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF0550AE" />
    <SolidColorBrush x:Key="SymField" Color="#FF116329" />
    <SolidColorBrush x:Key="SymConstant" Color="#FF953800" />

</ResourceDictionary>
