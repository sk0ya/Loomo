<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Catppuccin Latte) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFEFF1F5" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFE6E9EF" />
    <SolidColorBrush x:Key="Panel" Color="#FFEFF1F5" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFDCE0E8" />
    <SolidColorBrush x:Key="Border" Color="#FFCCD0DA" />
    <!-- 明色テーマなので、ホバーは暗くする（暗色テーマの「明るくする」とは逆向き）。
         明るくすると Accent 上の白文字が読めなくなる。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF1E66F5" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF1552CC" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Fg" Color="#FF4C4F69" />
    <SolidColorBrush x:Key="FgDim" Color="#FF7C7F93" />
    <!-- 検索ヒット文字の強調背景（明るい背景でも沈まない半透明イエロー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80DF8E1D" />
    <!-- リストの選択行背景（明背景で文字が読める淡い青。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFD3DBF5" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF40A02B" />
    <SolidColorBrush x:Key="Error" Color="#FFD20F39" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。明背景で読める Catppuccin Latte。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF7C7F93" />
    <SolidColorBrush x:Key="SymType" Color="#FF179299" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF0B7FAD" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFDF8E1D" />
    <SolidColorBrush x:Key="SymMethod" Color="#FF8839EF" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF1E66F5" />
    <SolidColorBrush x:Key="SymField" Color="#FF40A02B" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFD9730D" />

</ResourceDictionary>
