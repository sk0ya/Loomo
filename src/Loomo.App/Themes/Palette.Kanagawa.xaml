<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Kanagawa Wave) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF1F1F28" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF2A2A37" />
    <SolidColorBrush x:Key="Panel" Color="#FF1F1F28" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF16161D" />
    <SolidColorBrush x:Key="Border" Color="#FF363646" />
    <SolidColorBrush x:Key="Accent" Color="#FF7E9CD8" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF9CB4E8" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF13223F" />
    <SolidColorBrush x:Key="Fg" Color="#FFDCD7BA" />
    <SolidColorBrush x:Key="FgDim" Color="#FF9C9A8E" />
    <!-- 検索ヒット文字の強調背景（選択行・通常行どちらでも読めるよう半透明アンバー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80C0A36E" />
    <!-- リストの選択行背景（はっきり見える青。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF2D4F67" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF98BB6C" />
    <SolidColorBrush x:Key="Error" Color="#FFE46876" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。Kanagawa のセマンティック配色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF9C9A8E" />
    <SolidColorBrush x:Key="SymType" Color="#FF7AA89F" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF7E9CD8" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFC0A36E" />
    <SolidColorBrush x:Key="SymMethod" Color="#FF957FB8" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF7FB4CA" />
    <SolidColorBrush x:Key="SymField" Color="#FF98BB6C" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFFFA066" />

</ResourceDictionary>
