<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Rosé Pine) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF191724" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF1F1D2E" />
    <SolidColorBrush x:Key="Panel" Color="#FF191724" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF14121F" />
    <SolidColorBrush x:Key="Border" Color="#FF2A2739" />
    <SolidColorBrush x:Key="Accent" Color="#FFC4A7E7" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFD6C0F0" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF191724" />
    <SolidColorBrush x:Key="Fg" Color="#FFE0DEF4" />
    <SolidColorBrush x:Key="FgDim" Color="#FF908CAA" />
    <!-- 検索ヒット文字の強調背景（選択行・通常行どちらでも読めるよう半透明ゴールド） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80F6C177" />
    <!-- リストの選択行背景（はっきり見える帯。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF403D52" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF9CCFD8" />
    <SolidColorBrush x:Key="Error" Color="#FFEB6F92" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。Rosé Pine のセマンティック配色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF908CAA" />
    <SolidColorBrush x:Key="SymType" Color="#FF9CCFD8" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF4C8CA8" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFF6C177" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFC4A7E7" />
    <SolidColorBrush x:Key="SymProperty" Color="#FFEBBCBA" />
    <SolidColorBrush x:Key="SymField" Color="#FFA5D6DE" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFEB6F92" />

</ResourceDictionary>
