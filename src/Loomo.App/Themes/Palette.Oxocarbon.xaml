<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Oxocarbon（IBM Carbon）) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF161616" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Panel" Color="#FF161616" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF262626" />
    <SolidColorBrush x:Key="PaneHeaderBg" Color="#FF252525" />
    <SolidColorBrush x:Key="Border" Color="#FF393939" />
    <SolidColorBrush x:Key="Accent" Color="#FF78A9FF" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFA6C8FF" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF12233F" />
    <SolidColorBrush x:Key="Fg" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="FgDim" Color="#FFA8A8A8" />
    <!-- 検索ヒット文字の強調背景 -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80BE95FF" />
    <!-- リストの選択行背景（複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF393939" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF42BE65" />
    <SolidColorBrush x:Key="Error" Color="#FFEE5396" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="SymType" Color="#FF3DDBD9" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF78A9FF" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFFF7EB6" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFBE95FF" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF82CFFF" />
    <SolidColorBrush x:Key="SymField" Color="#FF42BE65" />
    <SolidColorBrush x:Key="SymConstant" Color="#FF08BDBA" />

</ResourceDictionary>
