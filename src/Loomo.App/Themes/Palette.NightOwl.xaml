<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Night Owl) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF011627" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF0B2942" />
    <SolidColorBrush x:Key="Panel" Color="#FF011627" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF001122" />
    <SolidColorBrush x:Key="Border" Color="#FF1D3B53" />
    <SolidColorBrush x:Key="Accent" Color="#FF82AAFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFA6C4FF" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF12213F" />
    <SolidColorBrush x:Key="Fg" Color="#FFD6DEEB" />
    <SolidColorBrush x:Key="FgDim" Color="#FF8BA1B1" />
    <!-- 検索ヒット文字の強調背景（選択行・通常行どちらでも読めるよう半透明アンバー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80ECC48D" />
    <!-- リストの選択行背景（はっきり見える青。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF1D3B53" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF22DA6E" />
    <SolidColorBrush x:Key="Error" Color="#FFEF5350" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。Night Owl のセマンティック配色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF8BA1B1" />
    <SolidColorBrush x:Key="SymType" Color="#FF7FDBCA" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF82AAFF" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFECC48D" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFC792EA" />
    <SolidColorBrush x:Key="SymProperty" Color="#FFADDB67" />
    <SolidColorBrush x:Key="SymField" Color="#FFF78C6C" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFFFEB95" />

</ResourceDictionary>
