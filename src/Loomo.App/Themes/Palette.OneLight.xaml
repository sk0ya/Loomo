<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (One Light) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="BgAlt" Color="#FFF0F0F1" />
    <SolidColorBrush x:Key="Panel" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FFE7E7E8" />
    <SolidColorBrush x:Key="Border" Color="#FFD3D3D4" />
    <!-- 明色テーマなので、ホバーは暗くする（暗色テーマの「明るくする」とは逆向き）。
         明るくすると Accent 上の白文字が読めなくなる。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF4078F2" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF2C5FD0" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Fg" Color="#FF383A42" />
    <SolidColorBrush x:Key="FgDim" Color="#FF7C7F8A" />
    <!-- 検索ヒット文字の強調背景（明るい背景でも沈まない半透明アンバー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80E5C07B" />
    <!-- リストの選択行背景（明背景で文字が読める淡い青。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFD7E4FB" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FF50A14F" />
    <SolidColorBrush x:Key="Error" Color="#FFE45649" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。明背景で読める One Light。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF7C7F8A" />
    <SolidColorBrush x:Key="SymType" Color="#FF0184BC" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF4078F2" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFC18401" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFA626A4" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF0F6E9C" />
    <SolidColorBrush x:Key="SymField" Color="#FF50A14F" />
    <SolidColorBrush x:Key="SymConstant" Color="#FF986801" />

</ResourceDictionary>
