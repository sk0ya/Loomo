<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color palette (Catppuccin Mocha) =====
         キーは Palette.Dark.xaml と一対一で対応させること。 -->
    <SolidColorBrush x:Key="Bg" Color="#FF1E1E2E" />
    <SolidColorBrush x:Key="BgAlt" Color="#FF181825" />
    <SolidColorBrush x:Key="Panel" Color="#FF1E1E2E" />
    <SolidColorBrush x:Key="ActivityBarBg" Color="#FF11111B" />
    <SolidColorBrush x:Key="Border" Color="#FF313244" />
    <SolidColorBrush x:Key="Accent" Color="#FF89B4FA" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFA6C8FF" />
    <SolidColorBrush x:Key="AccentFg" Color="#FF12233F" />
    <SolidColorBrush x:Key="Fg" Color="#FFCDD6F4" />
    <SolidColorBrush x:Key="FgDim" Color="#FF9399B2" />
    <!-- 検索ヒット文字の強調背景（選択行・通常行どちらでも読めるよう半透明イエロー） -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#80F9E2AF" />
    <!-- リストの選択行背景（はっきり見える藤色。複数選択はこの帯がつながる） -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FF45475A" />
    <!-- 状態色（テスト成功/失敗など）。テーマごとに調整する。 -->
    <SolidColorBrush x:Key="Success" Color="#FFA6E3A1" />
    <SolidColorBrush x:Key="Error" Color="#FFF38BA8" />
    <!-- コード構造アウトライン（EditorSupport）の種別バッジ色。Catppuccin のパステル配色。 -->
    <SolidColorBrush x:Key="SymNamespace" Color="#FF9399B2" />
    <SolidColorBrush x:Key="SymType" Color="#FF94E2D5" />
    <SolidColorBrush x:Key="SymInterface" Color="#FF89DCEB" />
    <SolidColorBrush x:Key="SymEnum" Color="#FFF9E2AF" />
    <SolidColorBrush x:Key="SymMethod" Color="#FFCBA6F7" />
    <SolidColorBrush x:Key="SymProperty" Color="#FF89B4FA" />
    <SolidColorBrush x:Key="SymField" Color="#FFA6E3A1" />
    <SolidColorBrush x:Key="SymConstant" Color="#FFFAB387" />

</ResourceDictionary>
