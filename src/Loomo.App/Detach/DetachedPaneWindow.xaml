<Window x:Class="sk0ya.Loomo.App.Views.DetachedPaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loomo" Width="960" Height="680" MinWidth="360" MinHeight="240"
        Background="{DynamicResource Panel}"
        Foreground="{DynamicResource Fg}"
        WindowStyle="None" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DetachCaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- タイトルバー：バー全体がタブのドロップ先＋ドラッグでウィンドウ移動（空き領域）。
             バー全体を IsHitTestVisibleInChrome=True にして WPF 入力（クリック/ドラッグ/ドロップ）を受け、
             ウィンドウ移動・最大化トグルは自前で処理する（WindowChrome はリサイズ枠のみ担当）。 -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="34" Background="{DynamicResource BgAlt}"
              AllowDrop="True" Drop="OnTabStripDrop" DragOver="OnTabStripDragOver"
              MouseLeftButtonDown="OnCaptionMouseDown"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <!-- タブ帯は残り幅までで打ち切る（Auto だと増えた分だけ伸びて、右のキャプションボタンと
                     ウィンドウ移動用のドラッグ領域を画面外へ押し出してしまう）。 -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- タブストリップ。あふれたら横スクロール（Editor ペインの帯と同じ流儀＝スクロールバーは出さず
                 ホイールで送る）。右マージンはウィンドウ移動用に必ず残す掴みしろ。 -->
            <ScrollViewer x:Name="TabStripScrollViewer" Grid.Column="0"
                          HorizontalAlignment="Left" Margin="0,0,48,0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly" PreviewMouseWheel="OnTabStripMouseWheel">
                <ItemsControl x:Name="TabStripItems"
                              PreviewMouseLeftButtonDown="OnTabPreviewMouseDown"
                              PreviewMouseMove="OnTabPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnTabPreviewMouseUp">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                <Border x:Name="TabBorder" Height="30" Margin="3,4,0,0"
                                        CornerRadius="4,4,0,0" Background="Transparent"
                                        MouseLeftButtonUp="OnTabClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}"
                                               Width="14" Height="14" Margin="8,0,6,0"
                                               VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   FontSize="{DynamicResource Fs12_5}" />
                                        <Button Grid.Column="2" x:Name="CloseButton"
                                                Width="18" Height="18" Margin="6,0,6,0" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" ToolTip="タブを閉じる"
                                                Click="OnTabCloseClick">
                                            <Path Width="8" Height="8" Stretch="Uniform"
                                                  Stroke="{DynamicResource FgDim}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M0,0 L8,8 M0,8 L8,0" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Bg}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Panel}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            <!-- タブ一覧（あふれて見えなくなった分も含む全件）。Editor ペインの帯の「▾」と同じ導線で、
                 クリックで直接アクティブ化できる。スタイルは実行時にだけ要る（Application 無しのテストでも
                 ウィンドウを組めるよう DynamicResource で引く）。 -->
            <Popup x:Name="TabOverflowPopup" Grid.Column="1" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="200" MaxWidth="360">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                    </Border.Effect>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TabOverflowList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource BranchMenuItem}"
                                            FontSize="{DynamicResource Fs12}"
                                            ToolTip="{Binding Title}" Click="OnTabOverflowItemClick">
                                        <!-- 横 StackPanel は子に無限幅を渡すので省略記号が効かない。
                                             タイトル側に上限を置いて、長いファイル名は「…」で畳む。 -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="OverflowTitle" Text="{Binding Title}"
                                                       MaxWidth="300" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="OverflowTitle" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- キャプションボタン（左端の「▾」はタブ一覧＝あふれた分への導線） -->
            <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="TabOverflowButton" Style="{StaticResource DetachCaptionButton}" Width="28"
                        Content="▾" FontSize="{DynamicResource Fs11}" ToolTip="タブ一覧"
                        Click="OnTabOverflowClick" />
                <Button Style="{StaticResource DetachCaptionButton}" Content="—"
                        FontSize="{DynamicResource Fs13}" ToolTip="最小化" Click="OnMinimize" />
                <Button x:Name="MaxRestoreButton" Style="{StaticResource DetachCaptionButton}" Content="□"
                        FontSize="{DynamicResource Fs13}" ToolTip="最大化/元に戻す" Click="OnMaxRestore" />
                <Button Style="{StaticResource DetachCaptionButton}" Content="✕"
                        FontSize="{DynamicResource Fs13}" ToolTip="閉じる" Click="OnCloseWindow" />
            </StackPanel>
        </Grid>

        <!-- アクティブ項目の実コントロールを載せるホスト（他項目は Collapsed で退避） -->
        <Grid x:Name="ContentHost" />
    </DockPanel>
</Window>
