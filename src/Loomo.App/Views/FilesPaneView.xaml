<UserControl x:Class="sk0ya.Loomo.App.Views.FilesPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    Background="{DynamicResource Panel}">

    <UserControl.Resources>
        <!-- 列幅は見出しと行で必ず同じ値を使う（別々に書くと片方だけ直って列がずれる）。
             名前列だけ可変（*）で、残り3列はここで決めた固定幅。 -->
        <GridLength x:Key="FilesSizeWidth">86</GridLength>
        <GridLength x:Key="FilesModifiedWidth">124</GridLength>
        <GridLength x:Key="FilesTypeWidth">72</GridLength>
        <!-- 行と見出しの右端に空ける幅。重ねて描く縦スクロールバー（7px）の下へ
             最終列の文字が潜らないようにするためのもので、見出し・行の両方に同じ値を入れる。 -->
        <Thickness x:Key="FilesRowInset">0,0,8,0</Thickness>

        <Style x:Key="FilesToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- パンくず・ワークスペースフォルダー切替の1区切り。現在地は淡色のまま押せない見た目にする。 -->
        <Style x:Key="FilesCrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列見出し。押すとその列で並べ替え（同じ列を押すと向きが反転）。 -->
        <Style x:Key="FilesColumnHeader" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 縦スクロールバーを内容に重ねる（レイアウト幅を取らない）。取ると見出しと行で
             名前列の幅が 7px ずれ、スクロールバーの有無で列がずれて見える。 -->
        <Style x:Key="FilesOverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                       HorizontalAlignment="Right" Width="7" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilesRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ツールバー：戻る／進む／上へ／更新 ＋ パンくず ＋ 絞り込み -->
        <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource FilesToolButton}"
                    Command="{Binding GoBackCommand}" ToolTip="戻る（Alt+←）">
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M10,2 L4,7 L10,12" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource FilesToolButton}"
                    Command="{Binding GoForwardCommand}" ToolTip="進む（Alt+→）">
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M4,2 L10,7 L4,12" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource FilesToolButton}"
                    Command="{Binding GoUpCommand}" ToolTip="上のフォルダーへ（Backspace）">
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M2,7 L7,2 L12,7 M7,2 L7,13" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource FilesToolButton}" Margin="0,0,4,0"
                    Command="{Binding RefreshCommand}" ToolTip="更新（F5）">
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M12,7 A5,5 0 1 1 10.5,3.5 M12,1 L12,4 L9,4" />
            </Button>

            <!-- 絞り込み（名前の部分一致。*.cs のようにワイルドカードも可） -->
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolbarToggleButton}" MinHeight="24"
                          Margin="4,0,0,0" Content="隠し" FontSize="{DynamicResource Fs11}"
                          IsChecked="{Binding ShowHiddenFiles}"
                          ToolTip="隠しファイル・システムファイル（.git など）も表示する" />
            <Grid DockPanel.Dock="Right" Width="150" Margin="4,0,0,0">
                <TextBox x:Name="FilterBox" VerticalContentAlignment="Center" MinHeight="24"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                         ToolTip="名前で絞り込み（*.cs のようにワイルドカードも書けます）" />
                <TextBlock Text="絞り込み" Foreground="{DynamicResource FgDim}" Margin="6,0,0,0"
                           FontSize="{DynamicResource Fs11}" IsHitTestVisible="False" VerticalAlignment="Center"
                           Visibility="{Binding Filter, Converter={StaticResource EmptyToVis}}" />
            </Grid>

            <!-- パンくず。所属するワークスペースフォルダーが先頭で、そこから上へは辿らせない。 -->
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilesBreadcrumb}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FilesCrumbButton}"
                                    Command="{Binding DataContext.OpenFolderCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding FullPath}"
                                    ToolTip="{Binding FullPath}">
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </Button>
                            <TextBlock Text="›" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}"
                                       Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- マルチルート：ワークスペースフォルダーの切替（1フォルダーのときは行ごと出さない） -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WorkspaceFolders}" Margin="6,0,6,2"
                      Visibility="{Binding WorkspaceFolders.Count, Converter={StaticResource CountToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FilesBreadcrumb}">
                    <Button Style="{StaticResource FilesCrumbButton}" Margin="0,0,2,0"
                            Command="{Binding DataContext.OpenFolderCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding FullPath}"
                            ToolTip="{Binding FullPath}">
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs11}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                    <Style.Triggers>
                                        <!-- 現在地のワークスペースフォルダーだけアクセント色 -->
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ステータス（件数） -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="8,2">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 列見出し -->
        <Grid DockPanel.Dock="Top" Margin="{StaticResource FilesRowInset}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource FilesSizeWidth}" />
                <ColumnDefinition Width="{StaticResource FilesModifiedWidth}" />
                <ColumnDefinition Width="{StaticResource FilesTypeWidth}" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource FilesColumnHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Name"
                    ToolTip="名前で並べ替え（数字は数として読みます）">
                <TextBlock><Run Text="名前" /><Run Text="{Binding NameSortMark, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource FilesColumnHeader}"
                    HorizontalContentAlignment="Right"
                    Command="{Binding SortCommand}" CommandParameter="Size" ToolTip="サイズで並べ替え">
                <TextBlock><Run Text="サイズ" /><Run Text="{Binding SizeSortMark, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource FilesColumnHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Modified" ToolTip="更新日時で並べ替え">
                <TextBlock><Run Text="更新日時" /><Run Text="{Binding ModifiedSortMark, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource FilesColumnHeader}"
                    Command="{Binding SortCommand}" CommandParameter="Type" ToolTip="種類で並べ替え">
                <TextBlock><Run Text="種類" /><Run Text="{Binding TypeSortMark, Mode=OneWay}" /></TextBlock>
            </Button>
        </Grid>

        <!-- 一覧本体 -->
        <Grid>
            <ListBox x:Name="EntryList"
                     ItemsSource="{Binding Entries}"
                     SelectionMode="Extended"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,2,0,6"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource FilesRow}"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnSelectionChanged"
                     PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="OnListPreviewMouseLeftButtonUp"
                     PreviewMouseMove="OnListPreviewMouseMove"
                     PreviewMouseRightButtonDown="OnListPreviewMouseRightButtonDown"
                     MouseDoubleClick="OnListMouseDoubleClick"
                     PreviewKeyDown="OnListPreviewKeyDown"
                     DragOver="OnListDragOver"
                     Drop="OnListDrop">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False" CanContentScroll="True"
                                          Style="{StaticResource FilesOverlayScrollViewer}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ContextMenu>
                    <!-- 並びはツリーの右クリックと同じ語彙・同じ順（作る → 移す → 直す → 開く/送る →
                         フォルダー → 写す）。同じ操作が2箇所で違う名前・違う順に並ぶ方が事故になる。 -->
                    <ContextMenu Opened="OnContextMenuOpened">
                        <MenuItem Header="開く" Click="OnOpenClick" />
                        <MenuItem Header="ブラウザで開く" Tag="Html" Click="OnOpenInBrowserClick" />
                        <MenuItem Header="既定のアプリで開く" Tag="FileOnly" Click="OnOpenWithDefaultAppClick" />
                        <Separator />
                        <MenuItem Header="新規ファイル" Click="OnNewFileClick" />
                        <MenuItem Header="新規フォルダー" Click="OnNewFolderClick" />
                        <Separator />
                        <MenuItem Header="コピー" InputGestureText="Ctrl+C" Tag="Selection" Click="OnCopyClick" />
                        <MenuItem Header="切り取り" InputGestureText="Ctrl+X" Tag="Selection" Click="OnCutClick" />
                        <MenuItem Header="貼り付け" InputGestureText="Ctrl+V" Click="OnPasteClick" />
                        <MenuItem Header="複製" InputGestureText="Ctrl+D" Tag="Selection" Click="OnDuplicateClick"
                                  ToolTip="同じフォルダーに「 - コピー」を付けて複製します" />
                        <Separator />
                        <MenuItem Header="名前の変更" InputGestureText="F2" Tag="Single" Click="OnRenameClick" />
                        <MenuItem Header="削除" InputGestureText="Delete" Tag="Selection" Click="OnDeleteClick" />
                        <Separator />
                        <MenuItem Header="エクスプローラーで表示" Tag="Single" Click="OnRevealInExplorerClick" />
                        <MenuItem Header="ターミナルへ送る" Tag="Single" Click="OnSetInTerminalClick"
                                  ToolTip="フォルダーは作業場所に設定し、ファイルはパスを入力します" />
                        <MenuItem Header="Diffへ送る" Tag="FileOnly"
                                  ToolTip="クリップボードや選択したファイルと Diff ペインで見比べます">
                            <MenuItem Header="クリップボードと比較" Click="OnCompareWithClipboardClick" />
                            <MenuItem Header="選択した2つを比較" Tag="CompareTwo" Click="OnCompareSelectedClick"
                                      ToolTip="先に選んだ方を左（旧）、後を右（新）として比較します" />
                        </MenuItem>
                        <MenuItem Header="このフォルダーで検索" Tag="DirOnly" Click="OnSearchInFolderClick" />
                        <Separator />
                        <MenuItem Header="パスをコピー" Tag="Selection">
                            <MenuItem Header="フルパス" Click="OnCopyPathClick" />
                            <MenuItem Header="相対パス" Click="OnCopyRelativePathClick"
                                      ToolTip="所属するワークスペースフォルダーからの相対パス" />
                            <MenuItem Header="名前" Click="OnCopyNameClick" />
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FileEntryViewModel}">
                        <Grid Background="Transparent" Margin="{StaticResource FilesRowInset}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource FilesSizeWidth}" />
                                <ColumnDefinition Width="{StaticResource FilesModifiedWidth}" />
                                <ColumnDefinition Width="{StaticResource FilesTypeWidth}" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,0,4,0">
                                <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs12}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs11}" />
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontSize="{DynamicResource Fs11}" />
                            <TextBlock Grid.Column="3" Text="{Binding TypeText}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontSize="{DynamicResource Fs11}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs12}" HorizontalAlignment="Center" Margin="0,24,0,0"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</UserControl>
