<UserControl x:Class="sk0ya.Loomo.App.Views.FilesPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:sk0ya.Loomo.App.Views"
    Background="{DynamicResource Panel}">
    <!-- カラムの並べ方だけを持つ容れ物。中身（ツールバー・一覧・右クリック）は FilesColumnView。
         1カラム=1枚、2カラム=左右、4カラム=2×2。分割線はドラッグでリサイズできる。
         カラムの実体は VM 側に常に4つあり、ここは先頭から必要数だけを配置する。 -->
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- 最近／頻繁項目は中央のファイル一覧だけに表示する。RecentItemsView 自体が
             折りたたみと内容の上限を持つため、展開しても通常の一覧を押しのけすぎない。 -->
        <views:RecentItemsView x:Name="QuickAccessView" Grid.Row="0"
                               DataContext="{Binding Recent}"
                               Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
        <Grid x:Name="ColumnHost" Grid.Row="1" />
    </Grid>
</UserControl>
