<Window x:Class="sk0ya.Loomo.App.Views.NuGetPackagesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="1040" Height="640"
    MinWidth="720" MinHeight="420"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <!-- 見え方と検索 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                <RadioButton Content="導入済み" GroupName="NuGetMode" IsChecked="{Binding IsInstalled}"
                             Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs13}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton Content="検索" GroupName="NuGetMode" IsChecked="{Binding IsBrowse}"
                             Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs13}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <RadioButton Content="更新" GroupName="NuGetMode" IsChecked="{Binding IsUpdates}"
                             Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs13}" VerticalAlignment="Center" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="再読み込み" Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" />
            <CheckBox DockPanel.Dock="Right" Content="プレリリースを含める" IsChecked="{Binding IncludePrerelease}"
                      Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" FontSize="{DynamicResource Fs13}"
                     ToolTip="パッケージ名で絞り込み／検索（検索モードではフィードへ問い合わせる）" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- パッケージ一覧 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Version}" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}"
                                               FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Fs11}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 選んだパッケージ：版とプロジェクト -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPackage.Id}" Foreground="{DynamicResource Fg}"
                           FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPackage.Authors}" Foreground="{DynamicResource FgDim}"
                           FontSize="{DynamicResource Fs11}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="版" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                              FontFamily="Cascadia Mono, Consolas" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="入れる／版を変える" Style="{StaticResource FlatButton}" Background="{DynamicResource Accent}"
                            Foreground="White" Margin="0,0,6,0" Command="{Binding InstallCommand}"
                            ToolTip="チェックしたプロジェクトへ、選んだ版で入れる（入っていれば版を変える）" />
                    <Button Content="外す" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                            Foreground="{DynamicResource Fg}" Margin="0,0,6,0" Command="{Binding UninstallCommand}"
                            ToolTip="チェックしたプロジェクトから外す" />
                    <Button Content="版を揃える（統合）" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                            Foreground="{DynamicResource Fg}" Command="{Binding ConsolidateCommand}"
                            Visibility="{Binding CanConsolidate, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="このパッケージを参照している全プロジェクトを、選んだ版へ揃える" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Projects}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Content="{Binding Name}"
                                              Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledLabel}" Foreground="{DynamicResource FgDim}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,8,0,4">
            <TextBlock DockPanel.Dock="Right" Text="実行中…" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource Fs12}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs12}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}"
                 Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}" BorderBrush="{DynamicResource Border}"
                 TextChanged="OnLogChanged" />
    </Grid>
</Window>
