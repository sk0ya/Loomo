<Window x:Class="sk0ya.Loomo.App.Views.FilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロパティ"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SelectionText" Grid.Row="0"
                   Foreground="{DynamicResource Fg}"
                   FontSize="{DynamicResource Fs15}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding}"
                         SelectedValuePath="FullPath"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="選択した項目">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,4">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource Fg}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding KindDisplay}"
                                           Foreground="{DynamicResource FgDim}"
                                           FontSize="{DynamicResource Fs11}" />
                                <TextBlock Text="{Binding ErrorDisplay}"
                                           Foreground="#FFE06C75"
                                           FontSize="{DynamicResource Fs11}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名前" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="NameText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ContentText}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="種類" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="KindText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ContentText}" Foreground="{DynamicResource Fg}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="サイズ" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ContentText}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="作成日時" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="CreationText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ContentText}" Foreground="{DynamicResource Fg}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="更新日時" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="LastWriteText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ContentText}" Foreground="{DynamicResource Fg}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="属性" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="AttributesText" Grid.Row="5" Grid.Column="1" Style="{StaticResource ContentText}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="場所" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBox x:Name="LocationText" Grid.Row="6" Grid.Column="1"
                             IsReadOnly="True" BorderThickness="0" Padding="0"
                             Background="Transparent" Foreground="{DynamicResource Fg}"
                             TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="権限" Style="{StaticResource ContentText}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,8" />
                    <TextBlock x:Name="PermissionEmptyText" Grid.Row="7" Grid.Column="1"
                               Text="権限情報を取得できません。" Style="{StaticResource ContentText}"
                               Foreground="{DynamicResource FgDim}" Visibility="Collapsed" />
                    <ListBox x:Name="PermissionsList" Grid.Row="7" Grid.Column="1"
                             MaxHeight="180" ItemsSource="{Binding}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="{DynamicResource FgDim}"
                                           FontSize="{DynamicResource Fs11}" TextWrapping="Wrap" Margin="0,0,0,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ErrorText" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                               Foreground="#FFE06C75" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="閉じる" Style="{StaticResource FlatButton}" IsDefault="True" IsCancel="True"
                    MinWidth="88" Click="OnCloseClick" AutomationProperties.Name="プロパティを閉じる" />
        </StackPanel>
    </Grid>
</Window>
