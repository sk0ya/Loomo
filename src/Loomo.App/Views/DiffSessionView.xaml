
<UserControl x:Class="sk0ya.Loomo.App.Views.DiffSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <!-- 一覧アイテム共通（GitSessionView と同じ見た目） -->
        <Style x:Key="DiffListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 差分本体テキスト（読み取り専用 RichTextBox）：普通のテキストとして文字単位で選択・コピーできる -->
        <Style x:Key="DiffTextBox" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
            <Setter Property="AutoWordSelection" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- 行番号ガター：本文とは別のスクロール非対話 RichTextBox（選択・コピーに混ざらない） -->
        <Style x:Key="DiffGutterBox" TargetType="RichTextBox" BasedOn="{StaticResource DiffTextBox}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>

        <!-- ハンク／コンフリクト解消の小さめアクションボタン（GitSessionView の ToolbarButton と同じ意図：
             既定の Button はテーマの DynamicResource を継承しない生の Win32 クロームになり、暗いテーマでは
             文字が見えなくなるため、必ず FlatButton ベースの明示スタイルを当てる）。 -->
        <Style x:Key="DiffActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>
        <Style x:Key="DiffSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>

        <!-- 一覧の行末に出す「この比較を閉じる」。ストックした比較の行にだけ現れる（幅は予約しない）。 -->
        <Style x:Key="DiffCloseButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- コンフリクトの Ours→Result / Theirs→Result 取り込みボタン（«/» のみ。Rider の merge gutter と同じ最小限の見た目）。 -->
        <Style x:Key="ConflictGutterButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- コンフリクトの Ours/Theirs 列（読み取り専用・複数行）。Result 列と横に並べ、Rider の3ペインに近づける。 -->
        <Style x:Key="ConflictSideTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- Result 列（自由編集可）。枠と背景を分けて「ここは手で書き換えられる」ことを示す。 -->
        <Style x:Key="ConflictResultTextBox" TargetType="TextBox" BasedOn="{StaticResource ConflictSideTextBox}">
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        </Style>

        <!-- 本文 RichTextBox 共通のコンテキストメニュー（コピー）。以下の DataTemplate 内で参照するため、
             StaticResource の前方参照制約（同じ ResourceDictionary 内では宣言順より後ろを参照できない）
             を満たすようここに置く。 -->
        <ContextMenu x:Key="DiffCopyMenu">
            <MenuItem Header="コピー" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"
                      CommandTarget="{Binding PlacementTarget,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 通常行のまとまり（両者で共通の内容、クリック不可）。Ours/Result/Theirs の3列すべてに同じ内容を流す。
             列は素の Star 指定：外側の ScrollViewer が横方向を Disabled で拘束するため、どの行の Grid も
             同じ幅を受け取り、SharedSizeGroup なしで全ブロックの桁が揃う。（以前は SharedSizeGroup で
             揃えていたが、WPF は SharedSizeGroup 参加列の Star を Auto 扱いにするため、3つの本文列が
             内容の最長行の幅まで広がり、Result/Theirs ペインが画面外へ押し出されていた。）
             本文は行を改行で結合した1つの TextBlock（行数分の要素を作らない）。あふれる長い行は
             CharacterEllipsis で列内に収める。LineHeight=16 はコンフリクト側 RichTextBox の段組と合わせる。 -->
        <DataTemplate DataType="{x:Type vm:ConflictOrdinaryBlockVm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Width="34" TextAlignment="Right" Margin="4,0,8,0"
                               Text="{Binding OursGutterText}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource FgDim}" />
                    <TextBlock Text="{Binding BodyText}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Fg}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel Grid.Column="2" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Width="34" TextAlignment="Right" Margin="4,0,8,0"
                               Text="{Binding ResultGutterText}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource FgDim}" />
                    <TextBlock Text="{Binding BodyText}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Fg}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel Grid.Column="4" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Width="34" TextAlignment="Right" Margin="4,0,8,0"
                               Text="{Binding TheirsGutterText}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource FgDim}" />
                    <TextBlock Text="{Binding BodyText}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Fg}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- コンフリクト1件：Ours（読み取り専用）/ Result（自由編集・既定は空）/ Theirs（読み取り専用）の
             3ペイン構成（Rider の3-way merge と同じ考え方）。« / » でその場で Ours・Theirs を Result へ
             取り込めるほか、Result 欄へ直接書いて「適用」してもよい。ナビゲーションの現在地は枠で強調する
             （既定は素の Panel 背景。全ブロック常時ハイライトだと「今どこか」が埋もれるため、現在地だけを
             目立たせる）。Ours/Theirs は行番号ガター＋差分ハイライト付きの読み取り専用 RichTextBox
             （通常差分の左右並び表示と同じ DiffTextBox/DiffGutterBox）にして、文字選択・コピーもできる。 -->
        <DataTemplate DataType="{x:Type vm:ConflictRegionVm}">
            <Border Margin="0,4" Background="{DynamicResource Panel}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <!-- Ours（読み取り専用・行番号＋差分ハイライト付き）。左端の緑帯はスクロールしても
                         「どちら側か」が分かるようにする常設マーカー（見出しの緑と同色）。 -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF81C784" />
                        <RichTextBox Grid.Column="1" Style="{StaticResource DiffGutterBox}" Width="40"
                                     local:ConflictSideDocumentBehavior.Mode="Gutter"
                                     local:ConflictSideDocumentBehavior.Lines="{Binding OursDisplayLines}" />
                        <RichTextBox Grid.Column="2" Style="{StaticResource DiffTextBox}"
                                     ContextMenu="{StaticResource DiffCopyMenu}"
                                     local:ConflictSideDocumentBehavior.Mode="Ours"
                                     local:ConflictSideDocumentBehavior.Lines="{Binding OursDisplayLines}" />
                    </Grid>

                    <!-- Ours → Result -->
                    <Button Grid.Column="1" Content="»" ToolTip="Ours を採用して Result に入れる"
                            VerticalAlignment="Top" Margin="0,6,0,0"
                            Style="{StaticResource ConflictGutterButton}"
                            Command="{Binding DataContext.Conflict.AcceptOursCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />

                    <!-- Result（自由編集）。フォーカスすると、上部ツールバーの「現在地のコンフリクトを解決」
                         操作の対象がこのコンフリクトになる（DiffSessionView.xaml.cs 側でナビゲーション位置と同期）。
                         行番号は編集のたびに再計算される ResultLineNumberText（"1\n2\n3" 形式）をそのまま
                         TextBlock にバインドする（WPF の TextBlock.Text は埋め込み改行をそのまま描画する）。
                         VerticalAlignment=Top：既定の Stretch のままだと、Ours/Theirs 側が複数行で背が高い
                         コンフリクトのとき、中身が短い（既定は空）Result の TextBox まで同じ高さに引き伸ばされ、
                         下に不自然な空白ができる。中身の高さぴったりに留めて、余りはブロックの背景に任せる。 -->
                    <Grid Grid.Column="2" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Width="34" TextAlignment="Right" Margin="4,4,8,4"
                                   Text="{Binding ResultLineNumberText}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource FgDim}" />
                        <TextBox Grid.Column="1" Style="{StaticResource ConflictResultTextBox}"
                                 Text="{Binding ResultText, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="OnConflictResultGotFocus" />
                    </Grid>

                    <!-- Theirs → Result -->
                    <Button Grid.Column="3" Content="«" ToolTip="Theirs を採用して Result に入れる"
                            VerticalAlignment="Top" Margin="0,6,0,0"
                            Style="{StaticResource ConflictGutterButton}"
                            Command="{Binding DataContext.Conflict.AcceptTheirsCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />

                    <!-- Theirs（読み取り専用・行番号＋差分ハイライト付き）。右端の赤帯は見出しの赤と同色。 -->
                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3" />
                        </Grid.ColumnDefinitions>
                        <RichTextBox Grid.Column="0" Style="{StaticResource DiffGutterBox}" Width="40"
                                     local:ConflictSideDocumentBehavior.Mode="Gutter"
                                     local:ConflictSideDocumentBehavior.Lines="{Binding TheirsDisplayLines}" />
                        <RichTextBox Grid.Column="1" Style="{StaticResource DiffTextBox}"
                                     ContextMenu="{StaticResource DiffCopyMenu}"
                                     local:ConflictSideDocumentBehavior.Mode="Theirs"
                                     local:ConflictSideDocumentBehavior.Lines="{Binding TheirsDisplayLines}" />
                        <Border Grid.Column="2" Background="#FFE57373" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 差分本体（左右並び）のメニュー。コピーのほか、読んでいる行からエディタ・AI・比較へ素材を渡す。
             コンフリクト表示の Ours/Theirs 欄は行番号の意味が違うので、こちらは使わず DiffCopyMenu のまま。 -->
        <ContextMenu x:Key="DiffSideMenu">
            <MenuItem Header="コピー" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"
                      CommandTarget="{Binding PlacementTarget,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="この行をエディタで開く" Click="OnOpenRowInEditor"
                      ToolTip="右クリックした行に対応するファイルの行をエディタで開く" />
            <MenuItem Header="選択範囲をクリップボードと比較" Click="OnCompareSelectionWithClipboard"
                      ToolTip="差分本体で選択したテキストとクリップボードの内容を比較する" />
            <Separator />
            <MenuItem Header="⇄ 左右を入れ替える" Click="OnSwapComparison"
                      IsEnabled="{Binding PlacementTarget.DataContext.HasComparison,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="クリップボードで再比較" Click="OnRecompareWithClipboard"
                      ToolTip="右側を今のクリップボードの内容に差し替えて比較し直す"
                      IsEnabled="{Binding PlacementTarget.DataContext.HasComparison,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 統合表示の本文メニュー（コピー＋選択行の破棄）。破棄は Git・作業ツリー・未ステージの追跡ファイルのみ有効 -->
        <ContextMenu x:Key="DiffUnifiedMenu">
            <MenuItem Header="コピー" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"
                      CommandTarget="{Binding PlacementTarget,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="この行をエディタで開く" Click="OnOpenRowInEditor"
                      ToolTip="右クリックした行に対応するファイルの行をエディタで開く" />
            <MenuItem Header="選択範囲をクリップボードと比較" Click="OnCompareSelectionWithClipboard"
                      ToolTip="差分本体で選択したテキストとクリップボードの内容を比較する" />
            <Separator />
            <!-- 行単位の破棄は「作業ツリー vs インデックス／HEAD」の概念。基準がブランチ／分岐点のときや
                 コミット範囲を見ている間は存在しないので、灰色で残さず項目ごと出さない（§24.11）。 -->
            <MenuItem Header="選択した行を破棄" Click="OnDiscardSelectedLines"
                      ToolTip="選択した追加・削除行の変更だけを作業ツリーから取り消す"
                      Visibility="{Binding PlacementTarget.DataContext.CanDiscardLines,
                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                          Converter={StaticResource BoolToVis}}" />
            <Separator Visibility="{Binding PlacementTarget.DataContext.CanDiscardLines,
                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                          Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="⇄ 左右を入れ替える" Click="OnSwapComparison"
                      IsEnabled="{Binding PlacementTarget.DataContext.HasComparison,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="クリップボードで再比較" Click="OnRecompareWithClipboard"
                      ToolTip="右側を今のクリップボードの内容に差し替えて比較し直す"
                      IsEnabled="{Binding PlacementTarget.DataContext.HasComparison,
                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <!-- 差分ナビゲーションのキー。ペインでも切り離しウィンドウでも同じ手癖で次／前の変更へ飛べる
         （ボタンが視界の外にあっても手が届くように）。F8 は Visual Studio の「次の相違点」に合わせ、
         Alt+↓/↑ はマウスを離さない側の別解。 -->
    <UserControl.InputBindings>
        <KeyBinding Key="F8" Command="{Binding JumpToNextChangeCommand}" />
        <KeyBinding Key="F8" Modifiers="Shift" Command="{Binding JumpToPrevChangeCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding JumpToNextChangeCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding JumpToPrevChangeCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- ツールバーは通常ペインヘッダー側（ShellWindow）へ集約。ただしヘッダーを持たないホスト
             （Git のコミット詳細からダブルクリックで開く切り離しウィンドウ）では、そこへ回した操作が
             丸ごと届かなくなるので、同じ操作をこのバーで出す（ShowStandaloneToolbar で表示）。
             スタイル・コマンドはペインヘッダーと同じものを見ているので、見た目も挙動も揃う。 -->
        <Border x:Name="StandaloneToolbar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Panel}" Padding="8,4"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 表示形式（左右／統合）。Markdown を描画表示している間は効かないので出さない（§24.7）。 -->
                    <Border Background="{DynamicResource BgAlt}" CornerRadius="4" Padding="1" Margin="0,0,10,0"
                            Visibility="{Binding CanChooseTextLayout, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SourceToggle}" Content="左右" FontSize="{DynamicResource Fs12}"
                                         ToolTip="削除を左・追加を右に並べて表示（side by side）"
                                         IsChecked="{Binding IsSideBySide}" />
                            <RadioButton Style="{StaticResource SourceToggle}" Content="統合" FontSize="{DynamicResource Fs12}"
                                         ToolTip="差分を1列で表示（unified）"
                                         IsChecked="{Binding IsSideBySide, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgAlt}" CornerRadius="4" Padding="1" Margin="0,0,10,0"
                            Visibility="{Binding CanRenderMarkdown, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SourceToggle}" Content="テキスト" FontSize="{DynamicResource Fs12}"
                                         ToolTip="パッチの行をそのまま読む（既定）"
                                         IsChecked="{Binding IsMarkdownRender, Converter={StaticResource InverseBool}}" />
                            <RadioButton Style="{StaticResource SourceToggle}" Content="描画" FontSize="{DynamicResource Fs12}"
                                         ToolTip="Markdown をレンダリングし、追加・削除をその文書の中に混ぜて読む"
                                         IsChecked="{Binding IsMarkdownRender}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgAlt}" CornerRadius="4" Padding="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PaneHeaderToolButton}" Content="↓ 次の差分"
                                    ToolTip="次の変更ブロックへジャンプ（F8／Alt+↓。末尾を越えたら次のファイルへ）"
                                    Command="{Binding JumpToNextChangeCommand}" />
                            <Button Style="{StaticResource PaneHeaderToolButton}" Content="↑ 前の差分"
                                    ToolTip="前の変更ブロックへジャンプ（Shift+F8／Alt+↑。先頭を越えたら前のファイルへ）"
                                    Command="{Binding JumpToPrevChangeCommand}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PaneHeaderToolButton}" Content="エディタで開く"
                            ToolTip="いま選んでいるファイルを（現在の内容で）エディタで開く"
                            Command="{Binding OpenInEditorCommand}" />
                    <Button Style="{StaticResource PaneHeaderToolButton}" Content="Git 一覧で表示"
                            ToolTip="このコミットを Git のコミット一覧で選択する"
                            Command="{Binding OpenCommitInGitCommand}"
                            Visibility="{Binding CanOpenCommitInGit, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- 何のコミットを見ているか。窓のタイトルは選択ファイル名を追うので、出どころはここに残す。 -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding GitTargetLabel}" VerticalAlignment="Center"
                           Margin="10,0,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource Accent}" />
            </DockPanel>
        </Border>

        <!-- 実行結果メッセージ -->
        <TextBlock DockPanel.Dock="Bottom" Margin="10,2,10,6" FontSize="{DynamicResource Fs11}"
                   Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="60">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="#FFE57373" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="140" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 変更ファイル一覧 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Margin="8,2" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgDim}" Text="{Binding FileListHeader}" />
                <Grid>
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Fg}"
                             ItemContainerStyle="{StaticResource DiffListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="OnFileDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" ToolTip="{Binding DisplayPath}">
                                    <!-- 一覧の右クリック。対象はメニューの配置対象（この DockPanel）の DataContext
                                         ＝その行のファイル項目（コード側 ContextItem が取り出す）。
                                         「クリップボードと比較」は、変更一覧にあるファイルの現物と、
                                         どこかからコピーしてきた案をそのまま突き合わせるための入口。 -->
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="エディタで開く" Click="OnOpenFileInEditor" />
                                            <MenuItem Header="クリップボードと比較" Click="OnCompareFileWithClipboard"
                                                      ToolTip="このファイルの現在の内容とクリップボードを比較する" />
                                            <MenuItem Header="パスをコピー" Click="OnCopyFilePath" />
                                            <Separator />
                                            <!-- ストックした比較だけ「閉じる」で片づける（ほかの比較は残る）。 -->
                                            <MenuItem Header="この比較を閉じる" Click="OnCloseComparison"
                                                      ToolTip="この比較を一覧から閉じる（ほかの比較は残る）"
                                                      Visibility="{Binding IsCompare, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="比較をすべて閉じる" Click="OnCloseAllComparisons"
                                                      Visibility="{Binding IsCompare, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="変更を破棄" Click="OnDiscardFile"
                                                      ToolTip="このファイルの作業ツリーの変更を破棄する（未追跡なら削除）"
                                                      Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVis}}" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <!-- 閉じる ✕ は比較項目へマウスを置いたときだけ見せ、普段の一覧を静かに保つ。 -->
                                    <Button DockPanel.Dock="Right" Content="✕" ToolTip="この比較を閉じる"
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.CloseComparisonCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DiffCloseButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCompare}" Value="True" />
                                                            <Condition Binding="{Binding IsMouseOver,
                                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Stats}" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource FgDim}" Margin="8,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource Accent}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="12,8" Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource FgDim}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmptyMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border}" />

            <!-- 差分本体（統合 / 左右並びを IsSideBySide で切替）。中身は code-behind が FlowDocument を組み立てる -->
            <DockPanel Grid.Column="2">

            <!-- アドホック比較の見出し帯：左右のどちらが何なのかを本文の真上に出す（ファイル名では分からないため）。
                 比較中でなければ畳む。 -->
            <Border DockPanel.Dock="Top" Padding="8,3" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CompareCaption}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding CompareCaption}" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- ハンク単位ステージ（作業ツリーの追跡済みファイルのみ）。各ハンクをステージ／アンステージできる。 -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,2" Padding="4,3"
                    Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Visibility="{Binding CanStageHunks, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="ハンク" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Hunks}" MaxHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1" ToolTip="{Binding HeaderLine}">
                                    <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}"
                                            Style="{StaticResource DiffSecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ToggleHunkCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid>
                <!-- 通常の差分表示（統合／左右）。コンフリクト解消表示中はまとめて隠す。 -->
                <Grid Visibility="{Binding Conflict.ShowDiffBody, Converter={StaticResource BoolToVis}}">
                <RichTextBox x:Name="UnifiedBox" Style="{StaticResource DiffTextBox}"
                             ContextMenu="{StaticResource DiffUnifiedMenu}"
                             Visibility="{Binding ShowUnifiedText, Converter={StaticResource BoolToVis}}" />

                <Grid x:Name="SidePanel"
                      Visibility="{Binding ShowSideText, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側（行番号ガター＋本文） -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RichTextBox x:Name="LeftGutter" Grid.Column="0" Style="{StaticResource DiffGutterBox}" />
                        <RichTextBox x:Name="LeftTextBox" Grid.Column="1" Style="{StaticResource DiffTextBox}"
                                     ContextMenu="{StaticResource DiffSideMenu}"
                                     VerticalScrollBarVisibility="Hidden" />
                    </Grid>

                    <!-- 中央：左右サイズ変更スプリッタ（左端の帯）＋中央ゲター。
                         中央ゲターは変更ブロックを帯で示し、クリックでその範囲を破棄する（Rider 風）。
                         スプリッタは破棄帯と重ならないよう左端の専用ストリップに置く。 -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />
                    <Grid Grid.Column="1" Width="20" Margin="6,0,0,0" Background="{DynamicResource BgAlt}">
                        <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource Border}" />
                        <Canvas x:Name="CenterGutter" ClipToBounds="True" Background="Transparent" />
                    </Grid>

                    <!-- 右側（行番号ガター＋本文） -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RichTextBox x:Name="RightGutter" Grid.Column="0" Style="{StaticResource DiffGutterBox}" />
                        <RichTextBox x:Name="RightTextBox" Grid.Column="1" Style="{StaticResource DiffTextBox}"
                                     ContextMenu="{StaticResource DiffSideMenu}" />
                    </Grid>
                </Grid>

                <!-- Markdown 差分のレンダリング表示（設計書 §24.10）。対象が .md/.markdown で
                     「描画」モードのときだけ出る。中身（WebView2）は DiffSessionView.MarkdownRender.cs が
                     モードを切った瞬間に実体化して差し込む——テキスト差分しか見ない間はブラウザプロセスを増やさない。 -->
                <Grid x:Name="MarkdownRenderHost" Background="{DynamicResource BgAlt}"
                      Visibility="{Binding IsMarkdownRenderActive, Converter={StaticResource BoolToVis}}">
                    <!-- 出せなかった理由（差分が大きすぎる・差分が無い）。黙って空白にしない。 -->
                    <TextBlock Margin="14,10" TextWrapping="Wrap" VerticalAlignment="Top"
                               Foreground="{DynamicResource FgDim}" Text="{Binding MarkdownRenderNotice}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MarkdownRenderNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                </Grid>

                <!-- コンフリクト解消表示（Rider 風3ペイン：Ours / Result / Theirs）。マーカー無し
                     （削除/変更の衝突等）はファイル全体で ours/theirs/削除 から選ばせる。 -->
                <DockPanel Background="{DynamicResource BgAlt}"
                           Visibility="{Binding Conflict.IsConflictMode, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" Padding="8,6"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0"
                                            Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource InverseBoolToVis}}">
                                    <Button Content="▲ 前へ" ToolTip="前のコンフリクトへ"
                                            Style="{StaticResource DiffSecondaryButton}" Margin="0,0,4,0"
                                            Command="{Binding Conflict.PreviousConflictCommand}" />
                                    <Button Content="次へ ▼" ToolTip="次のコンフリクトへ"
                                            Style="{StaticResource DiffSecondaryButton}" Margin="0,0,8,0"
                                            Command="{Binding Conflict.NextConflictCommand}" />
                                    <TextBlock Text="{Binding Conflict.ConflictPositionText}" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button DockPanel.Dock="Left" Content="元に戻す"
                                        ToolTip="直前の解決操作を取り消してコンフリクトを復元する"
                                        Style="{StaticResource DiffSecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding Conflict.UndoResolveCommand}" IsEnabled="{Binding Conflict.CanUndoResolve}"
                                        Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource InverseBoolToVis}}" />
                                <Button DockPanel.Dock="Left" Content="解決済みにする"
                                        Style="{StaticResource DiffActionButton}" Margin="0,0,8,0"
                                        Command="{Binding Conflict.MarkResolvedCommand}" IsEnabled="{Binding Conflict.CanMarkResolved}"
                                        Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource InverseBoolToVis}}" />
                                <Button DockPanel.Dock="Left" Content="エディタで開く"
                                        Style="{StaticResource DiffSecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding OpenInEditorCommand}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Conflict.ConflictProgressText}"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- 現在地（前へ/次へ、またはクリックした Result 欄）のコンフリクトを解決する操作。
                                 ボタンをコンフリクト行の中に混ぜず、ここにまとめる。 -->
                            <DockPanel LastChildFill="False" Margin="0,6,0,0"
                                       Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock DockPanel.Dock="Left" Text="現在地のコンフリクトを解決：" FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button DockPanel.Dock="Left" Content="Ours 採用 »" ToolTip="現在地に Ours を採用する"
                                        Style="{StaticResource DiffSecondaryButton}" Margin="0,0,4,0"
                                        Command="{Binding Conflict.AcceptCurrentOursCommand}" />
                                <Button DockPanel.Dock="Left" Content="両方採用" ToolTip="現在地に Ours と Theirs を両方入れる"
                                        Style="{StaticResource DiffSecondaryButton}" Margin="0,0,4,0"
                                        Command="{Binding Conflict.AcceptCurrentBothCommand}" />
                                <Button DockPanel.Dock="Left" Content="« Theirs 採用" ToolTip="現在地に Theirs を採用する"
                                        Style="{StaticResource DiffSecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding Conflict.AcceptCurrentTheirsCommand}" />
                                <Button DockPanel.Dock="Left" Content="Result を適用" ToolTip="Result 欄の内容で現在地のコンフリクトを解決する"
                                        Style="{StaticResource DiffActionButton}"
                                        Command="{Binding Conflict.ApplyCurrentResultCommand}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- マーカー無し（削除/変更の衝突・リネーム等）：ファイル全体から選ぶ -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,10"
                                Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Margin="0,0,0,10"
                                   Text="このファイルはマーカーの無い衝突です（削除/変更の衝突・リネーム等）。ours/theirs のどちらかを採用するか、削除して解決してください。" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Ours を採用" Style="{StaticResource DiffActionButton}" Margin="0,0,8,0"
                                    Command="{Binding Conflict.AcceptWholeFileOursCommand}" />
                            <Button Content="Theirs を採用" Style="{StaticResource DiffActionButton}" Margin="0,0,8,0"
                                    Command="{Binding Conflict.AcceptWholeFileTheirsCommand}" />
                            <Button Content="削除して解決" Style="{StaticResource DiffSecondaryButton}"
                                    Command="{Binding Conflict.DeleteFileConflictCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Ours/Result/Theirs 列見出し：1ファイル内の全コンフリクトで共通なので、ここで1回だけ出す
                         （各コンフリクトの中では繰り返さない）。下のコンフリクト行と同じ Star 列定義＋
                         右端に縦スクロールバー分（17px）のスペーサー列を置いて幅を揃える
                         （下の ScrollViewer は VerticalScrollBarVisibility=Visible で常時バー分が引かれる）。 -->
                    <Grid DockPanel.Dock="Top" Margin="4,4,4,0"
                          Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="17" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Conflict.ConflictOursHeader}" FontSize="{DynamicResource Fs11}"
                                   FontWeight="SemiBold" Foreground="#FF81C784" Margin="6,0,0,4" />
                        <TextBlock Grid.Column="2" Text="Result（マージ結果・編集可）" FontSize="{DynamicResource Fs11}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="6,0,0,4" />
                        <TextBlock Grid.Column="4" Text="{Binding Conflict.ConflictTheirsHeader}" FontSize="{DynamicResource Fs11}"
                                   FontWeight="SemiBold" Foreground="#FFE57373" Margin="6,0,0,4" />
                    </Grid>

                    <!-- マーカー方式：ファイル全体を通常行とコンフリクトが実際に現れる順のまま1本の流れで表示する
                         （読んでいる場所でそのままコンフリクトを解決できる。別ペインへ視線を移す必要はない）。
                         横方向は Disabled で拘束：各ブロックの Grid が常にビューポート幅を受け取り、
                         素の Star 列だけで全ブロック・見出しの桁が揃う（3ペインが必ず画面内に収まる）。
                         長い行は Ours/Theirs は各ペイン内の横スクロール、通常行は省略記号で収める。 -->
                    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Conflict.IsWholeFileConflict, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl x:Name="ConflictItemsControl" ItemsSource="{Binding Conflict.ConflictBlocks}"
                                      Margin="4,6" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
