<UserControl x:Class="sk0ya.Loomo.App.Views.PegboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
    FontSize="{DynamicResource Fs12}" Focusable="True" AllowDrop="True"
    PreviewKeyDown="OnPanelKeyDown" DragOver="OnBoardDragOver" Drop="OnBoardDrop"
    Loaded="OnLoaded" Unloaded="OnUnloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PegVisibility" />

        <!-- 線画アイコン（12px 想定・Stroke で描く。絵文字はテーマに乗らないので使わない） -->
        <StreamGeometry x:Key="PegIcon.Add">M7,2 V12 M2,7 H12</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Filter">M6,2 A4,4 0 1 0 6,10 A4,4 0 1 0 6,2 M9,9 L12.5,12.5</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Pin">M5,1.5 H9 M6,1.5 V6 L3.5,8.5 H10.5 L8,6 V1.5 M7,8.5 V12.5</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Copy">M4.5,4.5 H11.5 V12.5 H4.5 Z M2.5,9.5 V1.5 H9</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Open">M8,2 H12 V6 M12,2 L6.5,7.5 M10,8.5 V12 H2 V4 H5.5</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Delete">M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Url">M6,8 A2.5,2.5 0 0 0 9.5,8 L11.5,6 A2.5,2.5 0 0 0 8,2.5 L7,3.5 M8,6 A2.5,2.5 0 0 0 4.5,6 L2.5,8 A2.5,2.5 0 0 0 6,11.5 L7,10.5</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.File">M3,1.5 H8.5 L11,4 V12.5 H3 Z M8.5,1.5 V4 H11</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Folder">M1.5,3 H5.5 L7,4.5 H12.5 V11.5 H1.5 Z</StreamGeometry>
        <StreamGeometry x:Key="PegIcon.Text">M2,3 H12 M2,6 H12 M2,9 H9 M2,12 H7</StreamGeometry>

        <!-- カード上の小さな操作ボタン（ホバー時だけ出る。線画アイコンのみ） -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3">
                            <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardDeleteButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Error}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 種別アイコン。色は TODO Tree のタグと同じくセマンティック配色（テーマごとに差し替わる） -->
        <Style x:Key="KindIcon" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="{StaticResource PegIcon.Text}" />
            <Setter Property="Stroke" Value="{DynamicResource FgDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="url">
                    <Setter Property="Data" Value="{StaticResource PegIcon.Url}" />
                    <Setter Property="Stroke" Value="{DynamicResource SymInterface}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="file">
                    <Setter Property="Data" Value="{StaticResource PegIcon.File}" />
                    <Setter Property="Stroke" Value="{DynamicResource SymType}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="folder">
                    <Setter Property="Data" Value="{StaticResource PegIcon.Folder}" />
                    <Setter Property="Stroke" Value="{DynamicResource SymEnum}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 空文字なら畳む TextBlock（副題・プレビュー） -->
        <Style x:Key="CollapseWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ヘッダー：名前・件数・操作（TODO Tree と同じ帯） -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,3,4,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Tag="{StaticResource PegIcon.Filter}" Style="{StaticResource PaneHeaderGhostButton}"
                            Click="OnToggleFilter" ToolTip="絞り込み (Ctrl+F)"
                            AutomationProperties.Name="ペグボードの絞り込みを表示" />
                    <Button x:Name="AddButton" Tag="{StaticResource PegIcon.Add}" Content="残す"
                            Style="{StaticResource PaneHeaderGhostButton}" Click="OnAddClick"
                            ToolTip="クリップボード・ブラウザ・エディタから残す"
                            AutomationProperties.Name="ペグボードへ残す">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="クリップボードを残す" InputGestureText="Ctrl+V"
                                          ToolTip="クリップボードのテキストをカードとして残す（URL・ファイルパスは自動判別）"
                                          Command="{Binding AddFromClipboardCommand}" />
                                <MenuItem Header="ブラウザのURLを残す"
                                          ToolTip="ブラウザペインで表示中のページを残す"
                                          Command="{Binding PinBrowserUrlCommand}" />
                                <MenuItem Header="エディタの選択を残す"
                                          ToolTip="アクティブなエディタで選択中のテキストを残す"
                                          Command="{Binding PinEditorSelectionCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis">
                    <Run Text="ペグボード" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding CountLabel, Mode=OneWay}" Foreground="{DynamicResource FgDim}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- 絞り込み（Ctrl+F で開き、Esc で解除して閉じる） -->
        <DockPanel DockPanel.Dock="Top" Margin="8,5,6,2"
                   Visibility="{Binding IsFilterVisible, Converter={StaticResource PegVisibility}}">
            <Button DockPanel.Dock="Right" Tag="{StaticResource PegIcon.Delete}" Style="{StaticResource PaneHeaderGhostButton}"
                    Click="OnCloseFilter" ToolTip="絞り込みを解除して閉じる (Esc)"
                    AutomationProperties.Name="ペグボードの絞り込みを閉じる" />
            <Grid>
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="ペグボードの絞り込み" />
                <TextBlock Text="見出し・本文で絞り込み" Foreground="{DynamicResource FgDim}"
                           IsHitTestVisible="False" Margin="7,0" VerticalAlignment="Center" FontSize="{DynamicResource Fs11}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Filter}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Cards" ItemsSource="{Binding ItemsView}" Margin="0,4,0,6">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="12,6,0,3" FontSize="{DynamicResource Fs10}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource FgDim}"
                                               Visibility="{Binding DataContext.ShowSections, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PegVisibility}}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Background="{DynamicResource Bg}" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="Transparent" Margin="6,2" Padding="8,5,4,6"
                                    ToolTip="{Binding Content}" ToolTipService.InitialShowDelay="900"
                                    PreviewMouseLeftButtonDown="OnCardMouseDown"
                                    PreviewMouseMove="OnCardMouseMove">
                                <!-- 右クリック：ペイン間の「素材の流れ」操作（ターミナル/コンポーザへ）。
                                     ContextMenu は placement 先（カード）の DataContext＝アイテムを継承する -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding OpenLabel}"
                                                  Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="出典を開く"
                                                  ToolTip="残した一節を強調した状態でブラウザに開く"
                                                  Command="{Binding PlacementTarget.Tag.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Visibility>
                                                <Binding Path="HasSource">
                                                    <Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter>
                                                </Binding>
                                            </MenuItem.Visibility>
                                        </MenuItem>
                                        <MenuItem Header="ターミナルへ送る"
                                                  ToolTip="入力欄に置くだけで実行はしない（複数行はコンポーザへ）"
                                                  Command="{Binding PlacementTarget.Tag.SendToTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="コンポーザへ送る"
                                                  ToolTip="コンポーザの本文末尾へ追記する"
                                                  Command="{Binding PlacementTarget.Tag.SendToComposerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="コピー"
                                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="上部に固定／解除"
                                                  Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="削除"
                                                  Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </Border.Tag>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Path Style="{StaticResource KindIcon}" Margin="0,0,7,0" VerticalAlignment="Center" />

                                    <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <!-- 右肩：通常は固定印＋相対時刻、ホバーで操作アイコンへ差し替え（全操作は右クリックにもある） -->
                                    <Grid Grid.Column="2" Margin="6,0,0,0" MinHeight="20" VerticalAlignment="Center">
                                        <StackPanel x:Name="Meta" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <Path x:Name="PinMark" Data="{StaticResource PegIcon.Pin}" Width="10" Height="10" Stretch="Uniform"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Margin="0,0,5,0"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Visibility="Collapsed" />
                                            <TextBlock Text="{Binding CreatedLabel}" ToolTip="{Binding CreatedToolTip}"
                                                       FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource FgDim}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Collapsed">
                                            <Button x:Name="PinButton" Style="{StaticResource CardButton}" Tag="{StaticResource PegIcon.Pin}"
                                                    ToolTip="上部に固定／解除"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource CardButton}" Tag="{StaticResource PegIcon.Copy}" ToolTip="コピー"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource CardButton}" Tag="{StaticResource PegIcon.Url}" ToolTip="出典を開く"
                                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasSource, Converter={StaticResource PegVisibility}}" />
                                            <Button Style="{StaticResource CardButton}" Tag="{StaticResource PegIcon.Open}" ToolTip="{Binding OpenLabel}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource CardDeleteButton}" Tag="{StaticResource PegIcon.Delete}" ToolTip="削除"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 所在（url のアドレス／file の親フォルダー／ブラウザから残した text の出典） -->
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}"
                                               ToolTip="{Binding Snapshot.SourceUrl}"
                                               Style="{StaticResource CollapseWhenEmpty}" Margin="0,1,4,0"
                                               FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource FgDim}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- text の続き（先頭行は見出しに出ているので2行目以降） -->
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Preview}"
                                               Style="{StaticResource CollapseWhenEmpty}" Margin="0,2,4,0"
                                               FontSize="{DynamicResource Fs11}" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                                               MaxHeight="46" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="text">
                                    <Setter TargetName="Title" Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                    <Setter TargetName="Title" Property="FontWeight" Value="Normal" />
                                    <Setter TargetName="Title" Property="FontSize" Value="{DynamicResource Fs11}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                    <Setter TargetName="PinMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="PinButton" Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border}" />
                                    <Setter TargetName="Meta" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空のとき／絞り込みで0件のとき -->
            <TextBlock Margin="14,12" VerticalAlignment="Top" Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                       Style="{StaticResource CollapseWhenEmpty}" IsHitTestVisible="False"
                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" />
        </Grid>
    </DockPanel>
</UserControl>
