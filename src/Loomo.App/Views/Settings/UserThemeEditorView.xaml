<UserControl x:Class="sk0ya.Loomo.App.Views.UserThemeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
             Background="{DynamicResource Panel}"
             Foreground="{DynamicResource Fg}">
    <UserControl.Resources>
        <DataTemplate x:Key="ThemeChipTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True" Background="{Binding Bg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Border Height="5" VerticalAlignment="Bottom" Background="{Binding Accent}" />
                </Border>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <CollectionViewSource x:Key="GroupedSlots" Source="{Binding Slots}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 種類の切り替え（タブ）。選んでいるものはアクセントの下線。 -->
        <Style x:Key="KindTabItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Padding="16,9,16,7" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <TextBlock x:Name="t" Text="{Binding Title}" Foreground="{DynamicResource FgDim}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 色の欄 1 つ＝押せるタイル。押すとピッカーが横に出る。 -->
        <Style x:Key="SlotTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,5"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 見本の中の等幅の行 -->
        <Style x:Key="PvMono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,1" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== 上：何のテーマを作るか ===== -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel>
                <TextBlock Text="作るテーマ：" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="4,0,4,0" />
                <ListBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                         ItemContainerStyle="{StaticResource KindTabItem}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 下の帯：状態と操作 ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="元に戻す" Command="{Binding RevertCommand}" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding CanRevert}" Margin="0,0,8,0"
                            ToolTip="このテーマを開いたときの色へ戻します（変更は自動で保存されています）" />
                    <Button Command="{Binding UseInRoomCommand}" Style="{StaticResource FlatButton}" IsEnabled="{Binding HasTheme}"
                            ToolTip="外観パネルのこの種類の欄でこのテーマを選びます">
                        <TextBlock Text="{Binding KindTitle, StringFormat='{}{0}に使う'}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：この種類の自分のテーマ ===== -->
            <Border Grid.Column="0" Background="{DynamicResource BgAlt}" Padding="12,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding KindTitle, StringFormat='自分の{0}のテーマ'}"
                               FontWeight="SemiBold" Margin="2,0,0,8" TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="もとにするテーマ" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding BaseChoices}" SelectedItem="{Binding SelectedBase}"
                                  ItemTemplate="{StaticResource ThemeChipTemplate}" />
                        <Button Content="＋ 新しく作る" Command="{Binding NewThemeCommand}" Style="{StaticResource FlatButton}"
                                Margin="0,8,0,0" ToolTip="選んだテーマの色を写したところから始めます" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="複製" Command="{Binding DuplicateCommand}" Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding HasTheme}" Margin="0,0,4,0" />
                            <Button Content="削除" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding HasTheme}" Margin="4,0,0,0" />
                        </UniformGrid>
                        <Button Content="JSON を開く" Command="{Binding OpenJsonCommand}" Style="{StaticResource SecondaryButton}"
                                IsEnabled="{Binding HasTheme}" Margin="0,8,0,0"
                                ToolTip="テーマのファイルを部屋のエディタで開きます" />
                        <Button Content="フォルダーを開く" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0" ToolTip="テーマのファイルが入っているフォルダーを開きます" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             ItemTemplate="{StaticResource ThemeChipTemplate}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- ===== 中央：色 ===== -->
            <Grid Grid.Column="1">
                <TextBlock Margin="24" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Text="{Binding EmptyMessage}"
                           Visibility="{Binding HasTheme, Converter={StaticResource InverseBoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasTheme, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="18,14,18,14">
                        <TextBlock Text="名前" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs12}"
                                   Text="色を押すと選べます。色にカーソルを当てると、その色が使われている所を右の見本で囲んで示します。" />

                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedSlots}}" Margin="-6,0,-6,0">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,18,6,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Items[0].GroupDescription}" Foreground="{DynamicResource FgDim}"
                                                           FontSize="{DynamicResource Fs11}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <!-- グループの中のタイルを 2 列に（GroupStyle.Panel はグループ自体の並びなので使わない） -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorSlotViewModel}">
                                    <Button Style="{StaticResource SlotTile}" Click="OnSlotClick" ToolTip="{Binding Hint}" Margin="0,1"
                                            MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="5"
                                                    Background="{Binding Brush}" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                                            <!-- 名前は幅いっぱいに使う。⚠ は名前のすぐ後ろ、「自動」の札は 2 行目の頭に置く -->
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="⚠" Margin="4,0,0,0" Foreground="{DynamicResource Error}"
                                                               ToolTip="{Binding Warning}"
                                                               Visibility="{Binding Warning, Converter={StaticResource NonEmptyToVis}}" />
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" VerticalAlignment="Center" CornerRadius="3" Padding="4,0" Margin="0,1,5,0"
                                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                            Visibility="{Binding IsAuto, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="ほかの色と背景の明暗から自動で決まっています。押して色を選ぶと自分の色になります">
                                                        <TextBlock Text="自動" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Usage}" Foreground="{DynamicResource FgDim}"
                                                               FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 右：見本（自分の Resources に決まった色を持ち、中は DynamicResource で塗る）=====
                 Tag="use:…" はその見本がどの欄の色を使っているか。色のタイルにカーソルを当てると、ここを見て囲む。 -->
            <DockPanel Grid.Column="2" Margin="4,14,18,14">
                <TextBlock x:Name="PreviewCaption" DockPanel.Dock="Top" Text="見本" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReadabilitySummary}" Margin="2,10,0,0" TextWrapping="Wrap"
                           FontSize="{DynamicResource Fs12}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReadabilityIssues}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border x:Name="PreviewRoot" CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                        BorderBrush="{DynamicResource Border}">
                    <Grid>
                        <!-- ===== アプリの画面 ===== -->
                        <Grid x:Name="AppPreview" Background="{DynamicResource Bg}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ActivityBarBg}" Tag="use:activityBar">
                                <StackPanel Margin="0,10,0,0">
                                    <Border Height="28" BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0" Tag="use:accent">
                                        <Rectangle Width="14" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource Fg}" />
                                    </Border>
                                    <Rectangle Width="14" Height="14" RadiusX="7" RadiusY="7" Margin="0,12" Fill="{DynamicResource FgDim}" />
                                    <Rectangle Width="14" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource FgDim}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="0,0,1,0" Tag="use:background">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBg}" Padding="10,7" Tag="use:accent">
                                        <TextBlock Text="エクスプローラー" FontWeight="SemiBold" FontSize="{DynamicResource Fs12}" />
                                    </Border>
                                    <StackPanel Margin="0,6" TextElement.FontSize="{DynamicResource Fs12}">
                                        <StackPanel Tag="use:foreground">
                                            <TextBlock Text="▾ src" Margin="10,2" />
                                            <TextBlock Text="App.cs" Margin="22,2" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource SelectionBg}" Tag="use:selection">
                                            <TextBlock Text="Theme.cs" Margin="22,2" />
                                        </Border>
                                        <TextBlock Margin="22,2" HorizontalAlignment="Left" Tag="use:searchHighlight"><Run Text="Ro" /><Run Text="om" Background="{DynamicResource SearchHighlight}" /><Run Text=".cs" /></TextBlock>
                                        <TextBlock Text="README.md" Margin="22,2" HorizontalAlignment="Left" Foreground="{DynamicResource FgDim}" Tag="use:dim" />
                                        <TextBlock Text="構造" Foreground="{DynamicResource FgDim}" Margin="10,14,0,2" FontSize="{DynamicResource Fs11}" />
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symType"><Run Text="◆ " Foreground="{DynamicResource SymType}" /><Run Text="Theme" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symInterface"><Run Text="◇ " Foreground="{DynamicResource SymInterface}" /><Run Text="ITheme" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symMethod"><Run Text="ƒ " Foreground="{DynamicResource SymMethod}" /><Run Text="Apply" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symProperty"><Run Text="▪ " Foreground="{DynamicResource SymProperty}" /><Run Text="Name" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symField"><Run Text="▫ " Foreground="{DynamicResource SymField}" /><Run Text="_cache" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symConstant"><Run Text="π " Foreground="{DynamicResource SymConstant}" /><Run Text="Depth" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symEnum"><Run Text="≡ " Foreground="{DynamicResource SymEnum}" /><Run Text="Kind" /></TextBlock>
                                        <TextBlock Margin="10,1" HorizontalAlignment="Left" Tag="use:symNamespace"><Run Text="{}{} " Foreground="{DynamicResource SymNamespace}" /><Run Text="Loomo" /></TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- 右：設定画面風（入力欄・ボタン・合否） -->
                            <DockPanel Grid.Column="2" Background="{DynamicResource Panel}" Tag="use:background">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBg}" Padding="10,7" Tag="use:accent">
                                    <TextBlock Text="テスト" FontWeight="SemiBold" FontSize="{DynamicResource Fs12}" />
                                </Border>
                                <StackPanel Margin="14,12" TextElement.FontSize="{DynamicResource Fs12}">
                                    <TextBlock Text="絞り込み" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4" HorizontalAlignment="Left" Tag="use:dim" />
                                    <Border Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="3" Padding="8,4" Tag="use:surface border">
                                        <TextBlock Text="Theme" />
                                    </Border>
                                    <StackPanel Margin="0,12,0,0" Tag="use:foreground">
                                        <TextBlock Margin="0,2"><Run Text="✓ " Foreground="{DynamicResource Success}" /><Run Text="色が保存できる" /></TextBlock>
                                        <TextBlock Margin="0,2"><Run Text="✓ " Foreground="{DynamicResource Success}" /><Run Text="自動の色が決まる" /></TextBlock>
                                        <TextBlock Margin="0,2"><Run Text="✗ " Foreground="{DynamicResource Error}" /><Run Text="読めない色を弾く" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="● 合格 2" Foreground="{DynamicResource Success}" Margin="0,0,12,0" Tag="use:success" />
                                        <TextBlock Text="● 失敗 1" Foreground="{DynamicResource Error}" Tag="use:error" />
                                    </StackPanel>
                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,14" Tag="use:border" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="もう一度" Style="{StaticResource FlatButton}" Padding="12,5" Tag="use:accent" />
                                        <Button Content="閉じる" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                                               Text="エディタ・ターミナル・Markdown プレビューの中の色は、上の切り替えでそれぞれ作れます。" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <!-- ===== エディタ ===== -->
                        <DockPanel x:Name="EditorPreview" Background="{DynamicResource C_background}" Tag="use:background">
                            <!-- 下の状態の帯 -->
                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource C_accent}" Padding="10,3" Tag="use:accent">
                                <TextBlock Style="{StaticResource PvMono}" Foreground="{DynamicResource E_StatusFg}" Text="NORMAL   Theme.cs   5:11" />
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style x:Key="LineNo" TargetType="TextBlock" BasedOn="{StaticResource PvMono}">
                                        <Setter Property="Foreground" Value="{DynamicResource C_comment}" />
                                        <Setter Property="Padding" Value="12,1,8,1" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Background" Value="{DynamicResource E_LineBg}" />
                                        <Setter Property="Grid.Column" Value="0" />
                                    </Style>
                                    <Style x:Key="Code" TargetType="TextBlock" BasedOn="{StaticResource PvMono}">
                                        <Setter Property="Foreground" Value="{DynamicResource C_foreground}" />
                                        <Setter Property="Margin" Value="10,0,0,0" />
                                        <Setter Property="Grid.Column" Value="2" />
                                    </Style>
                                </Grid.Resources>
                                <!-- 行番号の帯（その色は背景から、数字はコメントの色） -->
                                <Border Grid.Column="0" Grid.RowSpan="10" Background="{DynamicResource E_LineBg}" />
                                <TextBlock Grid.Row="0" Style="{StaticResource LineNo}" Text="1" Tag="use:comment" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LineNo}" Text="2" />
                                <TextBlock Grid.Row="2" Style="{StaticResource LineNo}" Text="3" />
                                <TextBlock Grid.Row="3" Style="{StaticResource LineNo}" Text="4" />
                                <TextBlock Grid.Row="4" Style="{StaticResource LineNo}" Text="5" Foreground="{DynamicResource C_foreground}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource LineNo}" Text="6" />
                                <TextBlock Grid.Row="6" Style="{StaticResource LineNo}" Text="7" />
                                <TextBlock Grid.Row="7" Style="{StaticResource LineNo}" Text="8" />
                                <TextBlock Grid.Row="8" Style="{StaticResource LineNo}" Text="9" />
                                <!-- 変更の印（行番号の右の細い帯）：追加・変更・削除 -->
                                <Rectangle Grid.Row="5" Grid.Column="1" Fill="{DynamicResource C_added}" Tag="use:added" />
                                <Rectangle Grid.Row="7" Grid.Column="1" Fill="{DynamicResource C_warning}" Tag="use:warning" />
                                <Polygon Grid.Row="8" Grid.Column="1" Points="0,0 3,3 0,6" Fill="{DynamicResource C_error}" Tag="use:error" />
                                <!-- カーソルのある行の下地 -->
                                <Border Grid.Row="4" Grid.Column="2" Background="{DynamicResource E_CurrentLine}" />
                                <TextBlock Grid.Row="0" Style="{StaticResource Code}" Tag="use:comment"><Run Foreground="{DynamicResource C_comment}" Text="// 部屋の色を決める" /></TextBlock>
                                <TextBlock Grid.Row="1" Style="{StaticResource Code}" Tag="use:attribute"><Run Foreground="{DynamicResource C_attribute}" Text="[Serializable]" /></TextBlock>
                                <TextBlock Grid.Row="2" Style="{StaticResource Code}" Tag="use:keyword type"><Run Foreground="{DynamicResource C_keyword}" Text="public class " /><Run Foreground="{DynamicResource C_type}" Text="Theme" /></TextBlock>
                                <TextBlock Grid.Row="3" Style="{StaticResource Code}" Text="{}{" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Code}" Tag="use:keyword type number accent"><Run Text="    " /><Run Foreground="{DynamicResource C_keyword}" Text="const " /><Run Foreground="{DynamicResource C_type}" Text="int " /><Run Text="Depth" Background="{DynamicResource E_Selection}" /><Run Text=" = " /><Run Foreground="{DynamicResource C_number}" Text="42" /><Run Text=";" /><Run Text="▏" Foreground="{DynamicResource C_accent}" /></TextBlock>
                                <TextBlock Grid.Row="5" Style="{StaticResource Code}" Tag="use:type function"><Run Text="    " /><Run Foreground="{DynamicResource C_type}" Text="string " /><Run Foreground="{DynamicResource C_function}" Text="Greet" /><Run Text="(" /><Run Foreground="{DynamicResource C_type}" Text="string " /><Run Text="n)" /></TextBlock>
                                <TextBlock Grid.Row="6" Style="{StaticResource Code}" Tag="use:string warning"><Run Text="        =&gt; " /><Run Foreground="{DynamicResource C_string}" Text="$&quot;" /><Run Foreground="{DynamicResource C_string}" Text="ようこそ" Background="{DynamicResource E_Search}" /><Run Foreground="{DynamicResource C_string}" Text=" {n}&quot;" /><Run Text=";" /></TextBlock>
                                <TextBlock Grid.Row="7" Style="{StaticResource Code}" Tag="use:error"><Run Text="    " /><Run Foreground="{DynamicResource C_keyword}" Text="int " /><Run Foreground="{DynamicResource C_function}" Text="Bad" /><Run Text="() =&gt; " /><Run x:Name="ErrorRun" Text="undefined" /><Run Text=";" /></TextBlock>
                                <TextBlock Grid.Row="8" Style="{StaticResource Code}" Text="}" />
                            </Grid>
                        </DockPanel>

                        <!-- ===== ターミナル ===== -->
                        <DockPanel x:Name="TerminalPreview" Background="{DynamicResource C_background}" Tag="use:background">
                            <!-- 16 色の見本（上 8＝標準、下 8＝明るい版） -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
                                <StackPanel.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="14" />
                                        <Setter Property="Margin" Value="1" />
                                        <Setter Property="CornerRadius" Value="2" />
                                    </Style>
                                </StackPanel.Resources>
                                <UniformGrid Columns="8">
                                    <Border Background="{DynamicResource C_black}" Tag="use:black" ToolTip="黒" />
                                    <Border Background="{DynamicResource C_red}" Tag="use:red" ToolTip="赤" />
                                    <Border Background="{DynamicResource C_green}" Tag="use:green" ToolTip="緑" />
                                    <Border Background="{DynamicResource C_yellow}" Tag="use:yellow" ToolTip="黄" />
                                    <Border Background="{DynamicResource C_blue}" Tag="use:blue" ToolTip="青" />
                                    <Border Background="{DynamicResource C_magenta}" Tag="use:magenta" ToolTip="紫" />
                                    <Border Background="{DynamicResource C_cyan}" Tag="use:cyan" ToolTip="水色" />
                                    <Border Background="{DynamicResource C_white}" Tag="use:white" ToolTip="白" />
                                </UniformGrid>
                                <UniformGrid Columns="8">
                                    <Border Background="{DynamicResource C_brightBlack}" Tag="use:brightBlack" />
                                    <Border Background="{DynamicResource C_brightRed}" Tag="use:brightRed" />
                                    <Border Background="{DynamicResource C_brightGreen}" Tag="use:brightGreen" />
                                    <Border Background="{DynamicResource C_brightYellow}" Tag="use:brightYellow" />
                                    <Border Background="{DynamicResource C_brightBlue}" Tag="use:brightBlue" />
                                    <Border Background="{DynamicResource C_brightMagenta}" Tag="use:brightMagenta" />
                                    <Border Background="{DynamicResource C_brightCyan}" Tag="use:brightCyan" />
                                    <Border Background="{DynamicResource C_brightWhite}" Tag="use:brightWhite" />
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="12,10,12,8">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PvMono}">
                                        <Setter Property="Foreground" Value="{DynamicResource C_foreground}" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Tag="use:green blue foreground"><Run Foreground="{DynamicResource C_green}" Text="PS " /><Run Foreground="{DynamicResource C_blue}" Text="C:\Projects\Loomo" /><Run Text="&gt; ls" /></TextBlock>
                                <TextBlock Tag="use:blue green cyan magenta"><Run Foreground="{DynamicResource C_blue}" Text="src/  tests/  " /><Run Foreground="{DynamicResource C_green}" Text="build.ps1  " /><Run Foreground="{DynamicResource C_cyan}" Text="docs -&gt; ../docs  " /><Run Foreground="{DynamicResource C_magenta}" Text="loomo.sock" /></TextBlock>
                                <TextBlock Tag="use:green blue foreground"><Run Foreground="{DynamicResource C_green}" Text="PS " /><Run Foreground="{DynamicResource C_blue}" Text="C:\Projects\Loomo" /><Run Text="&gt; git status --short" /></TextBlock>
                                <TextBlock Tag="use:green"><Run Foreground="{DynamicResource C_green}" Text="A  src/NewTheme.cs" /></TextBlock>
                                <TextBlock Tag="use:red"><Run Foreground="{DynamicResource C_red}" Text=" M src/Theme.cs" /></TextBlock>
                                <TextBlock Tag="use:brightBlack"><Run Foreground="{DynamicResource C_brightBlack}" Text="# 2 件の変更" /></TextBlock>
                                <TextBlock Tag="use:green blue foreground"><Run Foreground="{DynamicResource C_green}" Text="PS " /><Run Foreground="{DynamicResource C_blue}" Text="C:\Projects\Loomo" /><Run Text="&gt; dotnet test" /></TextBlock>
                                <TextBlock Tag="use:green yellow red"><Run Foreground="{DynamicResource C_green}" Text="成功 5373  " /><Run Foreground="{DynamicResource C_yellow}" Text="警告 2  " /><Run Foreground="{DynamicResource C_red}" Text="失敗 0" /></TextBlock>
                                <TextBlock Tag="use:brightRed brightGreen brightYellow brightBlue brightMagenta brightCyan brightWhite"><Run Foreground="{DynamicResource C_brightRed}" Text="強調 " /><Run Foreground="{DynamicResource C_brightGreen}" Text="強調 " /><Run Foreground="{DynamicResource C_brightYellow}" Text="強調 " /><Run Foreground="{DynamicResource C_brightBlue}" Text="強調 " /><Run Foreground="{DynamicResource C_brightMagenta}" Text="強調 " /><Run Foreground="{DynamicResource C_brightCyan}" Text="強調 " /><Run Foreground="{DynamicResource C_brightWhite}" Text="強調" /></TextBlock>
                                <TextBlock Tag="use:selection cursor"><Run Foreground="{DynamicResource C_green}" Text="PS " /><Run Text="&gt; " /><Run Text="echo 選んだ所" Background="{DynamicResource C_selection}" /><Run Text=" " /><Run Text=" " Background="{DynamicResource C_cursor}" /></TextBlock>
                                <TextBlock Tag="use:black white"><Run Text=" 黒の地に白 " Background="{DynamicResource C_black}" Foreground="{DynamicResource C_white}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <!-- ===== Markdown プレビュー ===== -->
                        <ScrollViewer x:Name="PreviewPreview" VerticalScrollBarVisibility="Auto" Background="{DynamicResource C_background}" Tag="use:background">
                            <StackPanel Margin="20,16">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource C_foreground}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="部屋の色" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource C_heading}" Tag="use:heading" />
                                <Border Height="1" Background="{DynamicResource C_border}" Margin="0,6,0,10" Tag="use:border" />
                                <TextBlock Margin="0,0,0,8" Tag="use:foreground link strong"><Run Text="Loomo は" /><Run Text="人間の作業場" Foreground="{DynamicResource C_link}" TextDecorations="Underline" /><Run Text="です。色は" /><Run Text="自分で決められます" FontWeight="Bold" Foreground="{DynamicResource C_strong}" /><Run Text="。" /></TextBlock>
                                <TextBlock Margin="0,0,0,10" Tag="use:code codeBackground"><Run Text="設定は " /><Run Text=" theme.json " Foreground="{DynamicResource C_code}" Background="{DynamicResource C_codeBackground}" FontFamily="Cascadia Mono, Consolas" /><Run Text=" に保存します。" /></TextBlock>
                                <Border BorderBrush="{DynamicResource C_border}" BorderThickness="3,0,0,0" Padding="10,2" Margin="0,0,0,12" HorizontalAlignment="Left" Tag="use:dim">
                                    <TextBlock Text="引用：書かない色は自動で決まります。" Foreground="{DynamicResource C_dim}" />
                                </Border>
                                <TextBlock Text="使い方" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource C_heading}" Margin="0,0,0,6" Tag="use:heading" />
                                <Border Background="{DynamicResource C_codeBackground}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12" Tag="use:codeBackground code">
                                    <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource C_code}" Text="loomo theme apply my-theme" />
                                </Border>
                                <Border BorderBrush="{DynamicResource C_border}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12" Tag="use:border">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource C_border}" BorderThickness="0,0,1,1" Padding="8,3"><TextBlock Text="種類" FontWeight="SemiBold" /></Border>
                                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource C_border}" BorderThickness="0,0,0,1" Padding="8,3"><TextBlock Text="保存先" FontWeight="SemiBold" /></Border>
                                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource C_border}" BorderThickness="0,0,1,0" Padding="8,3"><TextBlock Text="エディタ" /></Border>
                                        <Border Grid.Row="1" Grid.Column="1" Padding="8,3"><TextBlock Text="themes/editor" /></Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="ログ・差分の表示" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource C_heading}" Margin="0,0,0,6" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Tag="use:red"><Run Foreground="{DynamicResource C_red}" Text="ERROR 色が読めません" /></TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Tag="use:yellow"><Run Foreground="{DynamicResource C_yellow}" Text="WARN  コントラストが低い" /></TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Tag="use:green"><Run Foreground="{DynamicResource C_green}" Text="+ 追加した行" /></TextBlock>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 色の使われ所を囲む層 -->
                        <Canvas x:Name="UsageLayer" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
