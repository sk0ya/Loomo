<UserControl x:Class="sk0ya.Loomo.App.Views.KeybindingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
    Focusable="True" Loaded="OnLoaded">
    <!-- キーボードショートカット画面（独立ウィンドウの中身）。DataContext は KeybindingsViewModel。
         左＝大分類（すべて／画面・ペイン／パレット・検索／エディタ／ターミナル／軌跡）、右＝その中を小分類の
         見出しで区切った一覧。探す道具（検索・観点チップ）は一覧の上に固定し、スクロールしても見失わない。 -->

    <UserControl.Resources>
        <!-- 左ナビの大分類（全幅・ホバー/選択でハイライト。設定画面の左ナビと同じ見た目）。
             件数は絞り込み後の数なので、検索のヒットがどの分類にあるかがここで見える。 -->
        <Style x:Key="AreaNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ContentText}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Panel}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Panel}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ショートカット一覧の観点チップ（横並びの小さなピル。選択中はアクセント）。 -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="10" Padding="10,3"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ContentText}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ショートカット 1 行。ホバーで下地を敷き、長い一覧でも視線が行から外れないようにする。 -->
        <Style x:Key="KeybindingRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgAlt}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 行の警告（重複・連鎖の影）。押すと当該キーで絞り込むのでボタンだが、見た目はリンク。
             色はテーマ非依存の警告色（Git の変更色と同系）。 -->
        <Style x:Key="WarningLink" TargetType="Button">
            <Setter Property="Foreground" Value="#E0A030" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextWrapping="Wrap" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Panel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左ナビ：大分類 -->
        <DockPanel Grid.Column="0" Background="{DynamicResource BgAlt}">
            <TextBlock DockPanel.Dock="Top" Text="キーボード" Margin="16,14,0,10"
                       FontSize="{DynamicResource Fs15}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg}" />
            <ListBox Margin="8,4,8,8" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Areas}"
                     SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource AreaNavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Width="24" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Count}" Margin="8,0,0,0"
                                       FontSize="{DynamicResource Fs11}" FontWeight="Normal"
                                       VerticalAlignment="Center" Opacity="0.75" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 右：探す道具（固定）＋一覧（スクロール）＋一括リセット（下端に固定） -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="22,18,20,4">
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedArea.Name}"
                               VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding CountText}"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource FgDim}" />
                </Grid>

                <!-- 検索（左に虫眼鏡、空のときだけ説明、入力中だけ ✕） -->
                <Grid Margin="0,8,0,0">
                    <TextBox x:Name="KeybindingSearchBox" Padding="30,5,26,5"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <TextBlock Text="🔍" Margin="9,0,0,0" HorizontalAlignment="Left"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource FgDim}" />
                    <TextBlock Text="コマンド名・キー（例: Ctrl+W）で絞り込み"
                               Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource FgDim}"
                               Visibility="{Binding Query, Converter={StaticResource EmptyToVis}}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,3,0" Width="22" Height="22"
                            Style="{StaticResource IconButton}" FontSize="{DynamicResource Fs11}"
                            Content="✕" ToolTip="検索を消す"
                            Command="{Binding ClearQueryCommand}"
                            Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 観点チップ（同じ親の中なので RadioButton は自動で 1 グループ） -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{Binding AllChipText}"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{Binding CustomizedChipText}"
                                 ToolTip="既定から変更したコマンドだけを表示します。"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Customized}" />
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{Binding UnassignedChipText}"
                                 ToolTip="キーが割り当たっていないコマンドだけを表示します。"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Unassigned}" />
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Content="{Binding ProblemChipText}"
                                 ToolTip="キーが重複している／連鎖の 1 打目に隠れて発火しないコマンドだけを表示します。"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Problem}" />
                </StackPanel>

                <TextBlock Style="{StaticResource FieldHint}"
                           Text="キー欄をクリック（または Tab で移動して Enter）してから、割り当てたいキーを押します。連鎖（例 Ctrl+W → H）は続けて 2 打。Esc で取消。" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Padding="22,8,20,10">
                <Button Style="{StaticResource WideSecondaryButton}"
                        Content="すべて既定に戻す"
                        ToolTip="変更したショートカットが無いときは押せません。"
                        Command="{Binding ResetAllCommand}" />
            </Border>

            <!-- 一覧は仮想化する（見えている行だけ作る）。全 130 行超を一度に作ると、行ごとの KeyCaptureBox
                 （自前のスタイルを持つ UserControl）が積み上がって開くのに 1 秒近くかかっていた。
                 仮想化には ItemsControl 自身が ScrollViewer を持つ必要があるので、外側に ScrollViewer を置かない。 -->
            <Grid>
                    <ItemsControl ItemsSource="{Binding RowsView}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,20,12"
                                              CanContentScroll="True" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold" Margin="6,12,0,4"
                                                   Foreground="{DynamicResource FgDim}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run
                                                Text="{Binding ItemCount, Mode=OneWay}" FontWeight="Normal" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KeybindingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DetailText}" />
                                        <TextBlock Text="{Binding DefaultHintText}" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource FgDim}"
                                                   Visibility="{Binding DefaultHintText, Converter={StaticResource NonEmptyToVis}}" />
                                        <!-- 警告はクリックできる：同じキーの行だけに絞って当事者を並べる。 -->
                                        <Button Style="{StaticResource WarningLink}"
                                                Content="{Binding WarningText}"
                                                ToolTip="このキーに関わるコマンドだけを表示します。"
                                                Command="{Binding RevealConflictCommand}"
                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <local:KeyCaptureBox Grid.Column="1" VerticalAlignment="Center" />
                                    <!-- 操作は固定幅の枠に収める（出入りしても行の桁が動かないように）。 -->
                                    <Grid Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource IconButton}"
                                                Width="26" Height="26" FontSize="{DynamicResource Fs14}"
                                                Content="↺" ToolTip="既定に戻す"
                                                Command="{Binding ResetCommand}"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                        <!-- 「未割当にする」は 30 行すべてに常時出すと目に煩いので、
                                             その行を触っているとき（ホバー／キーボードフォーカス）だけ出す。
                                             枠は固定幅なので、出入りしても桁は動かない。 -->
                                        <Button Grid.Column="1"
                                                Width="26" Height="26" FontSize="{DynamicResource Fs12}"
                                                Content="✕" ToolTip="未割当にする"
                                                Command="{Binding ClearCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Value="False" Binding="{Binding IsUnassigned}" />
                                                                <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Value="False" Binding="{Binding IsUnassigned}" />
                                                                <Condition Value="True" Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状態：絞りすぎたときに、戻る手段まで出す。 -->
                    <StackPanel Margin="0,20,0,0" VerticalAlignment="Top"
                                Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="条件に合うコマンドがありません。" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource FgDim}" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Center" Content="絞り込みを解除"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
