<Window x:Class="sk0ya.Loomo.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 — Loomo"
        Width="820" Height="620" MinWidth="520" MinHeight="320"
        Background="{DynamicResource Panel}"
        Foreground="{DynamicResource Fg}"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 本体・切り離しウィンドウと同じ自前キャプション方式（WindowChrome はリサイズ枠のみ担当）。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- キャプション：左は空きスペース（ドラッグでウィンドウ移動）、右にボタン。
             タイトル文字は中身の左ナビの見出し（「設定」「キーボード」）が兼ねるので置かない。 -->
        <!-- 背景は本体のタイトルバーと同じ ActivityBarBg に揃える。 -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource ActivityBarBg}"
              MouseLeftButtonDown="OnCaptionMouseDown">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
                <!-- 本体と同じスタイル＋同じ Path アイコン。Height はこのバーの高さに合わせて伸ばす。 -->
                <Button Style="{DynamicResource CaptionButton}" Height="Auto" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="最小化" Click="OnMinimize">
                    <Path Stretch="None" StrokeThickness="1" SnapsToDevicePixels="True"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0,5 H10" />
                </Button>
                <Button x:Name="MaxRestoreButton" Style="{DynamicResource CaptionButton}" Height="Auto"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化" Click="OnMaxRestore">
                    <Path x:Name="MaxRestoreIcon" Stretch="None" StrokeThickness="1" SnapsToDevicePixels="True"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                </Button>
                <Button Style="{DynamicResource CaptionCloseButton}" Height="Auto" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="閉じる（Esc）" Click="OnCloseWindow">
                    <Path Stretch="None" StrokeThickness="1" SnapsToDevicePixels="True"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0,0 L10,10 M0,10 L10,0" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 中身（SettingsView／KeybindingsView）はコンストラクタで差し込む。 -->
        <ContentControl x:Name="Body" Focusable="False" />
    </DockPanel>
</Window>
