<Window x:Class="sk0ya.Loomo.App.Views.UserThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
        xmlns:views="clr-namespace:sk0ya.Loomo.App.Views"
        Title="自分のテーマ"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource Fs13}">
    <Window.Resources>
        <DataTemplate x:Key="ThemeChipTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" CornerRadius="3" ClipToBounds="True" Background="{Binding Bg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Border Height="4" VerticalAlignment="Bottom" Background="{Binding Accent}" />
                </Border>
                <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
            </StackPanel>
        </DataTemplate>

        <CollectionViewSource x:Key="GroupedSlots" Source="{Binding Slots}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- プレビューの見本の中の小さな見出し -->
        <Style x:Key="PvLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== 下の帯：状態と操作 ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="元に戻す" Command="{Binding RevertCommand}" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding IsDirty}" Margin="0,0,6,0" ToolTip="保存した状態へ戻します" />
                    <Button Content="JSON を開く" Command="{Binding OpenJsonCommand}" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding HasTheme}" Margin="0,0,6,0"
                            ToolTip="テーマのファイルを部屋のエディタで開きます（ui / ansi の直接指定など、この画面に無い項目を書くとき）" />
                    <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding IsDirty}" Margin="0,0,6,0"
                            ToolTip="ファイルへ保存します。このテーマを使っている所はその場で塗り直されます" />
                    <Button Content="保存して部屋に当てる" Command="{Binding UseInRoomCommand}" Style="{StaticResource FlatButton}"
                            IsEnabled="{Binding HasTheme}" Margin="0,0,6,0"
                            ToolTip="保存して、アプリ全体・エディタ・ターミナル・プレビューのすべてでこのテーマを選びます" />
                    <Button Content="閉じる" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：テーマの一覧 ===== -->
            <Border Grid.Column="0" Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,1,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="自分のテーマ" Style="{StaticResource PaneTitle}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="もとにするテーマ" Style="{StaticResource PaneTitle}" />
                        <ComboBox ItemsSource="{Binding BaseChoices}" SelectedItem="{Binding SelectedBase}"
                                  ItemTemplate="{StaticResource ThemeChipTemplate}" />
                        <Button Content="＋ 新しく作る" Command="{Binding NewThemeCommand}" Style="{StaticResource FlatButton}"
                                Margin="0,6,0,0" ToolTip="選んだテーマの色を写したところから始めます" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="複製" Command="{Binding DuplicateCommand}" Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding HasTheme}" Margin="0,0,3,0" />
                            <Button Content="削除" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding HasTheme}" Margin="3,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             ItemTemplate="{StaticResource ThemeChipTemplate}"
                             Background="Transparent" BorderThickness="0" />
                </DockPanel>
            </Border>

            <!-- ===== 中央：色の欄 ===== -->
            <Grid Grid.Column="1">
                <TextBlock Margin="20" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                           Visibility="{Binding HasTheme, Converter={StaticResource InverseBoolToVis}}"
                           Text="まだ自分のテーマがありません。左下で「もとにするテーマ」を選んで「新しく作る」を押すと、その色を写したところから始められます。" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12"
                              Visibility="{Binding HasTheme, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="名前" Style="{StaticResource PaneTitle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedSlots}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PaneTitle}" Margin="0,10,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorSlotViewModel}">
                                    <DockPanel Margin="0,2" ToolTip="{Binding Hint}">
                                        <Button DockPanel.Dock="Left" Width="34" Height="24" Cursor="Hand"
                                                Click="OnSwatchClick" ToolTip="クリックで色を選ぶ">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" CornerRadius="4" BorderThickness="1"
                                                            BorderBrush="{DynamicResource Border}" Background="{Binding Brush}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                            <Setter TargetName="b" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- 必須の欄でも幅は取っておく（16 進の欄の位置を揃える） -->
                                        <Grid DockPanel.Dock="Right" Width="64">
                                            <CheckBox Content="自動" IsChecked="{Binding IsAuto}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource FgDim}"
                                                      Visibility="{Binding CanBeAuto, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="ほかの色と背景の明暗から自動で決めます" />
                                        </Grid>
                                        <TextBox DockPanel.Dock="Right" Width="78" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center" />
                                        <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource FgDim}"
                                                       FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                                   FontSize="{DynamicResource Fs11}"
                                   Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVis}}"
                                   Text="このテーマには ui / ansi の直接指定があります。この画面では触らずにそのまま残します（変えるときは「JSON を開く」）。" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 右：プレビュー（自分の Resources に派生した色を持ち、中は DynamicResource で塗る） ===== -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="16,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="プレビュー" Style="{StaticResource PaneTitle}" />

                    <!-- 読みやすさの注意 -->
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                            Background="{DynamicResource BgAlt}">
                        <StackPanel>
                            <TextBlock Text="読みやすさ" Style="{StaticResource PaneTitle}" />
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="✓ 気になるところはありません" Foreground="{DynamicResource Success}"
                                       Visibility="{Binding Warnings.Count, Converter={StaticResource EmptyCountToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PreviewRoot" CornerRadius="6" ClipToBounds="True" BorderThickness="1"
                            BorderBrush="{DynamicResource Border}" Background="{DynamicResource Bg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="170" />
                            </Grid.RowDefinitions>

                            <!-- アクティビティバー -->
                            <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource ActivityBarBg}">
                                <StackPanel Margin="0,8,0,0">
                                    <Border Height="30" BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0">
                                        <TextBlock Text="📁" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                                    </Border>
                                    <TextBlock Text="🔍" HorizontalAlignment="Center" Margin="0,8" Foreground="{DynamicResource FgDim}" Opacity="0.7" />
                                    <TextBlock Text="⎇" HorizontalAlignment="Center" Margin="0,4" Foreground="{DynamicResource FgDim}" FontSize="16" />
                                    <TextBlock Text="🎨" HorizontalAlignment="Center" Margin="0,8" Foreground="{DynamicResource FgDim}" Opacity="0.7" />
                                </StackPanel>
                            </Border>

                            <!-- サイドバー（ツリー） -->
                            <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBg}" Padding="10,6">
                                        <TextBlock Text="エクスプローラー" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="{DynamicResource Fs12}" />
                                    </Border>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="▾ src" Margin="10,2" Foreground="{DynamicResource Fg}" />
                                        <TextBlock Text="    App.cs" Margin="10,2" Foreground="{DynamicResource Fg}" />
                                        <Border Background="{DynamicResource SelectionBg}">
                                            <TextBlock Text="    Theme.cs" Margin="10,2" Foreground="{DynamicResource Fg}" />
                                        </Border>
                                        <TextBlock Margin="10,2" Foreground="{DynamicResource Fg}">
                                            <Run Text="    Ro" /><Run Text="om" Background="{DynamicResource SearchHighlight}" /><Run Text=".cs" />
                                        </TextBlock>
                                        <TextBlock Text="    README.md" Margin="10,2" Foreground="{DynamicResource FgDim}" />
                                        <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                                            <TextBlock Text="● 成功" Foreground="{DynamicResource Success}" Margin="0,0,10,0" />
                                            <TextBlock Text="● 失敗" Foreground="{DynamicResource Error}" />
                                        </StackPanel>
                                        <Button Content="コミット" Style="{StaticResource FlatButton}" Margin="10,12,10,0" />
                                        <StackPanel Margin="10,12,10,0">
                                            <TextBlock Text="構造" Style="{StaticResource PvLabel}" Margin="0,0,0,2" />
                                            <TextBlock><Run Text="◆ " Foreground="{DynamicResource SymType}" /><Run Text="ThemeManager" Foreground="{DynamicResource Fg}" /></TextBlock>
                                            <TextBlock><Run Text="  ƒ " Foreground="{DynamicResource SymMethod}" /><Run Text="Apply" Foreground="{DynamicResource Fg}" /></TextBlock>
                                            <TextBlock><Run Text="  ▪ " Foreground="{DynamicResource SymProperty}" /><Run Text="IsLightActive" Foreground="{DynamicResource Fg}" /></TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- エディタ -->
                            <DockPanel Grid.Column="2" Grid.Row="0" Background="{DynamicResource PvEditorBg}">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBg}" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Theme.cs" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                        <TextBlock Text="  Room.cs" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs12}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="10,8" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource PvEditorFg}" LineHeight="19">
                                    <Run Foreground="{DynamicResource PvComment}" Text="1  // 部屋の色を決める" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvComment}" Text="2  " /><Run Foreground="{DynamicResource PvKeyword}" Text="public sealed class " /><Run Foreground="{DynamicResource PvType}" Text="Theme" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvComment}" Text="3  " /><Run Text="{}{" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvComment}" Text="4      " /><Run Foreground="{DynamicResource PvKeyword}" Text="private const " /><Run Foreground="{DynamicResource PvType}" Text="int " /><Run Text="Depth = " /><Run Foreground="{DynamicResource PvNumber}" Text="42" /><Run Text=";" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvComment}" Text="5      " /><Run Foreground="{DynamicResource PvKeyword}" Text="public " /><Run Foreground="{DynamicResource PvType}" Text="string " /><Run Foreground="{DynamicResource PvFunction}" Text="Greet" /><Run Text="(" /><Run Foreground="{DynamicResource PvType}" Text="string " /><Run Text="name)" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvComment}" Text="6          =&gt; " /><Run Foreground="{DynamicResource PvString}" Text="$&quot;ようこそ、{name}&quot;" /><Run Text=";" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvComment}" Text="7  " /><Run Text="}" />
                                </TextBlock>
                            </DockPanel>

                            <!-- ターミナル -->
                            <DockPanel Grid.Column="2" Grid.Row="1" Background="{DynamicResource PvTermBg}">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBg}" Padding="10,4"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="ターミナル" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                </Border>
                                <ItemsControl DockPanel.Dock="Bottom" x:Name="AnsiRow" Margin="10,0,10,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="2" Columns="8" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="12" Margin="1" CornerRadius="2" Background="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="10,6" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource PvTermFg}" LineHeight="18">
                                    <Run Foreground="{DynamicResource PvAnsi2}" Text="PS" /><Run Foreground="{DynamicResource PvAnsi4}" Text=" C:\Projects\Loomo" /><Run Text="&gt; dotnet test" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvAnsi2}" Text="  成功 " /><Run Text="5373 件" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvAnsi3}" Text="  警告 " /><Run Text="CS0618: 古い API" /><LineBreak />
                                    <Run Foreground="{DynamicResource PvAnsi1}" Text="  失敗 " /><Run Foreground="{DynamicResource PvAnsi8}" Text="(なし)" />
                                </TextBlock>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
