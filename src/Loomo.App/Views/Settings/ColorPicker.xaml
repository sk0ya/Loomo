<UserControl x:Class="sk0ya.Loomo.App.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="264">
    <!-- 彩度×明度の面＋色相の帯＋16 進の入力＋「テーマの色から選ぶ」。どこを動かしても Color へ即時に返す。 -->
    <StackPanel>
        <Grid Height="168" Cursor="Cross" ClipToBounds="True">
            <Grid x:Name="SvArea" Background="Transparent"
                  MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnSvUp">
                <Rectangle x:Name="HueFill" Fill="Red" RadiusX="4" RadiusY="4" />
                <Rectangle RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvHandle" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Grid>

        <Grid Height="16" Margin="0,8,0,0" Cursor="Hand">
            <Grid x:Name="HueArea" Background="Transparent"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp">
                <Rectangle RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.000" Color="#FF0000" />
                            <GradientStop Offset="0.167" Color="#FFFF00" />
                            <GradientStop Offset="0.333" Color="#00FF00" />
                            <GradientStop Offset="0.500" Color="#00FFFF" />
                            <GradientStop Offset="0.667" Color="#0000FF" />
                            <GradientStop Offset="0.833" Color="#FF00FF" />
                            <GradientStop Offset="1.000" Color="#FF0000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueHandle" Width="6" Height="20" Canvas.Top="-2" CornerRadius="2"
                            BorderBrush="White" BorderThickness="2" />
                </Canvas>
            </Grid>
        </Grid>

        <DockPanel Margin="0,10,0,0">
            <Border x:Name="Preview" Width="36" Height="26" CornerRadius="4" DockPanel.Dock="Left"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" />
            <TextBlock x:Name="HsvText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                       FontFamily="Cascadia Mono, Consolas" />
            <TextBox x:Name="HexBox" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas" KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
        </DockPanel>

        <!-- テーマのほかの色をそのまま使う（同じ色を揃えたいとき） -->
        <TextBlock Text="テーマの色から" Margin="0,10,0,4" Foreground="{DynamicResource FgDim}"
                   FontSize="{DynamicResource Fs11}" />
        <ItemsControl x:Name="PaletteList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="22" Height="22" Margin="0,0,4,4" Cursor="Hand" ToolTip="{Binding Label}"
                            Click="OnPaletteClick" Tag="{Binding Color}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource Border}" Background="{Binding Brush}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Fg}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
