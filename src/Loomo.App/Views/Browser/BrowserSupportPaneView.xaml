<UserControl x:Class="sk0ya.Loomo.App.Views.BrowserSupportPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    Background="{DynamicResource Panel}" Focusable="True">

    <!-- 見え方の約束（§41）：線で区切らず余白で区切る。字の大きさは3段（題 Fs14／中身 Fs12〜13／添え書き Fs11）、
         色は Fg と FgDim の2つだけで、アクセント色は「押すと部屋のどこかが動く」印（道具の › と押せる行の縁）にだけ使う。 -->
    <UserControl.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 節の見出し：小さく太く・薄い色。中身より先に目に入らない。 -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 道具の行：カード状の押せる面（素の ItemsControl の行は押せないのでボタンにする）。触れると面が浮き、› がアクセント色になる。 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" Padding="9,6,6,6">
                            <DockPanel LastChildFill="True">
                                <Path x:Name="chevron" DockPanel.Dock="Right" Width="7" Height="11" Margin="8,0,2,0"
                                      VerticalAlignment="Center" Stretch="Uniform" Data="M1,1 L6,6 L1,11"
                                      Stroke="{DynamicResource FgDim}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.6" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="chevron" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行のボタン：細い縁だけの小さなチップ。どの面（ペインの地・強調の面）の上でも同じに見え、並んでも重くならない。 -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 見出しの右のボタン（ワークツリーを作る 等）：面を持たない文字だけのボタン。節の行を全部に効かせる操作なので、アクセント色。 -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:BrowserSupportButton}">
            <Button Style="{StaticResource ChipButton}" Content="{Binding Label}" ToolTip="{Binding Tip}" Command="{Binding Command}" />
        </DataTemplate>

        <!-- 節の1行。場所（Look=Path）は等幅の1行で、はみ出しは省略してツールチップに。 -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:BrowserSupportRow}">
            <StackPanel Margin="12,0,10,8">
                <DockPanel LastChildFill="True">
                    <!-- ボタン1つなら行の右に -->
                    <!-- 器の Visibility は行に束縛する（ContentPresenter 自身の DataContext は中身のボタンになる） -->
                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top"
                            Visibility="{Binding ButtonInline, Converter={StaticResource BoolToVis}}">
                        <ContentPresenter Content="{Binding InlineButton}" ContentTemplate="{StaticResource ChipTemplate}" />
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="0,2,0,0"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False" Margin="0,6,0,-4"
                              ItemTemplate="{StaticResource ChipTemplate}"
                              Visibility="{Binding ButtonsBelow, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Look}" Value="{x:Static vm:BrowserSupportRowLook.Path}">
                    <Setter TargetName="RowTitle" Property="FontFamily" Value="{StaticResource MonoFont}" />
                    <Setter TargetName="RowTitle" Property="TextWrapping" Value="NoWrap" />
                    <Setter TargetName="RowTitle" Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter TargetName="RowTitle" Property="ToolTip" Value="{Binding Title}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 節。並びの前の方（調べ始めた場所・PR の指摘）は道具より上に出る（BrowserSupportPaneView.xaml.cs）。 -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:BrowserSupportSection}">
            <Border x:Name="Card" Margin="0,6,0,4" Padding="0,0,0,0">
                <StackPanel>
                    <DockPanel Margin="12,0,10,6" LastChildFill="True" MinHeight="22">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Buttons}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BrowserSupportButton}">
                                    <Button Style="{StaticResource HeaderButton}" Content="{Binding Label}" ToolTip="{Binding Tip}" Command="{Binding Command}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SectionTitle" Style="{StaticResource Caption}" Text="{Binding Title}" />
                            <Border Margin="6,0,0,0" Padding="6,0" CornerRadius="7" Background="{DynamicResource BgAlt}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Count}" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource FgDim}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="12,0,10,8" Style="{StaticResource Dim}" Text="{Binding Note}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- 調べ始めた場所：このタブが何のために開かれたか。名札のすぐ下に、アクセントの縁の付いた面で。 -->
                <DataTrigger Binding="{Binding Emphasis}" Value="True">
                    <Setter TargetName="Card" Property="Margin" Value="8,0,8,8" />
                    <Setter TargetName="Card" Property="Padding" Value="0,8,0,0" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource BgAlt}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="3,0,0,0" />
                    <Setter TargetName="Card" Property="CornerRadius" Value="4" />
                    <Setter TargetName="SectionTitle" Property="Foreground" Value="{DynamicResource Fg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <!-- 知らないページ：一言と、どのページで何が出るかの案内 -->
            <StackPanel Margin="12,14,12,12" Visibility="{Binding HasPage, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{Binding EmptyText}" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,12" Style="{StaticResource Dim}"
                           Text="ブラウザで次のページを開くと、ページを部屋へつなぐ道具がここに出ます。" />
                <ItemsControl ItemsSource="{Binding Guide}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserSupportGuideItem}">
                            <Border Margin="0,0,0,8" BorderBrush="{DynamicResource Border}" BorderThickness="2,0,0,0" Padding="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Site}" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                <!-- ページの名札：サイト → 題 → 添え書き → 手元のクローン（押した道具の結果もここ） -->
                <StackPanel Margin="12,12,12,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentHover}" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Site}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Text="{Binding Heading}"
                               Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Dim}" Text="{Binding Detail}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                    <Border Margin="0,8,0,0" Background="{DynamicResource BgAlt}" CornerRadius="4" Padding="8,5"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding Status}" />
                    </Border>
                </StackPanel>

                <!-- 先に出す節：調べ始めた場所（このタブが何のためか）・PR の未解決の指摘（このページで一番知りたいこと） -->
                <ItemsControl x:Name="LeadSectionsList" Focusable="False" ItemTemplate="{StaticResource SectionTemplate}" />

                <!-- 道具：ページ1つにつき決まったボタン -->
                <ItemsControl Margin="4,0,4,6" ItemsSource="{Binding Actions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding RunCommand}" ToolTip="{Binding Detail}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Fs13}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 節：ページから読み出した、数の決まっていない行（CI のエラー・使っている場所・ポート） -->
                <ItemsControl x:Name="TrailSectionsList" Focusable="False" ItemTemplate="{StaticResource SectionTemplate}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
