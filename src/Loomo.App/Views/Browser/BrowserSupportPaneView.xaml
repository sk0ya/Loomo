<UserControl x:Class="sk0ya.Loomo.App.Views.BrowserSupportPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 道具の行：背景なしのボタン（押せる形にしておく。素の ItemsControl の行は押せない）。 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <!-- 知らないページ -->
            <TextBlock Margin="10" Style="{StaticResource Dim}" Text="{Binding EmptyText}"
                       Visibility="{Binding HasPage, Converter={StaticResource InverseBoolToVis}}" />

            <StackPanel Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                <TextBlock Margin="10,10,10,0" Style="{StaticResource Dim}" FontWeight="SemiBold" Text="{Binding Site}" />
                <TextBlock Margin="10,2,10,0" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Text="{Binding Heading}"
                           Visibility="{Binding HasHeading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="10,2,10,0" Style="{StaticResource Dim}" Text="{Binding Detail}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="10,6,10,0" Style="{StaticResource Dim}" Text="{Binding Status}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                <Border Height="1" Margin="0,6,0,0" Background="{DynamicResource Border}" />
                <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding RunCommand}" ToolTip="{Binding Detail}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Fs13}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 節：ページから読み出した、数の決まっていない行（CI のエラー・使っている場所・コード・抜き書き） -->
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0">
                                <DockPanel Margin="10,0,10,2" LastChildFill="True">
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Buttons}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SmallButton}" Content="{Binding Label}" ToolTip="{Binding Tip}" Command="{Binding Command}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Dim}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Margin="10,0,10,2" Style="{StaticResource Dim}" Text="{Binding Note}"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="0,1,0,0"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                                    <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False" Margin="0,3,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,2" Content="{Binding Label}"
                                                                        ToolTip="{Binding Tip}" Command="{Binding Command}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Mono}" Value="True">
                                                    <Setter TargetName="RowTitle" Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
