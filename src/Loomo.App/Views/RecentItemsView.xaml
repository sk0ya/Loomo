<UserControl x:Class="sk0ya.Loomo.App.Views.RecentItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource BgAlt}">
    <UserControl.Resources>
        <Style x:Key="RecentButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="background" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="background" Property="Background" Value="{DynamicResource Bg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="background" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RecentItemTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Expander Header="最近使ったファイル" IsExpanded="True" Margin="4,2,4,0"
                      Foreground="{DynamicResource FgDim}">
                <ItemsControl ItemsSource="{Binding RecentFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RecentButton}" Click="OnItemClick"
                                    ToolTip="{Binding FullPath}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RecentItemTemplate}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <Expander Header="よく使うフォルダー" IsExpanded="True" Margin="4,0,4,2"
                      Foreground="{DynamicResource FgDim}">
                <ItemsControl ItemsSource="{Binding FrequentFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RecentButton}" Click="OnItemClick"
                                    ToolTip="{Binding FullPath}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RecentItemTemplate}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
