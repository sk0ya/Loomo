<UserControl x:Class="sk0ya.Loomo.App.Views.WorkItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:WorkItemsViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 1行＝押せるボタン（素の ItemsControl の行は UIA に出ず、押せる要素が無いと実機で押せない）。 -->
        <Style x:Key="WorkItemRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 見出し：組織名・件数と、更新／組織の切替。 -->
        <DockPanel DockPanel.Dock="Top" Margin="6,2,2,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⟳"
                    ToolTip="取り直す" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="WorkItemsRefreshButton"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⚙"
                    ToolTip="組織を切り替える" Command="{Binding EditOrganizationCommand}"
                    AutomationProperties.AutomationId="WorkItemsOrganizationButton" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource Fg}">
                    <Run Text="自分の Work Items" FontWeight="SemiBold" />
                    <Run Text="{Binding OrganizationName, Mode=OneWay}" Foreground="{DynamicResource FgDim}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource FgDim}"
                           Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVis}}" />
            </StackPanel>
        </DockPanel>

        <!-- 組織の入力（リモートから見つからないとき・切り替えたいとき）。 -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6"
                   Visibility="{Binding IsOrganizationEditorVisible, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="保存" Margin="4,0,0,0"
                    Command="{Binding SaveOrganizationCommand}" />
            <TextBox Text="{Binding OrganizationInput, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{DynamicResource Fs12}" VerticalContentAlignment="Center"
                     ToolTip="組織名、または https://dev.azure.com/{組織}。空で保存するとワークスペースの git リモートから見つける"
                     AutomationProperties.AutomationId="WorkItemsOrganizationBox" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="6,0,6,6"
                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource Error}"
                   Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVis}}" />

        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WorkItemRowViewModel}">
                        <Button Style="{StaticResource WorkItemRowButton}" ToolTip="{Binding ToolTip}"
                                Opacity="{Binding Opacity}"
                                Command="{Binding DataContext.OpenCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                            <DockPanel Margin="{Binding Indent}">
                                <Border DockPanel.Dock="Left" Width="3" Margin="0,1,6,1" CornerRadius="1"
                                        Background="{Binding TypeColor}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Margin="8,0,0,0"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Width="44" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                           Text="{Binding TypeShort}" TextTrimming="CharacterEllipsis" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding IdText}" Margin="0,0,6,0"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Fs12}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
