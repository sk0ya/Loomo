<Window x:Class="sk0ya.Loomo.App.Views.ChangeSignatureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Loomo - シグネチャの変更"
    Width="720" Height="480"
    MinWidth="560" MinHeight="360"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CurrentSignatureText" Grid.Row="0"
                   Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                   FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="戻り値の型" VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs13}"
                       Margin="0,0,8,0" />
            <TextBox x:Name="ReturnTypeBox" Width="220" FontFamily="Cascadia Mono, Consolas"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="↑ 上へ" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}" Margin="0,0,6,0" Click="OnMoveUp" />
            <Button Content="↓ 下へ" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}" Margin="0,0,6,0" Click="OnMoveDown" />
            <Button Content="＋ 追加" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}" Margin="0,0,6,0" Click="OnAdd" />
            <Button Content="－ 削除" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}" Click="OnRemove" />
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="6,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="修飾子" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" />
                    <TextBlock Grid.Column="1" Text="型" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" />
                    <TextBlock Grid.Column="2" Text="名前" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" />
                    <TextBlock Grid.Column="3" Text="既定値" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" />
                    <TextBlock Grid.Column="4" Text="呼び出し側の値" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                               ToolTip="追加したパラメーターに、既存の呼び出し元へ書き込む式。既定値があるなら空でも構いません。" />
                </Grid>
                <ListBox x:Name="ParameterList" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Modifiers, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas" Margin="0,0,4,0" />
                                <TextBox Grid.Column="1" Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas" Margin="0,0,4,0" />
                                <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas" Margin="0,0,4,0" />
                                <TextBox Grid.Column="3" Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas" Margin="0,0,4,0" />
                                <TextBox Grid.Column="4" Text="{Binding CallSiteArgument, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas"
                                         IsEnabled="{Binding IsNew}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="4"
                   Foreground="#FFE4676B"
                   FontSize="{DynamicResource Fs11}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Style="{StaticResource FlatButton}"
                    IsDefault="True"
                    MinWidth="76"
                    Click="OnOk" />
            <Button Content="キャンセル"
                    Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}"
                    IsCancel="True"
                    MinWidth="92"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
