<Window x:Class="sk0ya.Loomo.App.Views.ComparePointsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="2点を比較"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    Foreground="{DynamicResource Fg}"
    FontFamily="Segoe UI"
    FontSize="{DynamicResource Fs13}">
    <!-- 任意の2点（ブランチ・タグ・ハッシュ・ワークツリーの作業中の状態）の差分を開く。
         右がいま開いているワークツリーなら比較基準として開く（右側をその場で編集できる）。 -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="左（元）" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox x:Name="FromBox" Grid.Row="0" Grid.Column="1" MinHeight="26" IsEditable="True"
                  VerticalContentAlignment="Center" Margin="0,0,0,8"
                  DisplayMemberPath="Label" TextSearch.TextPath="Label"
                  ToolTip="ブランチ・タグ・ハッシュ、またはワークツリー（作業中の状態）" />

        <!-- 左右の入れ替え。2行ぶんの高さにまたがって置く。 -->
        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="⇅" ToolTip="左右を入れ替える"
                Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
                Margin="8,0,0,8" MinWidth="32" Click="OnSwap" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="右（先）" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" MinHeight="26" IsEditable="True"
                  VerticalContentAlignment="Center" Margin="0,0,0,8"
                  DisplayMemberPath="Label" TextSearch.TextPath="Label"
                  ToolTip="ブランチ・タグ・ハッシュ、またはワークツリー（作業中の状態）" />

        <!-- 「分かれてから入れた変更だけ」はここでは扱わない（ワークツリーの「ブランチ元から入れた変更」と
             ブランチの「分岐点と比較」が受け持つ）。ここは素直な「左と右の差」だけ。 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap"
                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                   Text="左と右の中身の差をそのまま比べます。ワークツリーは未コミットの編集と新しいファイルも含めます。右がいま開いているワークツリーなら、差分の右側をその場で編集できます。&#x0a;自分が入れた変更だけを見たいときは、ワークツリーの右クリック「ブランチ元から入れた変更」を使ってください。" />

        <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                   Foreground="#FFE4676B" FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="比較" Style="{StaticResource FlatButton}" IsDefault="True" MinWidth="76" Click="OnOk" />
            <Button Content="キャンセル" Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
                    IsCancel="True" MinWidth="92" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
