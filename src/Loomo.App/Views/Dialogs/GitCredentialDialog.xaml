<Window x:Class="sk0ya.Loomo.App.Views.GitCredentialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="git の資格情報"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- どの操作の問いか（git push など）。 -->
        <TextBlock x:Name="LeadText" Grid.Row="0"
                   Foreground="{DynamicResource Fg}"
                   FontSize="{DynamicResource Fs13}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- git・ssh の問いの文面そのまま（言い換えると、どの鍵・どの接続先かが分からなくなる）。 -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Background="{DynamicResource BgAlt}"
                Padding="8,6" Margin="0,0,0,10">
            <TextBox x:Name="PromptText"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource Fg}"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="{DynamicResource Fs12}"
                     TextWrapping="Wrap" />
        </Border>

        <TextBox x:Name="InputBox" Grid.Row="2"
                 FontSize="{DynamicResource Fs13}" />

        <PasswordBox x:Name="PasswordInput" Grid.Row="2"
                     FontSize="{DynamicResource Fs13}"
                     Visibility="Collapsed" />

        <!-- 次から聞かれないようにする（§24.101）。覚えさせ方が読めて、この PC で使えるときだけ出す。既定はオフ
             ——git 全体の設定を変える（SSH は管理者の確認も出る）ので、人が選んだときだけ。 -->
        <CheckBox x:Name="RememberBox" Grid.Row="3"
                  Visibility="Collapsed"
                  Margin="0,10,0,0"
                  Foreground="{DynamicResource Fg}">
            <TextBlock x:Name="RememberText"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Fs12}" />
        </CheckBox>

        <TextBlock x:Name="NoteText" Grid.Row="4"
                   Foreground="{DynamicResource FgDim}"
                   FontSize="{DynamicResource Fs11}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="答えは git に渡すだけで、Loomo には残しません。毎回聞かれたくないときは Git Credential Manager か ssh-agent に覚えさせてください。" />

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK"
                    Style="{StaticResource FlatButton}"
                    IsDefault="True"
                    MinWidth="76"
                    Click="OnOk" />
            <Button x:Name="NoButton" Content="いいえ"
                    Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}"
                    MinWidth="76"
                    Margin="8,0,0,0"
                    Visibility="Collapsed"
                    Click="OnNo" />
            <Button x:Name="CancelButton" Content="取り消す"
                    Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}"
                    IsCancel="True"
                    MinWidth="92"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
