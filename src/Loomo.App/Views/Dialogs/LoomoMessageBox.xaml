<Window x:Class="sk0ya.Loomo.App.Views.LoomoMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loomo"
        MinWidth="380" MaxWidth="560"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 設定窓と同じ自前キャプション。Windows 既定の枠を出さず、部屋の中の一枚として見せる。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource ActivityBarBg}">
            <TextBlock x:Name="CaptionText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs12}"
                       TextTrimming="CharacterEllipsis" />
            <Button Style="{DynamicResource CaptionCloseButton}" HorizontalAlignment="Right" Height="Auto"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="閉じる（Esc）" Click="OnCloseClicked">
                <Path Stretch="None" StrokeThickness="1" SnapsToDevicePixels="True"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M0,0 L10,10 M0,10 L10,0" />
            </Button>
        </Grid>

        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 種類のしるし：色の淡い円の上に記号。色だけに頼らず、記号の形でも種類が分かる。 -->
            <Grid x:Name="IconHost" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,16,0">
                <Ellipse x:Name="IconDisc" Opacity="0.18" />
                <TextBlock x:Name="IconGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fs15}" />
            </Grid>

            <ScrollViewer Grid.Column="1" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,6,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="460"
                           FontSize="{DynamicResource Fs14}" LineHeight="21"
                           Foreground="{DynamicResource Fg}" />
            </ScrollViewer>

            <!-- ボタンは右寄せ。主の操作（OK／はい）が右端、従の操作（キャンセル／いいえ）がその左。 -->
            <StackPanel x:Name="ButtonRow" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0" />
        </Grid>
    </DockPanel>
</Window>
