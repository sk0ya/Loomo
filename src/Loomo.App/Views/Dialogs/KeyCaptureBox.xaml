<UserControl x:Class="sk0ya.Loomo.App.Views.KeyCaptureBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}"
    PreviewKeyDown="OnKey"
    LostKeyboardFocus="OnLostFocus">
    <UserControl.Resources>
        <!-- 枠：ホバー／フォーカス／キャプチャ中で見た目を変え、「ここを押せば録れる」を伝える。 -->
        <Style x:Key="CaptureBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                </Trigger>
                <DataTrigger Value="True"
                             Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <!-- キャプチャ中：下地も変えて「入力待ち」だと分かるように。 -->
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 現在のジェスチャ。未割当は淡い斜体（割り当て済みと一目で区別する）。 -->
        <Style x:Key="GestureText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Box" MinWidth="164" Style="{StaticResource CaptureBorder}"
            MouseLeftButtonDown="OnStart"
            ToolTip="クリック（または Enter）してから、割り当てたいキーを押します。連鎖は続けて 2 打。Esc で取消。">
        <Grid>
            <!-- 通常表示：現在のジェスチャ -->
            <TextBlock x:Name="Display" Style="{StaticResource GestureText}"
                       Text="{Binding GestureText}" />
            <!-- キャプチャ中：押されたキーを逐次見せる（連鎖の 1 打目が入ったことが分かる） -->
            <TextBlock x:Name="Prompt" VerticalAlignment="Center" Visibility="Collapsed"
                       Text="キーを押す…"
                       FontFamily="Cascadia Mono, Consolas"
                       Foreground="{DynamicResource Accent}" />
        </Grid>
    </Border>
</UserControl>
