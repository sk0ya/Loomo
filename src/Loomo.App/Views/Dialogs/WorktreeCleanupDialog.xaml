<Window x:Class="sk0ya.Loomo.App.Views.WorktreeCleanupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ワークツリーの片付け"
    Width="760" Height="460" MinWidth="560" MinHeight="300"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    Foreground="{DynamicResource Fg}"
    FontFamily="Segoe UI"
    FontSize="{DynamicResource Fs13}">
    <!-- 使われていないワークツリーを大きさつきで並べ、選んでまとめて消す（§24.55）。
         消すとそのワークツリーの部屋（ワークスペース）と常駐のシェルも片付く。ブランチは残す。 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="CleanupVisibility" />
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Margin="0,0,0,10"
                   Text="既定ブランチへ取り込み済み・14日以上触っていない・フォルダーが消えたものを候補に出します。消すとフォルダーとそのワークツリーの部屋が片付きます（ブランチは残ります）。" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="未コミットの変更があるものも消す（復元できません）"
                      IsChecked="{Binding DiscardChanges}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="閉じる" IsCancel="True" MinWidth="80" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" Padding="12,5" />
            <Button DockPanel.Dock="Right" Content="選んだものを削除" MinWidth="120" Click="OnRemove"
                    IsEnabled="{Binding CanRemove}" Style="{StaticResource SecondaryButton}" Padding="12,5" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="候補だけ表示" IsChecked="{Binding CandidatesOnly}"
                      Foreground="{DynamicResource Fg}" />
            <TextBlock DockPanel.Dock="Right" Text="大きさを数えています…" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs11}"
                       Visibility="{Binding IsMeasuring, Converter={StaticResource CleanupVisibility}}" />
        </DockPanel>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource BgAlt}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,4" TextElement.Foreground="{DynamicResource FgDim}"
                      TextElement.FontSize="{DynamicResource Fs11}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="ワークツリー" />
                    <TextBlock Grid.Column="2" Text="大きさ" TextAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="3" Text="最後に触った" />
                    <TextBlock Grid.Column="4" Text="変更" />
                    <TextBlock Grid.Column="5" Text="理由" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding View}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,3" ToolTip="{Binding Worktree.Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanClean}"
                                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Worktree.Path}" Foreground="{DynamicResource FgDim}"
                                                   FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right"
                                               Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="3" Text="{Binding LastActivityText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ChangesText}" Foreground="#FFE5A23B"
                                               VerticalAlignment="Center" ToolTip="未コミットの変更（未追跡を含む）" />
                                    <TextBlock Grid.Column="5" Text="{Binding ReasonText}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                                               ToolTip="{Binding ReasonText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
