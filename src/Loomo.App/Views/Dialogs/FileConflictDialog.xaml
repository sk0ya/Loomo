<Window x:Class="sk0ya.Loomo.App.Views.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ファイルの競合"
        Width="510"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="同じ名前の項目が既に存在します。どうしますか？"
                   Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs13}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" x:Name="ConflictText"
                   Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="名前を変えて保存する場合の名前" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs11}" />
            <TextBox x:Name="NameBox" Margin="0,4,0,0" Padding="6,4"
                     FontSize="{DynamicResource Fs13}" />
        </StackPanel>
        <CheckBox Grid.Row="3" x:Name="ApplyAllBox" Content="以降の競合にも同じ操作を適用"
                  Foreground="{DynamicResource Fg}" Margin="0,14,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="上書き" Style="{StaticResource FlatButton}" MinWidth="78" Click="OnOverwrite" />
            <Button Content="スキップ" Style="{StaticResource FlatButton}" MinWidth="78" Margin="8,0,0,0" Click="OnSkip" />
            <Button Content="名前を変更" Style="{StaticResource FlatButton}" MinWidth="92" Margin="8,0,0,0" Click="OnRename" />
            <Button Content="キャンセル" Style="{StaticResource FlatButton}" Background="{DynamicResource BgAlt}"
                    Foreground="{DynamicResource Fg}" MinWidth="88" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
