<Window x:Class="sk0ya.Loomo.App.Views.BranchCleanupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ブランチの片付け"
    Width="760" Height="460" MinWidth="560" MinHeight="300"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    Foreground="{DynamicResource Fg}"
    FontFamily="Segoe UI"
    FontSize="{DynamicResource Fs13}">
    <!-- 終わったローカルブランチを理由つきで並べ、選んでまとめて消す（§24.69）。リモートのブランチには触らない。 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="CleanupVisibility" />
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Margin="0,0,0,10"
                   Text="既定ブランチへ取り込み済み・上流が消えた（PR のマージでリモートのブランチが消されたもの）・30日以上動いていないローカルブランチを候補に出します。理由の上にマウスを置くと、何を見てそう判断したかが出ます。リモートのブランチは消しません。" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="取り込まれていないものも消す（-D・コミットが失われることがあります）"
                      IsChecked="{Binding ForceUnmerged}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="閉じる" IsCancel="True" MinWidth="80" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" Padding="12,5" />
            <Button DockPanel.Dock="Right" Content="選んだものを削除" MinWidth="120" Click="OnRemove"
                    IsEnabled="{Binding CanRemove}" Style="{StaticResource SecondaryButton}" Padding="12,5" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="候補だけ表示" IsChecked="{Binding CandidatesOnly}"
                      Foreground="{DynamicResource Fg}" />
            <TextBlock DockPanel.Dock="Right" Text="取り込み済みかを調べています…" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs11}"
                       Visibility="{Binding IsInspecting, Converter={StaticResource CleanupVisibility}}" />
        </DockPanel>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource BgAlt}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,4" TextElement.Foreground="{DynamicResource FgDim}"
                      TextElement.FontSize="{DynamicResource Fs11}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="ブランチ" />
                    <TextBlock Grid.Column="2" Text="最後のコミット" />
                    <TextBlock Grid.Column="3" Text="未送信" />
                    <TextBlock Grid.Column="4" Text="PR" />
                    <TextBlock Grid.Column="5" Text="理由" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding View}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanClean}"
                                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Branch.Upstream}" Foreground="{DynamicResource FgDim}"
                                                   FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LastCommitText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding AheadText}" Foreground="#FFE5A23B"
                                               VerticalAlignment="Center" ToolTip="上流へまだ送っていないコミット" />
                                    <TextBlock Grid.Column="4" Text="{Binding PullRequestText}" VerticalAlignment="Center"
                                               ToolTip="オープンな PR がある（最初の印は付けません）" />
                                    <TextBlock Grid.Column="5" Text="{Binding ReasonText}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                                               ToolTip="{Binding ReasonDetail}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
