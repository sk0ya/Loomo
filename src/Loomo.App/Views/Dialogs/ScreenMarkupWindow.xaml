<Window x:Class="sk0ya.Loomo.App.Views.ScreenMarkupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画面に印を付けて Claude Code へ渡す"
        MinWidth="480" MinHeight="320"
        ResizeMode="CanResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 設定窓・LoomoMessageBox と同じ自前キャプション。画像を大きく見たいことがあるので、縁で大きさを変えられる。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource ActivityBarBg}">
            <TextBlock Text="画面に印を付けて Claude Code へ渡す" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs12}"
                       TextTrimming="CharacterEllipsis" />
            <Button Style="{DynamicResource CaptionCloseButton}" HorizontalAlignment="Right" Height="Auto"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="やめる（Esc）" Click="OnCancelClicked">
                <Path Stretch="None" StrokeThickness="1" SnapsToDevicePixels="True"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M0,0 L10,10 M0,10 L10,0" />
            </Button>
        </Grid>

        <!-- 道具の帯：左に印の種類と取り消し、右に終わり方（やめる／渡す）。 -->
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Style="{DynamicResource SecondaryButton}" Content="やめる"
                        MinWidth="80" Margin="0,0,8,0" ToolTip="何も渡さずに閉じる（Esc）" Click="OnCancelClicked" />
                <Button x:Name="SendButton" Style="{DynamicResource FlatButton}" Content="Claude Code へ渡す"
                        MinWidth="120" ToolTip="印を付けた画像を一時ファイルにして、@参照 を Claude Code のプロンプトへ入れる（送信はしない・Ctrl+Enter）"
                        Click="OnSendClicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RectTool" Style="{StaticResource SourceToggle}" Content="囲む" GroupName="MarkupTool"
                                     IsChecked="True" ToolTip="ドラッグで枠を描く（1）" />
                        <RadioButton x:Name="ArrowTool" Style="{StaticResource SourceToggle}" Content="矢印" GroupName="MarkupTool"
                                     ToolTip="ドラッグした向きに矢印を引く（2）" />
                        <RadioButton x:Name="TextTool" Style="{StaticResource SourceToggle}" Content="文字" GroupName="MarkupTool"
                                     ToolTip="押した所に短い文字を書く。Enter で決める（3）" />
                    </StackPanel>
                </Border>
                <Button x:Name="UndoButton" Style="{DynamicResource PaneHeaderGhostButton}" Content="取り消し"
                        Margin="8,0,0,0" IsEnabled="False" ToolTip="最後に付けた印を消す（Ctrl+Z）" Click="OnUndoClicked" />
                <TextBlock x:Name="HintText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                           TextTrimming="CharacterEllipsis"
                           Text="印は付けなくても渡せます" />
            </StackPanel>
        </DockPanel>

        <!-- 失敗したとき（書けない・Claude が居なくなった）の理由。閉じずにここへ出す。 -->
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Margin="12,0,12,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource Error}" FontSize="{DynamicResource Fs12}" Visibility="Collapsed" />

        <!-- 画面の画像と印。Viewbox で窓に収め、印は画像の画素の座標で持つ（縮めて見ても、渡す画像では正しい位置）。 -->
        <Border Margin="10,0,10,10" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Background="{DynamicResource Bg}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid x:Name="Surface">
                    <Image x:Name="ScreenImage" Stretch="Fill" />
                    <Canvas x:Name="MarkCanvas" Background="Transparent" ClipToBounds="True" Cursor="Cross"
                            MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove"
                            MouseLeftButtonUp="OnCanvasMouseUp" />
                </Grid>
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
