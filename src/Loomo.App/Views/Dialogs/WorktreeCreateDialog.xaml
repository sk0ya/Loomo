<Window x:Class="sk0ya.Loomo.App.Views.WorktreeCreateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ワークツリーを作成"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    Foreground="{DynamicResource Fg}"
    FontFamily="Segoe UI"
    FontSize="{DynamicResource Fs13}">
    <!-- 1つのリポジトリから別ブランチの作業場所をもう1つ作る（git worktree add）。
         置き場所は既定でリポジトリの外（<名前>.worktrees\<ブランチ>）——中に置くとワークスペースへ
         フォルダーとして足せず、ツリーや検索に複製が紛れ込むため（GitWorktreeArgs の説明を参照）。 -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="作り方" VerticalAlignment="Center" Margin="0,0,12,8" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="ModeNew" Content="新しいブランチ" IsChecked="True" Foreground="{DynamicResource Fg}"
                         Checked="OnModeChanged" Margin="0,0,14,0" />
            <RadioButton x:Name="ModeExisting" Content="既存のブランチ" Foreground="{DynamicResource Fg}"
                         Checked="OnModeChanged" Margin="0,0,14,0" />
            <RadioButton x:Name="ModeDetached" Content="コミットを直接（detached）" Foreground="{DynamicResource Fg}"
                         Checked="OnModeChanged" />
        </StackPanel>

        <TextBlock x:Name="BranchLabel" Grid.Row="1" Grid.Column="0" Text="ブランチ名" VerticalAlignment="Center" Margin="0,0,12,8" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
            <TextBox x:Name="NewBranchBox" MinHeight="26" VerticalContentAlignment="Center"
                     TextChanged="OnBranchTextChanged" />
            <ComboBox x:Name="ExistingBranchBox" MinHeight="26" IsEditable="True" Visibility="Collapsed"
                      VerticalContentAlignment="Center"
                      ToolTip="まだどのワークツリーにも置かれていないブランチ（リモートのブランチを選ぶと追跡ブランチを作ります）"
                      SelectionChanged="OnExistingBranchChanged" KeyUp="OnExistingBranchKeyUp" />
        </Grid>

        <TextBlock x:Name="StartLabel" Grid.Row="2" Grid.Column="0" Text="起点" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox x:Name="StartPointBox" Grid.Row="2" Grid.Column="1" MinHeight="26" IsEditable="True" Margin="0,0,0,8"
                  VerticalContentAlignment="Center"
                  ToolTip="ブランチ・タグ・コミットハッシュ（空なら今の HEAD から）" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="置き場所" VerticalAlignment="Center" Margin="0,0,12,8" />
        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="参照…" Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
                    Margin="6,0,0,0" MinWidth="64" Click="OnBrowse" />
            <TextBox x:Name="PathBox" MinHeight="26" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="作成後" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="AfterBox" Grid.Row="4" Grid.Column="1" MinHeight="26" VerticalContentAlignment="Center">
            <ComboBoxItem Content="ワークスペースとして開く（別の部屋で作業する）" Tag="Workspace" />
            <ComboBoxItem Content="今のワークスペースにフォルダーとして追加（並べて見る）" Tag="AddFolder" />
            <ComboBoxItem Content="何もしない" Tag="" />
        </ComboBox>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="#FFE4676B" FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="作成" Style="{StaticResource FlatButton}" IsDefault="True" MinWidth="76" Click="OnOk" />
            <Button Content="キャンセル" Style="{StaticResource FlatButton}"
                    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
                    IsCancel="True" MinWidth="92" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
