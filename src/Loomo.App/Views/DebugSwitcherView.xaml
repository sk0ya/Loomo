<UserControl x:Class="sk0ya.Loomo.App.Views.DebugSwitcherView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels">

    <!-- タイトルバーのデバッグメニューの中身。Rider の実行構成ウィジェットと同じ形で、
         上の固定帯＝「いま選んでいる対象に効く操作」（実行・デバッグ・ビルド・テスト、実行中の操作）、
         下の一覧＝実行ターゲット（1 行＝そのまま実行できる 1 つの対象。構成・起動プロジェクト・
         launchSettings を掛け合わせる3つの並列一覧をやめ、1 本に畳んである＝DebugRunTargetItem）。
         DataContext は DebugViewModel（IDE ペインと同じインスタンス＝どちらで変えても同じ状態）。 -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="4" Padding="4"
            MinWidth="380" MaxWidth="520" Margin="0,2,8,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>

        <DockPanel>
            <!-- ===== 操作帯（選択中の対象に効く）===== -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" CornerRadius="4"
                    Padding="8,6" Margin="0,0,0,4">
                <StackPanel>
                    <!-- アダプタ未導入：押しても何も起きない「デバッグ」を出す前に、理由と導線を見せる。 -->
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding IsAdapterMissing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="デバッグには netcoredbg が必要です（PATH 上に未検出）。実行・ビルド・テストは使えます。"
                                   TextWrapping="Wrap" FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource FgDim}" />
                        <Button Content="インストール" Style="{StaticResource FlatButton}" Height="22" Padding="10,0"
                                Margin="0,4,0,0" HorizontalAlignment="Left"
                                FontSize="{DynamicResource Fs11}"
                                ToolTip="{Binding Launch.AdapterInstallCommand}"
                                Command="{Binding Launch.InstallAdapterCommand}" Click="OnActionClick" />
                    </StackPanel>

                    <!-- 常時：実行・デバッグ・ビルド・テスト（実行中でも 2 本目を始められるので隠さない） -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RunButton" Style="{StaticResource FlatButton}" Height="24" Padding="11,0"
                                Margin="0,0,6,0" FontSize="{DynamicResource Fs11}" Content="▶ 実行"
                                ToolTip="デバッグなしで実行する（dotnet run・可視ターミナル）"
                                IsEnabled="{Binding Profiles.CanRunWithoutDebugger}"
                                Click="OnRunCurrentClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0" Margin="0,0,6,0"
                                FontSize="{DynamicResource Fs11}" Content="🐞 デバッグ"
                                ToolTip="選択中の対象でデバッグを開始"
                                Command="{Binding Launch.StartCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0" Margin="0,0,6,0"
                                FontSize="{DynamicResource Fs11}" Content="🔨 ビルド"
                                ToolTip="dotnet build を実行（.sln 優先）"
                                Command="{Binding Launch.BuildTargetCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0"
                                FontSize="{DynamicResource Fs11}" Content="🧪 テスト"
                                ToolTip="dotnet test を実行（.sln 優先）"
                                Command="{Binding Tests.TestCommand}" Click="OnActionClick" />
                    </StackPanel>

                    <CheckBox Content="先にビルド" Margin="1,6,0,0" FontSize="{DynamicResource Fs11}"
                              Foreground="{DynamicResource Fg}"
                              IsChecked="{Binding Launch.BuildFirst, Mode=TwoWay}"
                              ToolTip="デバッグ開始前に dotnet build を実行する" />

                    <!-- 停止中：続行・ステップ（ペインヘッダーのツールバーと同じ並び） -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                FontSize="{DynamicResource Fs12}" Content="▶" ToolTip="続行 (F5)"
                                Command="{Binding Launch.ContinueCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                FontSize="{DynamicResource Fs12}" Content="⤼" ToolTip="ステップオーバー"
                                Command="{Binding Launch.StepOverCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                FontSize="{DynamicResource Fs12}" Content="⤷" ToolTip="ステップイン"
                                Command="{Binding Launch.StepIntoCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0"
                                FontSize="{DynamicResource Fs12}" Content="⤴" ToolTip="ステップアウト"
                                Command="{Binding Launch.StepOutCommand}" Click="OnActionClick" />
                    </StackPanel>

                    <!-- デバッグ中：中断・再起動・停止 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                FontSize="{DynamicResource Fs12}" Content="⏸" ToolTip="すべて中断（一時停止）"
                                Command="{Binding Launch.PauseCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                FontSize="{DynamicResource Fs12}" Content="⟳" ToolTip="同じ対象で再起動"
                                Command="{Binding Launch.RestartCommand}" Click="OnActionClick" />
                        <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0"
                                FontSize="{DynamicResource Fs11}" Content="■ 停止" ToolTip="デバッグを停止"
                                Command="{Binding Launch.StopCommand}" Click="OnActionClick" />
                    </StackPanel>

                    <!-- 状態：IDE ペインを出していなくても、ここで進行と結果が読める。 -->
                    <TextBlock Text="{Binding StatusMessage}" Margin="1,6,0,0" TextWrapping="Wrap"
                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" />
                </StackPanel>
            </Border>

            <!-- ===== フッター：構成の細かい編集（引数・環境変数・例外）と出力の行き先 ===== -->
            <StackPanel DockPanel.Dock="Bottom">
                <Border Height="1" Background="{DynamicResource Border}" Margin="2,4" />
                <Button Style="{StaticResource BranchMenuItem}" FontSize="{DynamicResource Fs12}"
                        Content="構成を編集… （IDE ペインの「構成」タブ）"
                        ToolTip="引数・環境変数・例外の設定と、構成の追加／名前変更／削除"
                        Click="OnOpenIdePaneClick" />
            </StackPanel>

            <!-- ===== 実行ターゲット（1 行＝1 つの実行対象）=====
                 ⚙＝保存した構成、▸＝プロジェクト、⚑＝launchSettings のプロファイル（親の下に字下げ）。
                 行のクリックでその対象に切り替え、右の ▶／🐞 はその行をそのまま実行／デバッグする。 -->
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Profiles.RunTargets}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DebugRunTargetItem}">
                          <StackPanel>
                            <!-- グループの先頭行にだけ出る見出し（構成／対象）。一覧は1本のまま、
                                 「どちらの意味の行か」だけを示す。 -->
                            <TextBlock Text="{Binding GroupLabel}" Style="{StaticResource PopupSectionLabel}"
                                       Visibility="{Binding GroupLabel, Converter={StaticResource NonEmptyToVis}}" />
                            <Button Style="{StaticResource BranchMenuItem}" Padding="6,3"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnTargetClick" Tag="{Binding}"
                                    ToolTip="{Binding ToolTipText}">
                                <DockPanel LastChildFill="True">
                                    <!-- 右端の実行操作。選んでから別の場所の「開始」を押す往復をなくす。 -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BranchMenuItem}"
                                            Padding="6,0" Content="🐞" FontSize="{DynamicResource Fs11}"
                                            ToolTip="この対象をデバッグ" Click="OnTargetDebugClick" Tag="{Binding}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BranchMenuItem}"
                                            Padding="6,0" Content="▶" FontSize="{DynamicResource Fs11}"
                                            Foreground="{DynamicResource FgDim}"
                                            ToolTip="この対象をデバッグなしで実行"
                                            Visibility="{Binding CanRun, Converter={StaticResource BoolToVis}}"
                                            Click="OnTargetRunClick" Tag="{Binding}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}"
                                               FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource FgDim}"
                                               VerticalAlignment="Center" Margin="8,1,6,0" MaxWidth="170"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- 現在印の桁は常に確保する（印の有無で名前の位置がずれない）。 -->
                                    <Border DockPanel.Dock="Left" Width="14">
                                        <TextBlock Text="●" FontSize="{DynamicResource Fs8}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                    </Border>
                                    <!-- launchSettings の行は親のプロジェクトの下にぶら下がる。 -->
                                    <Border DockPanel.Dock="Left" Width="14"
                                            Visibility="{Binding IsChild, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="18"
                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                          </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
