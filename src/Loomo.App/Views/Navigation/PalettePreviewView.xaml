<UserControl x:Class="sk0ya.Loomo.App.Views.PalettePreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:sk0ya.Loomo.App.Views">
    <!-- コマンドパレットの「選んでいる場所」を、開かずに見せる欄（§24.2）。
         本文は読むだけなので選択・編集はできない（開くのは Enter の仕事）。 -->
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="8,5,8,5">
                <TextBlock x:Name="HeaderText" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubHeaderText" FontSize="{DynamicResource Fs10}"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,2,0,4">
                        <ItemsControl x:Name="LinesView">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- ジャンプ先の行だけ地色を変える（どこへ飛ぶかが一目で分かる）。
                                         構文色（エディタと同じ字句解析）と行内の検索語は
                                         PaletteMatchHighlight が1回で重ねて描く。 -->
                                    <Border x:Name="row" Padding="0,0,6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                       FontFamily="Consolas" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}"
                                                       TextAlignment="Right" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" FontFamily="Consolas"
                                                       FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource Fg}"
                                                       TextTrimming="CharacterEllipsis"
                                                       views:PaletteMatchHighlight.Tokens="{Binding Tokens}"
                                                       views:PaletteMatchHighlight.Text="{Binding Text}"
                                                       views:PaletteMatchHighlight.Term="{Binding DataContext.Highlight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                            <Setter TargetName="row" Property="Background"
                                                    Value="{DynamicResource SelectionBg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="MessageText" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource FgDim}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
