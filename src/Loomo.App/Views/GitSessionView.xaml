<UserControl x:Class="sk0ya.Loomo.App.Views.GitSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
        </Style>

        <!-- 一覧アイテム共通：行全体ハイライト・選択はアクセント -->
        <Style x:Key="GitListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GitListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <!-- LogList（ListView+GridView）専用の行コンテナ。GitListItem（ListBoxItem 用）を GridView 付き
             ListView にそのまま使うと、ControlTemplate の ContentPresenter が GridViewRowPresenter を
             持たないため列が描画されず「オブジェクトの ToString()」表示に落ちる（要 GridViewRowPresenter）。 -->
        <Style x:Key="GitLogListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <local:ColumnGapGridViewRowPresenter Content="{TemplateBinding Content}"
                                                                 Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コミット一覧の列境界のつまみに共通のスタイル（ヘッダー行の PART_HeaderGripper と、行本体
             オーバーレイ側のつまみの両方から参照する。定義順の都合でヘッダースタイルより前に置く）。
             既定の Thumb 外観（テーマ非依存の立体調グレー帯。Background だけでは消せず、これが
             「見出しの区切り線がカラーテーマに追従しない」原因だった）を消し、ホバー中だけ
             アクセント色の細い線を見せる。 -->
        <Style x:Key="LogColumnResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="b" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左列（ブランチ一覧）の開閉ボタン。コミット一覧の見出し行に収まるよう、装飾は最小限の
             平板な山括弧1文字にする（開＝◀ 閉じられる／閉＝▶ 開ける）。 -->
        <Style x:Key="BranchColumnToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="ブランチ一覧の表示／非表示" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="2">
                            <TextBlock x:Name="glyph" Text="▶" FontSize="{DynamicResource Fs8}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glyph" Property="Text" Value="◀" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コミット一覧（LogList）の列見出し。既定の GridViewColumnHeader は OS 標準のボタン風装飾で
             ダークテーマに馴染まないため平板化するが、列幅ドラッグ自体は既定テンプレートが
             "PART_HeaderGripper" という名前の Thumb を探して配線するので、そのThumbだけは残す
             （ただし既定の Thumb 外観のままだと Background 指定だけでは灰色の区切り線が残ってしまう
             ため、LogColumnResizeThumb と同じテンプレートを与えて完全に平板化する）。
             GridView の末尾に自動生成される空の「埋め草」ヘッダー（Role=Padding）は
             GridView.ColumnHeaderContainerStyle を経由せず既定スタイルのまま残る（White地のまま浮く）ため、
             x:Key を付けず TargetType 一致の暗黙スタイルにして埋め草にも確実に適用する。 -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <!-- 見出し文字は ContentTemplate で明示的に Fs11 を指定する。ContentPresenter が
                 文字列から起こす TextBlock には App 既定の暗黙 TextBlock スタイル（Fs13）が効いて
                 しまい、上の FontSize（継承値）に勝つ＝見出しだけ本文と同じ大きさになって
                 ヘッダー行が無駄に高くなるため。 -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource Fs11}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6"
                                   Style="{StaticResource LogColumnResizeThumb}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 変更ファイル一覧の1行。左＝名前（ファイルはリンク：クリックでエディタで開く）、
             右＝フォルダは件数ピル／ファイルは増減。コンテナは BranchTreeItem を共用する
             （矢印＋全幅ホバー＋子の左ガイド線が同じ見え方になる）。 -->
        <HierarchicalDataTemplate x:Key="CommitFileNodeTemplate" ItemsSource="{Binding Children}">
            <DockPanel ToolTip="{Binding ToolTipText}" Background="Transparent">
                <!-- フォルダ行の件数ピル -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource Border}" CornerRadius="7"
                        Padding="6,0" MinWidth="18" Height="15" Margin="6,0,2,0" VerticalAlignment="Center"
                        Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding LeafCount}" FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource Fg}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- ファイル行の増減（+12 -3 ／ バイナリは Bin） -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding ChurnLabel}" FontSize="{DynamicResource Fs10}"
                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="8,1,2,0"
                           FontFamily="Cascadia Mono, Consolas" />

                <!-- 名前。ファイルは Fg、フォルダは淡色（ブランチ一覧と同じ塗り分け）。
                     <b>リンクにはしない</b>——Hyperlink はマウスダウンを自分で握ってしまい、
                     行のダブルクリック（＝差分を別ウィンドウ）が永久に届かなくなる。 -->
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- リポジトリでないとき -->
        <TextBlock DockPanel.Dock="Top" Margin="12,8"
                   Text="このワークスペースは git リポジトリではありません。サイドバーの Git パネルから初期化できます。"
                   TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                   Visibility="{Binding IsRepository, Converter={StaticResource InverseBoolToVis}}" />

        <DockPanel Visibility="{Binding IsRepository, Converter={StaticResource BoolToVis}}">

            <!-- 同期帯（フェッチ／プル／プッシュ・上流表示・ルート切替）はここには置かない。
                 ペインヘッダーのブランチ切替ボタンのポップアップ（BranchSwitcherView）が同じ操作を
                 同じ形で持っていて役割が重複するので、持ち場をそちら一箇所に寄せた。 -->

            <!-- 進行中操作（rebase / merge / cherry-pick）のバナー -->
            <Border DockPanel.Dock="Top" Margin="8,4,8,4" Padding="8,6" CornerRadius="4"
                    Background="#33E5A23B" BorderBrush="#FFE5A23B" BorderThickness="1"
                    Visibility="{Binding OperationInProgress, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                            Content="中止" Command="{Binding AbortOperationCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                            Content="スキップ" Command="{Binding SkipOperationCommand}"
                            Visibility="{Binding OperationCanSkip, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                            Content="続行" Command="{Binding ContinueOperationCommand}" />
                    <TextBlock Text="{Binding OperationLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- 実行結果メッセージ -->
            <TextBlock DockPanel.Dock="Bottom" Margin="10,2,10,6" FontSize="{DynamicResource Fs11}"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="60">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#FFE57373" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BranchColumn" Width="190" MinWidth="120" />
                    <ColumnDefinition x:Name="BranchSplitterColumn" Width="6" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- ブランチ一覧＋タグ一覧。コミット一覧の見出し「コミット」の左の開閉ボタンで
                     列ごと畳める（非表示時は列の幅ごと 0 にする＝ApplyBranchColumnVisibility）。 -->
                <Grid x:Name="BranchPanel" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="80" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="1*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <!-- 特定ブランチに絞っている間だけ「すべてのブランチ」へ戻すリンクを出す -->
                        <Button DockPanel.Dock="Top" Margin="8,0,8,2" HorizontalAlignment="Left"
                                Style="{StaticResource ToolbarButton}" Content="↺ すべてのブランチを表示"
                                Click="OnShowAllBranchesLog"
                                Visibility="{Binding History.IsLogScoped, Converter={StaticResource BoolToVis}}" />
                        <TreeView x:Name="BranchList" Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource Fg}"
                                  ItemsSource="{Binding BranchTree}"
                                  ItemContainerStyle="{StaticResource BranchTreeItem}"
                                  ItemTemplate="{StaticResource BranchNodeTemplate}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="OnBranchDoubleClick"
                                  PreviewMouseLeftButtonUp="OnBranchTreeClick"
                                  PreviewMouseRightButtonDown="OnListRightClickSelect"
                                  ContextMenuOpening="OnBranchContextMenuOpening">
                            <!-- 行の右クリック＝そのブランチ1本に効く操作。フォルダ／見出しではメニューを出さず、
                                 現在ブランチやリモートブランチに意味を成さない項目は無効化する。 -->
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="このブランチのコミットを表示" Click="OnBranchShowLog" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuCheckout" Header="チェックアウト" Click="OnBranchCheckout" />
                                    <MenuItem x:Name="BranchMenuMerge" Header="現在のブランチへマージ" Click="OnBranchMerge" />
                                    <MenuItem x:Name="BranchMenuMergeStrategy" Header="現在のブランチへマージ（戦略を選択）">
                                        <MenuItem Header="Fast-forwardのみでマージ" Click="OnBranchMergeFastForwardOnly" />
                                        <MenuItem Header="マージコミットを作成してマージ" Click="OnBranchMergeNoFastForward" />
                                        <MenuItem Header="スカッシュマージ（コミットは別途実行）" Click="OnBranchMergeSquash" />
                                    </MenuItem>
                                    <MenuItem x:Name="BranchMenuRebase" Header="このブランチへリベース（現在のブランチを載せ替え）" Click="OnBranchRebase" />
                                    <Separator />
                                    <MenuItem Header="ここから新しいブランチを作成…" Click="OnBranchCreateFrom" />
                                    <MenuItem Header="ブランチ名をコピー" Click="OnBranchCopyName" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuDelete" Header="削除" Click="OnBranchDelete" />
                                    <MenuItem x:Name="BranchMenuDeleteRemote" Header="リモートから削除…"
                                              Click="OnBranchDeleteRemote" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuSetUpstream" Header="上流を設定…" Click="OnBranchSetUpstream" />
                                    <MenuItem x:Name="BranchMenuUnsetUpstream" Header="上流を解除" Click="OnBranchUnsetUpstream" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuPull" Header="プル" Click="OnBranchPull" />
                                    <MenuItem x:Name="BranchMenuPush" Header="プッシュ" Click="OnBranchPush" />
                                    <MenuItem x:Name="BranchMenuPushForce" Header="強制プッシュ（--force-with-lease）…"
                                              Click="OnBranchPushForce" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Border}" />

                    <!-- タグ一覧＋サブモジュール一覧 -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="40" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <DockPanel DockPanel.Dock="Top" Margin="8,2,8,2" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                                        Content="＋ タグ" ToolTip="タグを作成…" Click="OnTagCreate" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0"
                                        Content="⇡ 全て" ToolTip="すべてのタグをプッシュ" Click="OnTagsPushAll" />
                            </DockPanel>
                            <ListBox x:Name="TagList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Tags}"
                                     MouseDoubleClick="OnTagDoubleClick"
                                     PreviewMouseRightButtonDown="OnListRightClickSelect">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="チェックアウト（detached）" Click="OnTagCheckout" />
                                        <MenuItem Header="プッシュ" Click="OnTagPush" />
                                        <MenuItem Header="タグ名をコピー" Click="OnTagCopyName" />
                                        <Separator />
                                        <MenuItem Header="削除" Click="OnTagDelete" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Subject}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TargetShortHash}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"
                                                       FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- リモート一覧。行の右クリックで URL 変更・削除、見出しの「＋」で追加。
                             リモートが1つも無いリポジトリでも見出しは出す（＝「追加できる場所」がここだと分かる）。 -->
                        <DockPanel Grid.Row="1" Margin="0,6,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="8,2,8,2" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="リモート" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0"
                                        Content="＋ 追加" ToolTip="リモートを追加…" Click="OnRemoteAdd" />
                            </DockPanel>
                            <ListBox x:Name="RemoteList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Remotes}" MaxHeight="120"
                                     PreviewMouseRightButtonDown="OnListRightClickSelect">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="URL を変更…" Click="OnRemoteSetUrl" />
                                        <MenuItem Header="URL をコピー" Click="OnRemoteCopyUrl" />
                                        <Separator />
                                        <MenuItem Header="削除…" Click="OnRemoteRemove" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Url}">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                                       FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- サブモジュール一覧（サブモジュールが無いワークスペースではセクションごと隠す） -->
                        <DockPanel Grid.Row="2" Margin="0,6,0,0"
                                   Visibility="{Binding Submodules.Count, Converter={StaticResource CountToVis}}">
                            <DockPanel DockPanel.Dock="Top" Margin="8,2,8,2" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="サブモジュール" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0"
                                        Content="同期" Click="OnSubmodulesSync" />
                            </DockPanel>
                            <ListBox x:Name="SubmoduleList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Submodules}" MaxHeight="160"
                                     PreviewMouseRightButtonDown="OnListRightClickSelect">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="初期化" Click="OnSubmoduleInit" />
                                        <MenuItem Header="更新" Click="OnSubmoduleUpdate" />
                                        <Separator />
                                        <MenuItem Header="パスをコピー" Click="OnSubmoduleCopyPath" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Describe}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="#FFE5A23B" Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShortHash}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"
                                                       FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Grid>

                <GridSplitter x:Name="BranchSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Border}" />

                <!-- コミットグラフ＋詳細。詳細はグラフの「右」に縦に置く（変更ファイル一覧が上・
                     コミットコメントが下）。ファイルのパスは横に長いので、下段の横帯より
                     右の縦列の方がフォルダ構造ごと収まる。Git ペインのタイトル領域のトグルで
                     表示/非表示を切り替えられる（非表示時は列の幅ごと畳む＝ApplyCommitDetailVisibility）。 -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition x:Name="CommitDetailSplitterColumn" Width="6" />
                        <ColumnDefinition x:Name="CommitDetailColumn" Width="300" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <!-- コミットグラフ本体（Column 0）。パス履歴の絞り込み帯を上に載せるため、一覧と列幅
                         ドラッグ用オーバーレイ（両者は同座標で重ねる必要がある）を DockPanel でまとめる。 -->
                    <DockPanel Grid.Column="0">
                    <!-- ファイル／フォルダの履歴に絞っている間だけ出すスコープ帯（「✕」で解除）。 -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,2" Padding="8,4"
                            Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding History.IsPathScoped, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                                    Content="✕ 解除" Command="{Binding History.ClearPathScopeCommand}"
                                    ToolTip="パスの履歴絞り込みを解除して全コミットを表示" />
                            <TextBlock DockPanel.Dock="Left" Text="履歴:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource FgDim}" />
                            <TextBlock Text="{Binding History.PathScopeLabel}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource Fg}"
                                       ToolTip="{Binding History.PathScopeLabel}" />
                        </DockPanel>
                    </Border>
                    <Grid>
                    <!-- 列幅は列境界をドラッグして調整できる（日時・作者が固定幅でコミットメッセージを
                         圧迫し、狭いペインで見出しがほぼ読めなくなる問題への対処）。ここの Width は
                         初期値で、幅の余りは先頭列（コミット）が吸って一覧の右端まで埋める
                         ＝ID の右境界は常に詳細列の GridSplitter と重なる
                         （GitSessionView.LogColumnResize.cs）。 -->
                    <ListView x:Name="LogList" Style="{StaticResource GitList}"
                             ItemContainerStyle="{StaticResource GitLogListItem}"
                             ItemsSource="{Binding History.LogView}"
                             SelectedItem="{Binding History.SelectedLogRow, Mode=TwoWay}"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.ScrollChanged="OnLogScrollChanged"
                             MouseDoubleClick="OnCommitShowDiff"
                             PreviewMouseRightButtonDown="OnListRightClickSelect"
                             ContextMenuOpening="OnCommitContextMenuOpening"
                             FontFamily="Cascadia Mono, Consolas">
                        <ListView.View>
                            <GridView>
                                <!-- 見出しの左端に左列（ブランチ一覧）の開閉ボタンを置く。列見出しの
                                     DataContext は見出し文字列そのものなので、状態は UserControl の
                                     DataContext（VM）へ RelativeSource で結ぶ。結びは片方向＋Click で
                                     VM を反転させる：TwoWay にすると見出しの再生成や DataContext の
                                     差し替えの拍子に ToggleButton の既定値（false）が VM へ書き戻され、
                                     押してもいないのに畳まれた状態が設定へ永続化されてしまう。 -->
                                <GridViewColumn Header="コミット" Width="380">
                                    <GridViewColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Style="{StaticResource BranchColumnToggle}"
                                                              Click="OnBranchColumnToggleClick"
                                                              IsChecked="{Binding DataContext.BranchColumnVisible,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                                  Mode=OneWay}" />
                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource Fs11}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.HeaderTemplate>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Graph, Mode=OneWay}" Foreground="{DynamicResource FgDim}" /><Run Text=" " /><Run
                                                    Text="{Binding Refs, Mode=OneWay}" Foreground="#FFE5A23B" /><Run Text=" " /><Run
                                                    Text="{Binding Subject, Mode=OneWay}" Foreground="{DynamicResource Fg}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="日時" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Date}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="作成者" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Author}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- ID（短縮ハッシュ）は最後。件名の頭を占領していたのを末尾へ移した。 -->
                                <GridViewColumn Header="ID" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ShortHash, Mode=OneWay}"
                                                       FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="DIFF ペインで差分を表示（複数選択で範囲比較）" Click="OnCommitShowDiff" />
                                <!-- ファイル履歴（パス絞り込み）中だけ出す「その頃のこのファイル」。
                                     OnCommitContextMenuOpening が表示を切り替える。 -->
                                <Separator x:Name="FileRevisionSeparator" />
                                <MenuItem x:Name="FileRevisionOpenMenuItem"
                                          Header="この版のファイルをエディタで開く" Click="OnCommitOpenFileRevision" />
                                <MenuItem x:Name="FileRevisionCompareMenuItem"
                                          Header="この版と現在のファイルを比較" Click="OnCommitCompareFileRevision" />
                                <MenuItem x:Name="FileRevisionRestoreMenuItem"
                                          Header="この版の内容へ戻す…" Click="OnCommitRestoreFileRevision" />
                                <Separator />
                                <MenuItem Header="ここから新しいブランチを作成…" Click="OnCommitCreateBranch" />
                                <MenuItem Header="タグを作成…" Click="OnCommitCreateTag" />
                                <MenuItem Header="チェックアウト（detached HEAD）" Click="OnCommitCheckout" />
                                <MenuItem Header="コミットメッセージを修正…" Click="OnCommitRewriteMessage" />
                                <MenuItem x:Name="InteractiveRebaseMenuItem"
                                          Header="ここからインタラクティブリベース…" Click="OnCommitInteractiveRebase" />
                                <!-- スカッシュは2件以上の選択時だけ表示（OnCommitContextMenuOpening で切替） -->
                                <Separator x:Name="SquashSeparator" />
                                <MenuItem x:Name="SquashMenuItem"
                                          Header="選択したコミットをスカッシュ（1つにまとめる）" Click="OnCommitSquash" />
                                <Separator />
                                <MenuItem Header="チェリーピック（現在のブランチへ取り込み）" Click="OnCommitCherryPick" />
                                <MenuItem Header="リバート（打ち消しコミットを作成）" Click="OnCommitRevert" />
                                <Separator />
                                <MenuItem Header="ここまでリセット (soft)" Click="OnCommitResetSoft" />
                                <MenuItem Header="ここまでリセット (mixed)" Click="OnCommitResetMixed" />
                                <MenuItem Header="ここまでリセット (hard)…" Click="OnCommitResetHard" />
                                <Separator />
                                <MenuItem Header="パッチをエディタで開く" Click="OnCommitOpenPatch" />
                                <MenuItem Header="ハッシュをコピー" Click="OnCommitCopyHash" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <!-- 列幅ドラッグをヘッダー行の細い当たり判定に限定せず、一覧本体からも行える
                         ようにするオーバーレイ（GitSessionView.LogColumnResize.cs が組み立て・追従）。
                         背景は敢えて未設定（null）にして、つまみ以外の透過部分はクリックを
                         下の行へそのまま通す（Background="Transparent" は当たり判定を奪うので使わない）。 -->
                    <Canvas x:Name="LogColumnResizeOverlay" />
                    </Grid>
                    </DockPanel>

                    <GridSplitter x:Name="CommitDetailSplitter" Grid.Column="1" Width="6"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{DynamicResource Border}" />

                    <!-- 選択コミットの詳細。上＝変更ファイル一覧（フォルダ構造つき）、
                         下＝コミットの情報（サマリ「12 ファイル +34 -5」とコミットコメント）。
                         一覧が主役なので最上段を丸ごと一覧に使い、サマリは見出しとして一覧の
                         上に載せず、下段の情報帯の先頭へ回す。 -->
                    <Grid x:Name="CommitDetailPanel" Grid.Column="2" Background="{DynamicResource BgAlt}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="60" />
                            <RowDefinition Height="6" />
                            <!-- 下段はサマリ1行ぶん背が高くなったので最小高もその分だけ上げる
                                 （縮めきったときにコメントが完全に潰れないように）。 -->
                            <RowDefinition Height="1*" MinHeight="64" />
                        </Grid.RowDefinitions>

                        <TreeView x:Name="CommitFileList" Grid.Row="0" Margin="0,2,0,0"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource Fg}"
                                  ItemsSource="{Binding History.CommitFiles}"
                                  ItemContainerStyle="{StaticResource BranchTreeItem}"
                                  ItemTemplate="{StaticResource CommitFileNodeTemplate}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseRightButtonDown="OnListRightClickSelect"
                                  ContextMenuOpening="OnCommitFileContextMenuOpening"
                                  MouseDoubleClick="OnCommitFileDoubleClick">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="差分を別ウィンドウで表示" Click="OnCommitFileDiffWindow"
                                              FontWeight="SemiBold" />
                                    <MenuItem Header="エディタで開く" Click="OnCommitFileOpen" />
                                    <MenuItem Header="パスをコピー" Click="OnCommitFileCopyPath" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource Border}" />

                        <!-- コミットの情報。上＝サマリ（「変更ファイル 12 ファイル +34 -5」）、
                             下＝コミットコメント（件名・本文と、その下にハッシュ／作者／日時の1行）。
                             サマリは一覧が空のときも帯として残す（詳細列がどこの何なのかが常に
                             分かるように）。コメントは選択・コピーできるよう読み取り専用の TextBox に
                             する（狭い列なので折り返す）。 -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Margin="8,4,8,2"
                                       FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis">
                                <Run Text="変更ファイル" /><Run Text="  " /><Run
                                    Text="{Binding History.CommitFileSummary, Mode=OneWay}"
                                    FontWeight="Normal" />
                            </TextBlock>
                            <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Text="{Binding History.CommitMessage, Mode=OneWay}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                                     Foreground="{DynamicResource Fg}" Padding="6,4"
                                     BorderThickness="0" Background="Transparent" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
