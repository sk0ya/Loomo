<UserControl x:Class="sk0ya.Loomo.App.Views.GitSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
        </Style>

        <!-- 一覧アイテム共通：行全体ハイライト・選択はアクセント -->
        <Style x:Key="GitListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GitListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <!-- LogList（ListView+GridView）専用の行コンテナ。GitListItem（ListBoxItem 用）を GridView 付き
             ListView にそのまま使うと、ControlTemplate の ContentPresenter が GridViewRowPresenter を
             持たないため列が描画されず「オブジェクトの ToString()」表示に落ちる（要 GridViewRowPresenter）。 -->
        <Style x:Key="GitLogListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <local:ColumnGapGridViewRowPresenter Content="{TemplateBinding Content}"
                                                                 Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コミット一覧の列境界のつまみに共通のスタイル（ヘッダー行の PART_HeaderGripper と、行本体
             オーバーレイ側のつまみの両方から参照する。定義順の都合でヘッダースタイルより前に置く）。
             既定の Thumb 外観（テーマ非依存の立体調グレー帯。Background だけでは消せず、これが
             「見出しの区切り線がカラーテーマに追従しない」原因だった）を消し、ホバー中だけ
             アクセント色の細い線を見せる。 -->
        <Style x:Key="LogColumnResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="b" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ブランチ一覧の左に立てる操作バーのボタン。幅 26px の縦帯に収めるので、文字は1つだけ
             （名前はツールチップが持つ）。無効時はテンプレート側で薄くする＝押せないことを形で見せる。 -->
        <Style x:Key="BranchOpButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作バーの区切り（同期／ブランチ／一覧の3群を見分けるための線） -->
        <Style x:Key="BranchOpSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="5,5" />
            <Setter Property="Background" Value="{DynamicResource Border}" />
        </Style>

        <!-- 同期ボタン（フェッチ／プル／プッシュ）。件数を矢印の下に置くぶん背を高くし、3つとも
             同じ寸法にする——高さが揃っていないと矢印の高さが1つだけずれて見える。 -->
        <Style x:Key="BranchOpSyncButton" TargetType="Button" BasedOn="{StaticResource BranchOpButton}">
            <Setter Property="Height" Value="32" />
        </Style>

        <!-- 同期ボタンの矢印。送る／取り込む対象があるとき（件数>0）だけアクセント色にする。 -->
        <Style x:Key="BranchOpArrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs14}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 件数。26px 幅に矢印と並べる余地は無いので<b>下の行</b>へ置く（重ねると桁が矢印に食い込む）。 -->
        <Style x:Key="BranchOpCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs9}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- 左列（ブランチ一覧）の開閉ボタン。操作バーの先頭に立てるので、寸法は
             BranchOpButton と揃える（開＝◀ 閉じられる／閉＝▶ 開ける）。 -->
        <Style x:Key="BranchColumnToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="ブランチ一覧の表示／非表示" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="glyph" Text="▶" FontSize="{DynamicResource Fs9}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glyph" Property="Text" Value="◀" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コミット一覧（LogList）の列見出し。既定の GridViewColumnHeader は OS 標準のボタン風装飾で
             ダークテーマに馴染まないため平板化するが、列幅ドラッグ自体は既定テンプレートが
             "PART_HeaderGripper" という名前の Thumb を探して配線するので、そのThumbだけは残す
             （ただし既定の Thumb 外観のままだと Background 指定だけでは灰色の区切り線が残ってしまう
             ため、LogColumnResizeThumb と同じテンプレートを与えて完全に平板化する）。
             GridView の末尾に自動生成される空の「埋め草」ヘッダー（Role=Padding）は
             GridView.ColumnHeaderContainerStyle を経由せず既定スタイルのまま残る（White地のまま浮く）ため、
             x:Key を付けず TargetType 一致の暗黙スタイルにして埋め草にも確実に適用する。 -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <!-- 見出し文字は ContentTemplate で明示的に Fs11 を指定する。ContentPresenter が
                 文字列から起こす TextBlock には App 既定の暗黙 TextBlock スタイル（Fs13）が効いて
                 しまい、上の FontSize（継承値）に勝つ＝見出しだけ本文と同じ大きさになって
                 ヘッダー行が無駄に高くなるため。 -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource Fs11}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6"
                                   Style="{StaticResource LogColumnResizeThumb}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 変更ファイル一覧の1行。左＝名前（ファイルはリンク：クリックでエディタで開く）、
             右＝フォルダは件数ピル／ファイルは増減。コンテナは BranchTreeItem を共用する
             （矢印＋全幅ホバー＋子の左ガイド線が同じ見え方になる）。 -->
        <HierarchicalDataTemplate x:Key="CommitFileNodeTemplate" ItemsSource="{Binding Children}">
            <DockPanel ToolTip="{Binding ToolTipText}" Background="Transparent">
                <!-- フォルダ行の件数ピル -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource Border}" CornerRadius="7"
                        Padding="6,0" MinWidth="18" Height="15" Margin="6,0,2,0" VerticalAlignment="Center"
                        Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding LeafCount}" FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource Fg}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- ファイル行の増減（+12 -3 ／ バイナリは Bin） -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding ChurnLabel}" FontSize="{DynamicResource Fs10}"
                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="8,1,2,0"
                           FontFamily="Cascadia Mono, Consolas" />

                <!-- 名前。ファイルは Fg、フォルダは淡色（ブランチ一覧と同じ塗り分け）。
                     <b>リンクにはしない</b>——Hyperlink はマウスダウンを自分で握ってしまい、
                     行のダブルクリック（＝差分を別ウィンドウ）が永久に届かなくなる。 -->
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- リポジトリでないとき -->
        <TextBlock DockPanel.Dock="Top" Margin="12,8"
                   Text="このワークスペースは git リポジトリではありません。サイドバーの Git パネルから初期化できます。"
                   TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                   Visibility="{Binding IsRepository, Converter={StaticResource InverseBoolToVis}}" />

        <DockPanel Visibility="{Binding IsRepository, Converter={StaticResource BoolToVis}}">

            <!-- 同期（フェッチ／プル／プッシュ）の持ち場は、ペインでは<b>ブランチ一覧の左の操作バー</b>
                 （下の BranchPanel）。横帯にしないのは、押す相手＝ブランチが見えている場所の隣に
                 置きたいため。ペインヘッダーにあったブランチ切替ポップアップは、この一覧と操作バーが
                 同じ操作を常に見える形で持つので消した（タイトルバー側のポップアップだけが残る）。 -->

            <!-- 進行中操作（rebase / merge / cherry-pick）のバナー -->
            <Border DockPanel.Dock="Top" Margin="8,4,8,4" Padding="8,6" CornerRadius="4"
                    Background="#33E5A23B" BorderBrush="#FFE5A23B" BorderThickness="1"
                    Visibility="{Binding OperationInProgress, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                            Content="中止" Command="{Binding AbortOperationCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                            Content="スキップ" Command="{Binding SkipOperationCommand}"
                            Visibility="{Binding OperationCanSkip, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                            Content="続行" Command="{Binding ContinueOperationCommand}" />
                    <TextBlock Text="{Binding OperationLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- 実行結果メッセージ -->
            <TextBlock DockPanel.Dock="Bottom" Margin="10,2,10,6" FontSize="{DynamicResource Fs11}"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="60">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#FFE57373" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BranchColumn" Width="190" MinWidth="120" />
                    <ColumnDefinition x:Name="BranchSplitterColumn" Width="6" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- 操作バー＋ブランチ一覧＋タグ一覧。バーのいちばん上の開閉ボタンで一覧を畳める
                     （畳んでも列は 0 にせずバーの幅まで詰める＝ApplyBranchColumnVisibility。
                     バーごと消すと戻す入口が画面から無くなるため）。 -->
                <DockPanel x:Name="BranchPanel" Grid.Column="0">

                    <!-- ===== 操作バー（一覧の左に立てる縦帯）=====
                         上から「同期（リポジトリ全体）」「ブランチ（選んだ1本）」「一覧そのもの」の3群。
                         同期がここに来たのは、ペインの中で<b>一覧を見ながら押せる場所</b>が他に無かった
                         ため——以前はヘッダーのブランチ切替ポップアップの同期帯だけが持ち場で、押すたびに
                         一覧を開き直す必要があった（そのポップアップはペインからは消した）。
                         ブランチ群は選択に追従して有効／無効が変わる（UpdateBranchOpButtons）。 -->
                    <Border x:Name="BranchOpBar" DockPanel.Dock="Left" Background="{DynamicResource BgAlt}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="1,3">
                        <StackPanel>
                            <!-- 一覧の開閉。バーはここだけ残して畳むので、戻す入口が画面から消えない。
                                 結びは片方向＋Click で VM を反転させる：TwoWay にすると DataContext の
                                 差し替えの拍子に既定値（false）が VM へ書き戻され、押してもいない
                                 畳んだ状態が設定へ永続化されてしまう。 -->
                            <ToggleButton Style="{StaticResource BranchColumnToggle}"
                                          Click="OnBranchColumnToggleClick"
                                          IsChecked="{Binding BranchColumnVisible, Mode=OneWay}" />

                            <Border Style="{StaticResource BranchOpSeparator}" />

                            <Button Style="{StaticResource BranchOpSyncButton}"
                                    ToolTip="フェッチ（リモートの最新を取得する。作業ツリーは変えない）"
                                    IsEnabled="{Binding HasRemote}" Command="{Binding FetchCommand}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="⭮" Style="{StaticResource BranchOpArrow}" />
                                </Grid>
                            </Button>

                            <!-- 方式（マージ／リベース／早送りのみ）を並べる幅は無いので右クリックへ逃がす。
                                 1クリックの既定は素の pull のまま。 -->
                            <Button Style="{StaticResource BranchOpSyncButton}"
                                    ToolTip="プル（上流の変更を現在ブランチへ取り込む）／右クリックで取り込み方を選ぶ"
                                    IsEnabled="{Binding HasRemote}" Command="{Binding PullCommand}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="マージで取り込む（既定）" Click="OnBarPullMerge" />
                                        <MenuItem Header="リベースで取り込む（--rebase）" Click="OnBarPullRebase" />
                                        <MenuItem Header="早送りできるときだけ（--ff-only）" Click="OnBarPullFastForward" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="↓">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BranchOpArrow}">
                                                <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Behind, Converter={StaticResource CountToVis}}"
                                                                 Value="Visible">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="{Binding Behind}" Style="{StaticResource BranchOpCount}"
                                               Visibility="{Binding Behind, Converter={StaticResource CountToVis}}" />
                                </Grid>
                            </Button>

                            <!-- 強制プッシュは右クリックの中に置く。リベース・amend の後に必ず要るが、
                                 1クリック目に出してよい操作ではない。 -->
                            <Button Style="{StaticResource BranchOpSyncButton}"
                                    ToolTip="プッシュ（現在ブランチのコミットを上流へ送る）／右クリックで強制プッシュ"
                                    IsEnabled="{Binding HasRemote}" Command="{Binding PushCommand}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="プッシュ（既定）" Click="OnBarPushNormal" />
                                        <MenuItem Header="強制プッシュ（--force-with-lease）…" Click="OnBarPushForce" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="↑">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BranchOpArrow}">
                                                <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ahead, Converter={StaticResource CountToVis}}"
                                                                 Value="Visible">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="{Binding Ahead}" Style="{StaticResource BranchOpCount}"
                                               Visibility="{Binding Ahead, Converter={StaticResource CountToVis}}" />
                                </Grid>
                            </Button>

                            <!-- ここから下は一覧を見ながら押す群なので、畳んでいる間は隠す
                                 （選んだ1本に効く操作が、見えない選択に効いてしまうのを防ぐ）。
                                 同期は上に残す——ペインの中で他に入口が無い。 -->
                            <StackPanel x:Name="BranchOpListGroup">
                            <Border Style="{StaticResource BranchOpSeparator}" />

                            <!-- 以下は「一覧で選んだ1本」に効く群。選択が無い／フォルダ行のときは押せない
                                 （＋だけは現在ブランチから作れるので常に押せる）。 -->
                            <Button Style="{StaticResource BranchOpButton}"
                                    Content="＋" ToolTip="新しいブランチを作成…（選んだブランチが起点。無選択なら現在ブランチ）"
                                    Click="OnBarBranchCreate" />
                            <Button x:Name="BranchOpCheckout" Style="{StaticResource BranchOpButton}"
                                    Content="✓" ToolTip="チェックアウト（選んだブランチへ切り替える）"
                                    Click="OnBranchCheckout" />
                            <Button x:Name="BranchOpMerge" Style="{StaticResource BranchOpButton}"
                                    Content="⑃" ToolTip="現在のブランチへマージ（選んだブランチを取り込む）"
                                    Click="OnBranchMerge" />
                            <Button x:Name="BranchOpDelete" Style="{StaticResource BranchOpButton}"
                                    Content="🗑" ToolTip="削除（選んだブランチ）"
                                    Click="OnBranchDelete" />

                            <Border Style="{StaticResource BranchOpSeparator}" />

                            <Button Style="{StaticResource BranchOpButton}" Content="⊞"
                                    ToolTip="すべて展開" Click="OnBarExpandAll" />
                            <Button Style="{StaticResource BranchOpButton}" Content="⊟"
                                    ToolTip="すべて折りたたむ" Click="OnBarCollapseAll" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="BranchListArea">
                    <!-- 下段が3セクションの縦積みから切替式になったぶん、既定の取り分をブランチへ寄せる
                         （下段はどの種類でも「見出し1行＋一覧」の同じ高さで足りる）。 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="80" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="1*" MinHeight="70" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <!-- 特定ブランチに絞っている間だけ「すべてのブランチ」へ戻すリンクを出す -->
                        <Button DockPanel.Dock="Top" Margin="8,0,8,2" HorizontalAlignment="Left"
                                Style="{StaticResource ToolbarButton}" Content="↺ すべてのブランチを表示"
                                Click="OnShowAllBranchesLog"
                                Visibility="{Binding History.IsLogScoped, Converter={StaticResource BoolToVis}}" />

                        <!-- ブランチの絞り込み。ブランチ切替ポップアップの絞り込みとは<b>別の状態</b>
                             （PaneBranchFilter）を見る——同じにすると、ポップアップを開いた拍子に
                             （開くたびに空へ戻す作りなので）ここで打った語が消える。
                             Esc で解除、↓ で一覧へ（GitSessionView.Keyboard.cs）。 -->
                        <Grid DockPanel.Dock="Top" Margin="8,0,8,3">
                            <TextBox x:Name="BranchFilterBox" MinHeight="24"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding PaneBranchFilter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     PreviewKeyDown="OnBranchFilterKeyDown">
                                <TextBox.Style>
                                    <!-- 右の余白は「✕」が出ている間だけ空ける（常に空けると、絞り込んで
                                         いないときに理由のない余白が残る）。 -->
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Padding" Value="6,3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPaneBranchFilter}" Value="True">
                                                <Setter Property="Padding" Value="6,3,24,3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- 透かし文字は<b>入力欄の Text</b> を見る。VM 側（Delay=120）を見ると、
                                 打った最初の1文字の上に 120ms のあいだ透かしが残る。 -->
                            <TextBlock Text="🔍 ブランチを絞り込み" Foreground="{DynamicResource FgDim}"
                                       FontSize="{DynamicResource Fs12}" Margin="8,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=BranchFilterBox,
                                           Converter={StaticResource EmptyToVis}}" />
                            <!-- 幅は固定する。文字サイズ設定（Fs*）で膨らむと、上で空けた右余白（24px）を
                                 食い破って長いブランチ名の末尾に重なり、そこはクリックもできなくなる。 -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                    Width="18" Height="18" Padding="0"
                                    Style="{StaticResource ToolbarButton}" Content="✕"
                                    ToolTip="絞り込みを解除（Esc）"
                                    Command="{Binding ClearPaneBranchFilterCommand}"
                                    Visibility="{Binding HasPaneBranchFilter, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TreeView x:Name="BranchList" Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource Fg}"
                                  ItemsSource="{Binding PaneFilteredBranchTree}"
                                  ItemContainerStyle="{StaticResource BranchTreeItem}"
                                  ItemTemplate="{StaticResource BranchNodeTemplate}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="OnBranchDoubleClick"
                                  SelectedItemChanged="OnBranchSelectionChanged"
                                  PreviewKeyDown="OnBranchListKeyDown"
                                  PreviewMouseLeftButtonUp="OnBranchTreeClick"
                                  PreviewMouseRightButtonDown="OnListRightClickSelect"
                                  ContextMenuOpening="OnBranchContextMenuOpening">
                            <!-- 行のクリック／右クリック＝そのブランチ1本に効く操作。フォルダ／見出しではメニューを出さず、
                                 現在ブランチやリモートブランチに意味を成さない項目は無効化する。 -->
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="このブランチのコミットを表示" Click="OnBranchShowLog" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuCheckout" Header="チェックアウト" Click="OnBranchCheckout" />
                                    <MenuItem x:Name="BranchMenuMerge" Header="現在のブランチへマージ" Click="OnBranchMerge" />
                                    <MenuItem x:Name="BranchMenuMergeStrategy" Header="現在のブランチへマージ（戦略を選択）">
                                        <MenuItem Header="Fast-forwardのみでマージ" Click="OnBranchMergeFastForwardOnly" />
                                        <MenuItem Header="マージコミットを作成してマージ" Click="OnBranchMergeNoFastForward" />
                                        <MenuItem Header="スカッシュマージ（コミットは別途実行）" Click="OnBranchMergeSquash" />
                                    </MenuItem>
                                    <MenuItem x:Name="BranchMenuRebase" Header="このブランチへリベース（現在のブランチを載せ替え）" Click="OnBranchRebase" />
                                    <Separator />
                                    <MenuItem Header="ここから新しいブランチを作成…" Click="OnBranchCreateFrom" />
                                    <MenuItem Header="ブランチ名をコピー" Click="OnBranchCopyName" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuDelete" Header="削除" Click="OnBranchDelete" />
                                    <MenuItem x:Name="BranchMenuDeleteRemote" Header="リモートから削除…"
                                              Click="OnBranchDeleteRemote" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuSetUpstream" Header="上流を設定…" Click="OnBranchSetUpstream" />
                                    <MenuItem x:Name="BranchMenuUnsetUpstream" Header="上流を解除" Click="OnBranchUnsetUpstream" />
                                    <Separator />
                                    <MenuItem x:Name="BranchMenuPull" Header="プル" Click="OnBranchPull" />
                                    <MenuItem x:Name="BranchMenuPush" Header="プッシュ" Click="OnBranchPush" />
                                    <MenuItem x:Name="BranchMenuPushForce" Header="強制プッシュ（--force-with-lease）…"
                                              Click="OnBranchPushForce" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Border}" />

                    <!-- 参照（タグ／リモート／サブモジュール）。3つを縦に積むと、190px の列の中で
                         本命のブランチ一覧が潰れる——とくにリモートは滅多に触らないのに場所だけ取る。
                         切替式にして、空いた高さはブランチ側へ回す。選んだ種類は設定へ持ち越す。 -->
                    <DockPanel Grid.Row="2">
                        <!-- 種類の切替。EnumToBool で相互排他に振る舞わせる。押し直しで外れて見える
                             （ToggleButton は Click の前に自分で反転する）のは、押されたボタンを
                             結び直して直す＝OnReferenceTabClick。 -->
                        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="6,2,6,3">
                            <ToggleButton x:Name="RefTabTags" Style="{StaticResource ToolbarToggleButton}" Margin="0,0,3,0"
                                          MinHeight="22" ToolTip="タグ"
                                          IsChecked="{Binding EffectiveReferenceTab, Mode=OneWay,
                                              Converter={StaticResource EnumToBool}, ConverterParameter=Tags}"
                                          Tag="Tags" Click="OnReferenceTabClick">
                                <TextBlock FontSize="{DynamicResource Fs11}">
                                    <Run Text="タグ" /><Run Text=" " /><Run
                                        Text="{Binding Tags.Count, Mode=OneWay}"
                                        Foreground="{DynamicResource FgDim}" />
                                </TextBlock>
                            </ToggleButton>
                            <ToggleButton x:Name="RefTabRemotes" Style="{StaticResource ToolbarToggleButton}" Margin="0,0,3,0"
                                          MinHeight="22" ToolTip="リモート"
                                          IsChecked="{Binding EffectiveReferenceTab, Mode=OneWay,
                                              Converter={StaticResource EnumToBool}, ConverterParameter=Remotes}"
                                          Tag="Remotes" Click="OnReferenceTabClick">
                                <TextBlock FontSize="{DynamicResource Fs11}">
                                    <Run Text="リモート" /><Run Text=" " /><Run
                                        Text="{Binding Remotes.Count, Mode=OneWay}"
                                        Foreground="{DynamicResource FgDim}" />
                                </TextBlock>
                            </ToggleButton>
                            <!-- サブモジュールが無いワークスペースでは、そもそも選べるようにしない -->
                            <ToggleButton x:Name="RefTabSubmodules" Style="{StaticResource ToolbarToggleButton}" MinHeight="22"
                                          ToolTip="サブモジュール"
                                          IsChecked="{Binding EffectiveReferenceTab, Mode=OneWay,
                                              Converter={StaticResource EnumToBool}, ConverterParameter=Submodules}"
                                          Tag="Submodules" Click="OnReferenceTabClick"
                                          Visibility="{Binding HasSubmodules, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="{DynamicResource Fs11}">
                                    <Run Text="サブ" /><Run Text=" " /><Run
                                        Text="{Binding Submodules.Count, Mode=OneWay}"
                                        Foreground="{DynamicResource FgDim}" />
                                </TextBlock>
                            </ToggleButton>
                        </UniformGrid>

                        <Grid>
                        <DockPanel Visibility="{Binding EffectiveReferenceTab, Converter={StaticResource EnumToVis},
                                       ConverterParameter=Tags}">
                            <DockPanel DockPanel.Dock="Top" Margin="8,2,8,2" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                                        Content="＋ タグ" ToolTip="タグを作成…" Click="OnTagCreate" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0"
                                        Content="⇡ 全て" ToolTip="すべてのタグをプッシュ" Click="OnTagsPushAll" />
                            </DockPanel>
                            <ListBox x:Name="TagList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Tags}"
                                     MouseDoubleClick="OnTagDoubleClick"
                                     PreviewMouseRightButtonDown="OnListRightClickSelect">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="チェックアウト（detached）" Click="OnTagCheckout" />
                                        <MenuItem Header="プッシュ" Click="OnTagPush" />
                                        <MenuItem Header="タグ名をコピー" Click="OnTagCopyName" />
                                        <Separator />
                                        <MenuItem Header="削除" Click="OnTagDelete" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Subject}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TargetShortHash}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"
                                                       FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- リモート一覧。行の右クリックで URL 変更・削除、見出しの「＋」で追加。
                             リモートが1つも無いリポジトリでもこのタブは出す（＝「追加できる場所」がここだと分かる）。 -->
                        <DockPanel Visibility="{Binding EffectiveReferenceTab, Converter={StaticResource EnumToVis},
                                       ConverterParameter=Remotes}">
                            <DockPanel DockPanel.Dock="Top" Margin="8,2,8,2" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0"
                                        Content="＋ 追加" ToolTip="リモートを追加…" Click="OnRemoteAdd" />
                            </DockPanel>
                            <ListBox x:Name="RemoteList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Remotes}"
                                     PreviewMouseRightButtonDown="OnListRightClickSelect">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="URL を変更…" Click="OnRemoteSetUrl" />
                                        <MenuItem Header="URL をコピー" Click="OnRemoteCopyUrl" />
                                        <Separator />
                                        <MenuItem Header="削除…" Click="OnRemoteRemove" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Url}">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                                       FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- サブモジュール一覧（タブ自体がサブモジュールのあるときだけ） -->
                        <DockPanel Visibility="{Binding EffectiveReferenceTab, Converter={StaticResource EnumToVis},
                                       ConverterParameter=Submodules}">
                            <DockPanel DockPanel.Dock="Top" Margin="8,2,8,2" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0"
                                        Content="同期" Click="OnSubmodulesSync" />
                            </DockPanel>
                            <ListBox x:Name="SubmoduleList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Submodules}"
                                     PreviewMouseRightButtonDown="OnListRightClickSelect">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="初期化" Click="OnSubmoduleInit" />
                                        <MenuItem Header="更新" Click="OnSubmoduleUpdate" />
                                        <Separator />
                                        <MenuItem Header="パスをコピー" Click="OnSubmoduleCopyPath" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" ToolTip="{Binding Describe}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="#FFE5A23B" Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShortHash}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"
                                                       FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        </Grid>
                    </DockPanel>
                    </Grid>
                </DockPanel>

                <GridSplitter x:Name="BranchSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Border}" />

                <!-- コミットグラフ＋詳細。詳細はグラフの「右」に縦に置く（変更ファイル一覧が上・
                     コミットコメントが下）。ファイルのパスは横に長いので、下段の横帯より
                     右の縦列の方がフォルダ構造ごと収まる。Git ペインのタイトル領域のトグルで
                     表示/非表示を切り替えられる（非表示時は列の幅ごと畳む＝ApplyCommitDetailVisibility）。 -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition x:Name="CommitDetailSplitterColumn" Width="6" />
                        <ColumnDefinition x:Name="CommitDetailColumn" Width="300" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <!-- コミットグラフ本体（Column 0）。パス履歴の絞り込み帯を上に載せるため、一覧と列幅
                         ドラッグ用オーバーレイ（両者は同座標で重ねる必要がある）を DockPanel でまとめる。 -->
                    <DockPanel Grid.Column="0">
                    <!-- ファイル／フォルダの履歴に絞っている間だけ出すスコープ帯（「✕」で解除）。 -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,2" Padding="8,4"
                            Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding History.IsPathScoped, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0"
                                    Content="✕ 解除" Command="{Binding History.ClearPathScopeCommand}"
                                    ToolTip="パスの履歴絞り込みを解除して全コミットを表示" />
                            <TextBlock DockPanel.Dock="Left" Text="履歴:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource FgDim}" />
                            <TextBlock Text="{Binding History.PathScopeLabel}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource Fg}"
                                       ToolTip="{Binding History.PathScopeLabel}" />
                        </DockPanel>
                    </Border>
                    <Grid>
                    <!-- 列幅は列境界をドラッグして調整できる（日時・作者が固定幅でコミットメッセージを
                         圧迫し、狭いペインで見出しがほぼ読めなくなる問題への対処）。ここの Width は
                         初期値で、幅の余りは先頭列（コミット）が吸って一覧の右端まで埋める
                         ＝ID の右境界は常に詳細列の GridSplitter と重なる
                         （GitSessionView.LogColumnResize.cs）。 -->
                    <ListView x:Name="LogList" Style="{StaticResource GitList}"
                             ItemContainerStyle="{StaticResource GitLogListItem}"
                             ItemsSource="{Binding History.LogView}"
                             SelectedItem="{Binding History.SelectedLogRow, Mode=TwoWay}"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.ScrollChanged="OnLogScrollChanged"
                             PreviewKeyDown="OnLogListKeyDown"
                             LostKeyboardFocus="OnLogListLostFocus"
                             MouseDoubleClick="OnCommitShowDiff"
                             PreviewMouseRightButtonDown="OnListRightClickSelect"
                             ContextMenuOpening="OnCommitContextMenuOpening"
                             FontFamily="Cascadia Mono, Consolas">
                        <ListView.View>
                            <GridView>
                                <!-- 左列（ブランチ一覧）の開閉ボタンはここには置かない。操作バーの
                                     いちばん上が持ち場で、畳んでいる間もバーごと残る＝戻す入口が
                                     消えない（見出しに置くと、開閉の対象と押す場所が離れていた）。 -->
                                <GridViewColumn Header="コミット" Width="380">
                                    <GridViewColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource Fs11}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.HeaderTemplate>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- グラフ｜参照バッジ｜件名。参照は1色のテキストだと
                                                 ブランチ・リモート・タグが混ざって読めないので、種類で
                                                 色分けした丸バッジにし、HEAD が指しているものには
                                                 印を付ける（＝いま自分が居る行が一目で分かる）。
                                                 切れた件名は列境界をドラッグしないと読めないので、全文は
                                                 ツールチップで出す（継続行は null ＝ツールチップを出さない）。 -->
                                            <DockPanel LastChildFill="True"
                                                       ToolTip="{Binding ToolTipText, Mode=OneWay}">
                                                <!-- 枝は git の文字グラフではなく描いて出す。自分が
                                                     何行目かはコントロールが自分で引き当てる（グラフは行では
                                                     なく一覧の並びに属する情報なので、行のバインディングでは
                                                     取れない）＝CommitGraphCell。 -->
                                                <local:CommitGraphCell DockPanel.Dock="Left" />
                                                <!-- 参照が多い行で件名を押し出さないよう上限を置き、はみ出しは切る
                                                     （読みたいのは件名の方）。左の余白は各バッジが持つので、
                                                     参照が0件の行には隙間が出ない。 -->
                                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding RefLabels, Mode=OneWay}"
                                                              MaxWidth="200" ClipToBounds="True"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- 太さはローカル値で置かない。ローカル値はスタイルの
                                                                 トリガーに勝つので、HEAD の強調が一生効かなくなる。 -->
                                                            <Border CornerRadius="3" Margin="6,0,0,0" Padding="4,0"
                                                                    BorderBrush="{Binding Kind, Converter={StaticResource GitRefKindBrush}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers>
                                                                            <!-- いま HEAD が指している参照＝自分が居る場所 -->
                                                                            <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                           FontSize="{DynamicResource Fs10}"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Segoe UI"
                                                                           Foreground="{Binding Kind, Converter={StaticResource GitRefKindBrush}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Subject, Mode=OneWay}" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="日時" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Date}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="作成者" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Author}" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- ID（短縮ハッシュ）は最後。件名の頭を占領していたのを末尾へ移した。 -->
                                <GridViewColumn Header="ID" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- 短縮ハッシュに対する全文はツールチップで（コピーは右クリックから）。 -->
                                            <TextBlock Text="{Binding ShortHash, Mode=OneWay}"
                                                       FontSize="{DynamicResource Fs11}"
                                                       ToolTip="{Binding Hash, Mode=OneWay}"
                                                       Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <!-- コミット行の右クリック。よく押す順（見る→ここから作る→取り込む）に上から並べ、
                             同じ問いの変種（リセットの3段階・コピーの各項目・取り込み方）は子メニューへ畳んで、
                             最上位は「何をしたいか」の粒度だけにする。選択数・ファイル履歴・GitHub の有無で
                             出し入れするものは OnCommitContextMenuOpening が切り替える。 -->
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="DIFF ペインで差分を表示（複数選択で範囲比較）" Click="OnCommitShowDiff"
                                          FontWeight="SemiBold" />
                                <!-- ファイル履歴（パス絞り込み）中だけ出す「その頃のこのファイル」。
                                     OnCommitContextMenuOpening が表示を切り替える。 -->
                                <Separator x:Name="FileRevisionSeparator" />
                                <MenuItem x:Name="FileRevisionMenuItem" Header="この版のファイル">
                                    <MenuItem Header="エディタで開く" Click="OnCommitOpenFileRevision" />
                                    <MenuItem Header="現在のファイルと比較" Click="OnCommitCompareFileRevision" />
                                    <MenuItem Header="この版の内容へ戻す…" Click="OnCommitRestoreFileRevision" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="ここから作成">
                                    <MenuItem Header="新しいブランチ…（作成して切り替え）" Click="OnCommitCreateBranch" />
                                    <MenuItem Header="タグ…" Click="OnCommitCreateTag" />
                                </MenuItem>
                                <MenuItem Header="チェックアウト（detached HEAD）" Click="OnCommitCheckout" />
                                <Separator />
                                <MenuItem Header="現在のブランチへ取り込む">
                                    <MenuItem Header="チェリーピック" Click="OnCommitCherryPick" />
                                    <MenuItem Header="チェリーピック（コミットせず作業ツリーへ）"
                                              Click="OnCommitCherryPickNoCommit" />
                                    <Separator />
                                    <MenuItem Header="リバート（打ち消しコミットを作成）" Click="OnCommitRevert" />
                                    <MenuItem Header="リバート（コミットせず作業ツリーへ）"
                                              Click="OnCommitRevertNoCommit" />
                                </MenuItem>
                                <!-- 履歴が書き換わる操作はここへまとめる（押す前に「書き換える」と読める位置に置く）。
                                     スカッシュは2件以上、インタラクティブリベースは単一選択のときだけ出す。 -->
                                <MenuItem Header="履歴を書き換える">
                                    <MenuItem Header="コミットメッセージを修正…" Click="OnCommitRewriteMessage" />
                                    <MenuItem x:Name="InteractiveRebaseMenuItem"
                                              Header="ここからインタラクティブリベース…" Click="OnCommitInteractiveRebase" />
                                    <MenuItem x:Name="SquashMenuItem"
                                              Header="選択したコミットをスカッシュ（1つにまとめる）…" Click="OnCommitSquash" />
                                    <Separator />
                                    <MenuItem Header="ここまでリセット">
                                        <MenuItem Header="soft（コミットだけ取り消す）" Click="OnCommitResetSoft" />
                                        <MenuItem Header="mixed（ステージも取り消す）" Click="OnCommitResetMixed" />
                                        <MenuItem Header="hard（作業ツリーごと捨てる）…" Click="OnCommitResetHard" />
                                    </MenuItem>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="FilterByAuthorMenuItem" Header="この作者のコミットだけ表示"
                                          Click="OnCommitFilterByAuthor" />
                                <Separator />
                                <MenuItem x:Name="OpenOnHostingMenuItem" Header="GitHub で開く"
                                          Click="OnCommitOpenOnHosting" />
                                <MenuItem Header="パッチ">
                                    <MenuItem Header="エディタで開く" Click="OnCommitOpenPatch" />
                                    <MenuItem Header="クリップボードへコピー" Click="OnCommitCopyPatch" />
                                </MenuItem>
                                <MenuItem Header="コピー">
                                    <MenuItem Header="ハッシュ" Click="OnCommitCopyHash" />
                                    <MenuItem Header="短縮ハッシュ" Click="OnCommitCopyShortHash" />
                                    <MenuItem Header="件名" Click="OnCommitCopySubject" />
                                    <MenuItem Header="作成者" Click="OnCommitCopyAuthor" />
                                    <MenuItem Header="ハッシュと件名" Click="OnCommitCopySummary" />
                                    <MenuItem x:Name="CopyHostingUrlMenuItem" Header="GitHub のリンク"
                                              Click="OnCommitCopyHostingUrl" />
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <!-- 列幅ドラッグをヘッダー行の細い当たり判定に限定せず、一覧本体からも行える
                         ようにするオーバーレイ（GitSessionView.LogColumnResize.cs が組み立て・追従）。
                         背景は敢えて未設定（null）にして、つまみ以外の透過部分はクリックを
                         下の行へそのまま通す（Background="Transparent" は当たり判定を奪うので使わない）。 -->
                    <Canvas x:Name="LogColumnResizeOverlay" />
                    </Grid>
                    </DockPanel>

                    <GridSplitter x:Name="CommitDetailSplitter" Grid.Column="1" Width="6"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{DynamicResource Border}" />

                    <!-- 選択コミットの詳細。上＝変更ファイル一覧（フォルダ構造つき）、
                         下＝コミットの情報（サマリ「12 ファイル +34 -5」とコミットコメント）。
                         一覧が主役なので最上段を丸ごと一覧に使い、サマリは見出しとして一覧の
                         上に載せず、下段の情報帯の先頭へ回す。 -->
                    <Grid x:Name="CommitDetailPanel" Grid.Column="2" Background="{DynamicResource BgAlt}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="60" />
                            <RowDefinition Height="6" />
                            <!-- 下段はサマリ1行ぶん背が高くなったので最小高もその分だけ上げる
                                 （縮めきったときにコメントが完全に潰れないように）。 -->
                            <RowDefinition Height="1*" MinHeight="64" />
                        </Grid.RowDefinitions>

                        <TreeView x:Name="CommitFileList" Grid.Row="0" Margin="0,2,0,0"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource Fg}"
                                  ItemsSource="{Binding History.CommitFiles}"
                                  ItemContainerStyle="{StaticResource BranchTreeItem}"
                                  ItemTemplate="{StaticResource CommitFileNodeTemplate}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseRightButtonDown="OnListRightClickSelect"
                                  ContextMenuOpening="OnCommitFileContextMenuOpening"
                                  MouseDoubleClick="OnCommitFileDoubleClick">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="差分を別ウィンドウで表示" Click="OnCommitFileDiffWindow"
                                              FontWeight="SemiBold" />
                                    <MenuItem Header="エディタで開く" Click="OnCommitFileOpen" />
                                    <MenuItem Header="パスをコピー" Click="OnCommitFileCopyPath" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource Border}" />

                        <!-- コミットの情報。上＝サマリ（「変更ファイル 12 ファイル +34 -5」）、
                             下＝コミットコメント（件名・本文と、その下にハッシュ／作者／日時の1行）。
                             サマリは一覧が空のときも帯として残す（詳細列がどこの何なのかが常に
                             分かるように）。コメントは選択・コピーできるよう読み取り専用の TextBox に
                             する（狭い列なので折り返す）。 -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Margin="8,4,8,2"
                                       FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis">
                                <Run Text="変更ファイル" /><Run Text="  " /><Run
                                    Text="{Binding History.CommitFileSummary, Mode=OneWay}"
                                    FontWeight="Normal" />
                            </TextBlock>
                            <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Text="{Binding History.CommitMessage, Mode=OneWay}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                                     Foreground="{DynamicResource Fg}" Padding="6,4"
                                     BorderThickness="0" Background="Transparent" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
