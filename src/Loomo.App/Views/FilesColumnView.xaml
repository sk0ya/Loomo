<UserControl x:Class="sk0ya.Loomo.App.Views.FilesColumnView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
    Background="{DynamicResource Panel}">

    <UserControl.Resources>
        <!-- 列幅は見出しと行で必ず同じ値を使う（別々に書くと片方だけ直って列がずれる）。
             名前列だけ可変（*）で、残り3列はここで決めた固定幅。 -->
        <GridLength x:Key="FilesSizeWidth">86</GridLength>
        <GridLength x:Key="FilesModifiedWidth">124</GridLength>
        <GridLength x:Key="FilesTypeWidth">72</GridLength>
        <!-- 行と見出しの右端に空ける幅。重ねて描く縦スクロールバー（7px）の下へ
             最終列の文字が潜らないようにするためのもので、見出し・行の両方に同じ値を入れる。 -->
        <Thickness x:Key="FilesRowInset">0,0,8,0</Thickness>

        <Style x:Key="FilesToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilesToolToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- パンくず・場所ポップアップの1行。 -->
        <Style x:Key="FilesCrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- パンくずピッカー。標準 TreeViewItem は OS の選択色・矢印・背景を使うため、
             テーマを切り替えるとポップアップだけ色が浮く。FolderTree と同じパレットで描く。 -->
        <Style x:Key="FilesBreadcrumbTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Grid.Row="0" Background="Transparent" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  ClickMode="Press" Focusable="False"
                                                  IsChecked="{Binding IsExpanded,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="Arrow" Width="8" Height="8"
                                                          Stretch="Uniform" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{DynamicResource FgDim}"
                                                          Data="M0,0 L4,4 L0,8 Z" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Fg}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                      ContentSource="Header"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="16,0,0,0"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                <ItemsPresenter x:Name="ItemsHost" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列見出し。押すとその列で並べ替え（同じ列を押すと向きが反転）。 -->
        <Style x:Key="FilesColumnHeader" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 縦スクロールバーを内容に重ねる（レイアウト幅を取らない）。取ると見出しと行で
             名前列の幅が 7px ずれ、スクロールバーの有無で列がずれて見える。 -->
        <Style x:Key="FilesOverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                       HorizontalAlignment="Right" Width="7" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilesRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="FilesVerticalItemsPanel">
            <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FilesIconItemsPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FilesGroupItemsPanel">
            <local:FilesGroupItemsPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!-- 操作対象のカラムだけ枠をアクセント色にする（2/4カラムのとき、キー操作の行き先を示す）。 -->
    <Border BorderThickness="1" Padding="0,0,0,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <!-- ツールバー：場所／戻る／進む ＋ パンくず ＋ 絞り込み -->
            <DockPanel DockPanel.Dock="Top" Margin="4,2,4,1" LastChildFill="True">
                <!-- Windows エクスプローラーの「場所」ボタン。押すと直下の Expander を開閉する。 -->
                <ToggleButton x:Name="PlacesButton" DockPanel.Dock="Left" Style="{StaticResource FilesToolToggle}"
                              ToolTip="場所（ワークスペース・ピン留め・クイックアクセス・PC）"
                              IsChecked="{Binding IsExpanded, ElementName=PlacesExpander, Mode=TwoWay}">
                    <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.4"
                          StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          Data="M1,3 L5,3 L6.5,4.5 L13,4.5 L13,11.5 L1,11.5 Z" />
                </ToggleButton>

                <Button DockPanel.Dock="Left" Style="{StaticResource FilesToolButton}"
                        Command="{Binding GoBackCommand}" ToolTip="戻る（Alt+←）">
                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M10,2 L4,7 L10,12" />
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource FilesToolButton}"
                        Command="{Binding GoForwardCommand}" ToolTip="進む（Alt+→）">
                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M4,2 L10,7 L4,12" />
                </Button>
                <ComboBox DockPanel.Dock="Right" Width="104" Height="22" Margin="4,0,0,0"
                          ItemsSource="{Binding DisplayModeOptions}"
                          SelectedValue="{Binding DisplayMode, Mode=TwoWay}"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          ToolTip="表示形式を切り替え" />
                <ComboBox DockPanel.Dock="Right" Width="118" Height="22" Margin="4,0,0,0"
                          ItemsSource="{Binding GroupByOptions}"
                          SelectedValue="{Binding GroupBy, Mode=TwoWay}"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          ToolTip="種類・更新日・サイズでグループ化" />
                <ToggleButton x:Name="ColumnsButton" DockPanel.Dock="Right" Style="{StaticResource FilesToolToggle}"
                              Width="34" Content="列" ToolTip="列の表示・幅・順序"
                              IsChecked="{Binding IsColumnSettingsOpen, Mode=TwoWay}" />
                <Popup x:Name="ColumnSettingsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsColumnSettingsOpen, Mode=TwoWay}">
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" Padding="6" Margin="0,2,0,0">
                        <StackPanel MinWidth="250">
                            <TextBlock Text="詳細表示の列" Foreground="{DynamicResource FgDim}"
                                       FontSize="{DynamicResource Fs10}" Margin="2,0,2,4" />
                            <ItemsControl ItemsSource="{Binding ColumnSettings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FilesColumnSetting}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="{Binding Label}"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanHide}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="↑" Style="{StaticResource FilesToolButton}"
                                                    Command="{Binding DataContext.MoveColumnUpCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}" ToolTip="左へ移動" />
                                            <Button Grid.Column="2" Content="↓" Style="{StaticResource FilesToolButton}"
                                                    Command="{Binding DataContext.MoveColumnDownCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}" ToolTip="右へ移動" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="見出しの右端をドラッグすると幅を変更できます。"
                                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                                       TextWrapping="Wrap" Margin="2,5,2,0" />
                        </StackPanel>
                    </Border>
                </Popup>
                <!-- 件数は独立したステータス行にせず、ナビゲーション行へ統合して縦幅を節約する。 -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                           Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                           VerticalAlignment="Center" Margin="8,0,2,0"
                           TextTrimming="CharacterEllipsis" />
                <!-- パンくず（住所欄）。常にドライブから並べる＝フルパスとして読める。
                     狭いときは末尾（現在地）が見えるよう右端へ寄せる。 -->
                <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" ScrollChanged="OnBreadcrumbScrollChanged">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FilesBreadcrumb}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FilesCrumbButton}"
                                            Click="OnBreadcrumbPickerClick"
                                            PreviewMouseLeftButtonDown="OnBreadcrumbPickerMouseDown"
                                            PreviewMouseLeftButtonUp="OnBreadcrumbPickerMouseUp"
                                            Tag="{Binding}"
                                            ToolTip="{Binding FullPath}">
                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                    </Button>
                                    <TextBlock Text="›" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}"
                                               Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 場所一覧。フォルダーアイコンで開閉する本体。最近／頻繁もこの中の通常グループとして表示する。 -->
            <Expander x:Name="PlacesExpander" DockPanel.Dock="Top" IsExpanded="False"
                      Expanded="OnPlacesExpanded" Foreground="{DynamicResource Fg}"
                      Margin="4,0,4,2">
                <!-- 見出しは持たせない。開閉の入口はツールバー左のフォルダーアイコンだけにし、
                     Expander の中身だけをその直下へ配置する。 -->
                <Expander.Template>
                    <ControlTemplate TargetType="Expander">
                        <ContentPresenter x:Name="ExpandSite" ContentSource="Content" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Expander.Template>
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" Padding="4" MaxHeight="420">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Places}" MinWidth="240">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilesPlaceGroup}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PopupSectionLabel}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FilesPlace}">
                                                    <Button Style="{StaticResource FilesCrumbButton}"
                                                            Padding="8,3" HorizontalContentAlignment="Left"
                                                            Click="OnPlaceClick" Tag="{Binding}"
                                                            ToolTip="{Binding FullPath}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{DynamicResource Fs12}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="320" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Expander>

            <!-- パンくず項目を選んだときの VS Code 風ピッカー。兄弟フォルダーをルートにして、
                 子フォルダーは展開矢印から辿れる。 -->
            <Popup x:Name="BreadcrumbPickerPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" Padding="3" MaxHeight="420" MinWidth="260">
                    <TreeView x:Name="BreadcrumbPickerTree" Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource Fg}"
                              ItemContainerStyle="{StaticResource FilesBreadcrumbTreeItem}"
                              PreviewMouseLeftButtonDown="OnBreadcrumbPickerPreviewMouseLeftButtonDown" />
                </Border>
            </Popup>

            <!-- 絞り込みバー。一覧で「/」を押したときだけ出す（常設の入力欄はツールバーの幅を食い、
                 いつも使うものでもない）。エディタと同じく下端に出し、Esc で解除・Enter で一覧へ戻る。
                 絞り込みが効いている間は開いたままにする——閉じてしまうと、虫食いの一覧を見て
                 「ファイルが消えた」と読み違える。 -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="6,2"
                    Visibility="{Binding IsFilterBarOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="/" Foreground="{DynamicResource Accent}"
                               FontFamily="Consolas" FontSize="{DynamicResource Fs12}"
                               VerticalAlignment="Center" Margin="2,0,6,0" />
                    <TextBlock DockPanel.Dock="Right" Text="Esc で解除・Enter で一覧へ"
                               Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                               VerticalAlignment="Center" Margin="8,0,2,0" />
                    <TextBox x:Name="FilterBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" MinHeight="20"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=80}"
                             PreviewKeyDown="OnFilterKeyDown"
                             ToolTip="名前で絞り込み（*.cs のようにワイルドカードも書けます）" />
                </DockPanel>
            </Border>

            <!-- 列見出し -->
            <Grid DockPanel.Dock="Top" Margin="{StaticResource FilesRowInset}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.Details}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.List}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.LargeIcons}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.MediumIcons}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.SmallIcons}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.Tiles}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Slot0Width}" />
                    <ColumnDefinition Width="{Binding Slot1Width}" />
                    <ColumnDefinition Width="{Binding Slot2Width}" />
                    <ColumnDefinition Width="{Binding Slot3Width}" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="{Binding NameColumnIndex}" Tag="Name" Style="{StaticResource FilesColumnHeader}"
                        Visibility="{Binding IsNameColumnVisible, Converter={StaticResource BoolToVis}}"
                        PreviewMouseLeftButtonDown="OnColumnHeaderMouseDown"
                        PreviewMouseMove="OnColumnHeaderMouseMove" PreviewMouseLeftButtonUp="OnColumnHeaderMouseUp"
                        Command="{Binding SortCommand}" CommandParameter="Name"
                        ToolTip="名前で並べ替え（数字は数として読みます）">
                    <TextBlock><Run Text="名前" /><Run Text="{Binding NameSortMark, Mode=OneWay}" /></TextBlock>
                </Button>
                <Button Grid.Column="{Binding SizeColumnIndex}" Tag="Size" Style="{StaticResource FilesColumnHeader}"
                        Visibility="{Binding IsSizeColumnVisible, Converter={StaticResource BoolToVis}}"
                        PreviewMouseLeftButtonDown="OnColumnHeaderMouseDown"
                        PreviewMouseMove="OnColumnHeaderMouseMove" PreviewMouseLeftButtonUp="OnColumnHeaderMouseUp"
                        HorizontalContentAlignment="Right"
                        Command="{Binding SortCommand}" CommandParameter="Size" ToolTip="サイズで並べ替え">
                    <TextBlock><Run Text="サイズ" /><Run Text="{Binding SizeSortMark, Mode=OneWay}" /></TextBlock>
                </Button>
                <Button Grid.Column="{Binding ModifiedColumnIndex}" Tag="Modified" Style="{StaticResource FilesColumnHeader}"
                        Visibility="{Binding IsModifiedColumnVisible, Converter={StaticResource BoolToVis}}"
                        PreviewMouseLeftButtonDown="OnColumnHeaderMouseDown"
                        PreviewMouseMove="OnColumnHeaderMouseMove" PreviewMouseLeftButtonUp="OnColumnHeaderMouseUp"
                        Command="{Binding SortCommand}" CommandParameter="Modified" ToolTip="更新日時で並べ替え">
                    <TextBlock><Run Text="更新日時" /><Run Text="{Binding ModifiedSortMark, Mode=OneWay}" /></TextBlock>
                </Button>
                <Button Grid.Column="{Binding TypeColumnIndex}" Tag="Type" Style="{StaticResource FilesColumnHeader}"
                        Visibility="{Binding IsTypeColumnVisible, Converter={StaticResource BoolToVis}}"
                        PreviewMouseLeftButtonDown="OnColumnHeaderMouseDown"
                        PreviewMouseMove="OnColumnHeaderMouseMove" PreviewMouseLeftButtonUp="OnColumnHeaderMouseUp"
                        Command="{Binding SortCommand}" CommandParameter="Type" ToolTip="種類で並べ替え">
                    <TextBlock><Run Text="種類" /><Run Text="{Binding TypeSortMark, Mode=OneWay}" /></TextBlock>
                </Button>
            </Grid>

            <!-- 一覧本体 -->
            <Grid>
                <ListBox x:Name="EntryList"
                         ItemsSource="{Binding EntriesView}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,1,0,4"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource FilesRow}"
                         AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnSelectionChanged"
                         PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnListPreviewMouseMove"
                         PreviewMouseRightButtonDown="OnListPreviewMouseRightButtonDown"
                         MouseDoubleClick="OnListMouseDoubleClick"
                         PreviewKeyDown="OnListPreviewKeyDown"
                         DragOver="OnListDragOver"
                         Drop="OnListDrop">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="ItemsPanel" Value="{StaticResource FilesVerticalItemsPanel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.LargeIcons}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource FilesIconItemsPanel}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.MediumIcons}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource FilesIconItemsPanel}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.SmallIcons}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource FilesIconItemsPanel}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:FilesDisplayMode.Tiles}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource FilesIconItemsPanel}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer Focusable="False" CanContentScroll="True"
                                              Style="{StaticResource FilesOverlayScrollViewer}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <local:FilesGroupItemsPanel />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgAlt}" Padding="7,3" Margin="0,5,0,1">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name.Label}" Foreground="{DynamicResource FgDim}"
                                                       FontSize="{DynamicResource Fs11}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, StringFormat=({0})}"
                                                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                                                       Margin="8,0,0,0" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <!-- 並びはツリーの右クリックと同じ語彙・同じ順（開く/送る → 作る → 移す → 直す →
                             フォルダー → 写す）。同じ操作が2箇所で違う名前・違う順に並ぶ方が事故になる。
                             書き込み系は で、ワークスペース外では丸ごと消える。 -->
                        <ContextMenu Opened="OnContextMenuOpened">
                            <MenuItem Header="開く" Tag="Single" Click="OnOpenClick" />
                            <MenuItem Header="ブラウザで開く" Tag="Html" Click="OnOpenInBrowserClick" />
                            <MenuItem Header="既定のアプリで開く" Tag="FileOnly" Click="OnOpenWithDefaultAppClick" />
                            <Separator />
                            <MenuItem Header="新規ファイル" Click="OnNewFileClick"
                                      ToolTip="名前と拡張子を選んで作成します" />
                            <MenuItem Header="新規フォルダー" Click="OnNewFolderClick" />
                            <Separator />
                            <MenuItem Header="コピー" InputGestureText="Ctrl+C" Tag="Selection" Click="OnCopyClick" />
                            <MenuItem Header="切り取り" InputGestureText="Ctrl+X" Tag="Selection" Click="OnCutClick" />
                            <MenuItem Header="貼り付け" InputGestureText="Ctrl+V" Click="OnPasteClick" />
                            <MenuItem Header="複製" InputGestureText="Ctrl+D" Tag="Selection" Click="OnDuplicateClick"
                                      ToolTip="同じフォルダーに「 - コピー」を付けて複製します" />
                            <Separator />
                            <MenuItem Header="名前の変更" InputGestureText="F2" Tag="Single" Click="OnRenameClick" />
                            <MenuItem Header="削除" InputGestureText="Delete" Tag="Selection" Click="OnDeleteClick" />
                            <!-- ファイル操作の Undo/Redo（履歴はエクスプローラーのツリーと共有）。
                                 見出しと表示可否は Opened→UpdateHistoryMenuItems が次の一手に合わせる。 -->
                            <Separator />
                            <MenuItem Header="元に戻す" Tag="UndoItem" InputGestureText="Ctrl+Z"
                                      Click="OnUndoFileOperationClick" />
                            <MenuItem Header="やり直す" Tag="RedoItem" InputGestureText="Ctrl+Y"
                                      Click="OnRedoFileOperationClick" />
                            <Separator />
                            <MenuItem Header="エクスプローラーで表示" Tag="Single" Click="OnRevealInExplorerClick" />
                            <MenuItem Header="ターミナルへ送る" Tag="Single" Click="OnSetInTerminalClick"
                                      ToolTip="フォルダーは作業場所に設定し、ファイルはパスを入力します" />
                            <MenuItem Header="Diffへ送る" Tag="FileOnly"
                                      ToolTip="クリップボードや選択したファイルと Diff ペインで見比べます">
                                <MenuItem Header="クリップボードと比較" Click="OnCompareWithClipboardClick" />
                                <MenuItem Header="選択した2つを比較" Tag="CompareTwo" Click="OnCompareSelectedClick"
                                          ToolTip="先に選んだ方を左（旧）、後を右（新）として比較します" />
                            </MenuItem>
                            <MenuItem Header="このフォルダーで検索" Tag="SearchableDir" Click="OnSearchInFolderClick" />
                            <Separator />
                            <MenuItem Header="パスをコピー" Tag="Selection">
                                <MenuItem Header="フルパス" Click="OnCopyPathClick" />
                                <MenuItem Header="相対パス" Click="OnCopyRelativePathClick"
                                          ToolTip="所属するワークスペースフォルダーからの相対パス" />
                                <MenuItem Header="名前" Click="OnCopyNameClick" />
                            </MenuItem>
                            <!-- FolderTree と同じ Git 操作。実際の要求は FolderTreeViewModel の
                                 既存イベントへ流し、Git ペイン／エディタの受け口を共有する。 -->
                            <Separator />
                            <MenuItem Header="Git" Tag="GitMenu">
                                <MenuItem Header="履歴を表示" Click="OnGitHistoryClick" />
                                <MenuItem Header="Git Blame" Tag="GitBlame" Click="OnGitBlameClick" />
                                <MenuItem Header=".gitignore に追加" Tag="GitIgnore" Click="OnAddToGitignoreClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="AI" Tag="AiMenu">
                                <MenuItem Header="要約" Tag="FileAiSummarize" Click="OnFileAiClick" />
                                <MenuItem Header="レビュー" Tag="FileAiReview" Click="OnFileAiClick" />
                                <MenuItem Header="テスト生成" Tag="FileAiGenerateTests" Click="OnFileAiClick" />
                                <MenuItem Header="関連ファイルを検索" Tag="FileAiFindRelated" Click="OnFileAiClick" />
                            </MenuItem>
                            <Separator />
                            <!-- ピンの実体はツリーと同じ（IFolderPinStore）。 -->
                            <MenuItem Header="ルートにピン留め" Tag="Pinnable" Click="OnPinClick" />
                            <MenuItem Header="ピン留めを解除" Tag="Unpinnable" Click="OnUnpinClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileEntryViewModel}">
                            <Grid Background="Transparent">
                                <!-- 詳細：既存の4列レイアウト。見出しと同じ幅リソースを使う。 -->
                                <Grid x:Name="DetailsLayout" Visibility="Collapsed" Height="24"
                                      Margin="{StaticResource FilesRowInset}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DataContext.Slot0Width, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <ColumnDefinition Width="{Binding DataContext.Slot1Width, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <ColumnDefinition Width="{Binding DataContext.Slot2Width, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <ColumnDefinition Width="{Binding DataContext.Slot3Width, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="{Binding DataContext.NameColumnIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding DataContext.IsNameColumnVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                Orientation="Horizontal" Margin="6,0,4,0">
                                        <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0"
                                               VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                        <TextBlock Text="{Binding GitStatusBadge}"
                                                   Foreground="{Binding GitStatus, Converter={StaticResource GitStatusBrush}}"
                                                   Visibility="{Binding GitStatusBadge, Converter={StaticResource EmptyToVis}}"
                                                   ToolTip="{Binding GitStatusTooltip}" Margin="0,0,4,0"
                                                   FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs12}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="{Binding DataContext.SizeColumnIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Visibility="{Binding DataContext.IsSizeColumnVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding SizeText}" HorizontalAlignment="Right"
                                               Margin="0,0,8,0" VerticalAlignment="Center" FontSize="{DynamicResource Fs11}" />
                                    <TextBlock Grid.Column="{Binding DataContext.ModifiedColumnIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Visibility="{Binding DataContext.IsModifiedColumnVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding ModifiedText}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" FontSize="{DynamicResource Fs11}" />
                                    <TextBlock Grid.Column="{Binding DataContext.TypeColumnIndex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Visibility="{Binding DataContext.IsTypeColumnVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding TypeText}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" FontSize="{DynamicResource Fs11}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- 一覧：縦方向の1行。 -->
                                <StackPanel x:Name="ListLayout" Visibility="Collapsed" Orientation="Horizontal"
                                            Height="24" Margin="6,0,4,0">
                                    <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GitStatusBadge}"
                                               Foreground="{Binding GitStatus, Converter={StaticResource GitStatusBrush}}"
                                               Visibility="{Binding GitStatusBadge, Converter={StaticResource EmptyToVis}}"
                                               ToolTip="{Binding GitStatusTooltip}" Margin="0,0,4,0"
                                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- アイコン系：WrapPanel 内で幅を持つため、選択・右クリック・ダブルクリックは
                                     ListBoxItem の既存イベント経路をそのまま使える。 -->
                                <StackPanel x:Name="LargeIconsLayout" Visibility="Collapsed" Width="112" Height="112"
                                            Margin="4,6" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconImage}" Width="64" Height="64" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="2,6,2,0">
                                        <TextBlock Text="{Binding GitStatusBadge}"
                                                   Foreground="{Binding GitStatus, Converter={StaticResource GitStatusBrush}}"
                                                   Visibility="{Binding GitStatusBadge, Converter={StaticResource EmptyToVis}}"
                                                   ToolTip="{Binding GitStatusTooltip}" Margin="0,0,3,0"
                                                   FontFamily="Consolas" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="{DynamicResource Fs12}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="MediumIconsLayout" Visibility="Collapsed" Width="92" Height="94"
                                            Margin="4,5" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconImage}" Width="40" Height="40" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="2,5,2,0">
                                        <TextBlock Text="{Binding GitStatusBadge}"
                                                   Foreground="{Binding GitStatus, Converter={StaticResource GitStatusBrush}}"
                                                   Visibility="{Binding GitStatusBadge, Converter={StaticResource EmptyToVis}}"
                                                   ToolTip="{Binding GitStatusTooltip}" Margin="0,0,3,0"
                                                   FontFamily="Consolas" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="{DynamicResource Fs12}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="SmallIconsLayout" Visibility="Collapsed" Width="76" Height="58"
                                            Margin="3,4" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconImage}" Width="24" Height="24" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="2,3,2,0">
                                        <TextBlock Text="{Binding GitStatusBadge}"
                                                   Foreground="{Binding GitStatus, Converter={StaticResource GitStatusBrush}}"
                                                   Visibility="{Binding GitStatusBadge, Converter={StaticResource EmptyToVis}}"
                                                   ToolTip="{Binding GitStatusTooltip}" Margin="0,0,3,0"
                                                   FontFamily="Consolas" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="28" FontSize="{DynamicResource Fs11}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- タイル：アイコンと代表的な属性を横並びにする。 -->
                                <Grid x:Name="TilesLayout" Visibility="Collapsed" Width="220" Height="64" Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconImage}" Width="32" Height="32" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="6,0,3,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding GitStatusBadge}"
                                                       Foreground="{Binding GitStatus, Converter={StaticResource GitStatusBrush}}"
                                                       Visibility="{Binding GitStatusBadge, Converter={StaticResource EmptyToVis}}"
                                                       ToolTip="{Binding GitStatusTooltip}" Margin="0,0,3,0"
                                                       FontFamily="Consolas" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource Fs12}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" />
                                        <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="{x:Static vm:FilesDisplayMode.Details}">
                                    <Setter TargetName="DetailsLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="{x:Static vm:FilesDisplayMode.List}">
                                    <Setter TargetName="ListLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="{x:Static vm:FilesDisplayMode.LargeIcons}">
                                    <Setter TargetName="LargeIconsLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="{x:Static vm:FilesDisplayMode.MediumIcons}">
                                    <Setter TargetName="MediumIconsLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="{x:Static vm:FilesDisplayMode.SmallIcons}">
                                    <Setter TargetName="SmallIconsLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="{x:Static vm:FilesDisplayMode.Tiles}">
                                    <Setter TargetName="TilesLayout" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource FgDim}"
                           FontSize="{DynamicResource Fs12}" HorizontalAlignment="Center" Margin="0,24,0,0"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
