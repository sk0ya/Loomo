<UserControl x:Class="sk0ya.Loomo.App.Views.HttpRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
             Background="{DynamicResource Panel}"
             TextElement.Foreground="{DynamicResource Fg}"
             FontSize="{DynamicResource Fs12}">
    <!-- .http パネル（§24.30）。上がファイルの中のリクエスト（▶ で送る）、下が選んだリクエストの最後の応答。
         送受信と応答は HttpEditorSupport（工場）が持つので、ここは映すだけ。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- 行の選択は既定のシステム色を出さず、一覧の他の面と同じ「淡い面＋左のバー」で描く。 -->
        <Style x:Key="RequestItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Height="24">
                            <Grid>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="1,4"
                                        HorizontalAlignment="Left" Background="Transparent" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="48" />
            <RowDefinition Height="4" />
            <RowDefinition Height="2*" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- リクエストの一覧 -->
        <ListBox x:Name="RequestList" Grid.Row="0"
                 ItemsSource="{Binding Requests}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource RequestItem}"
                 Background="Transparent" BorderThickness="0" Padding="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 KeyDown="OnRequestListKeyDown"
                 AutomationProperties.AutomationId="HttpRequestList">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HttpRequestRowViewModel}">
                    <Grid Margin="6,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- ▶ 送る／■ 取り消す。送るのは押したときだけ（開いた・書いただけでは送らない）。 -->
                        <Button x:Name="SendButton" Grid.Column="0" Style="{DynamicResource PaneHeaderGhostButton}"
                                Width="20" Height="20" Padding="0"
                                Command="{Binding DataContext.SendCommand, ElementName=RequestList}"
                                CommandParameter="{Binding}"
                                ToolTip="送る（Enter）"
                                AutomationProperties.Name="送る">
                            <TextBlock x:Name="SendGlyph" Text="▶" FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource Success}" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding Method}" FontWeight="SemiBold"
                                   FontFamily="Consolas, Cascadia Mono" Margin="2,0,8,0"
                                   Foreground="{DynamicResource SymMethod}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                   FontFamily="Consolas, Cascadia Mono" VerticalAlignment="Center"
                                   ToolTip="{Binding Url}" />
                        <TextBlock Grid.Column="3" Text="{Binding Label}" Margin="8,0,0,0"
                                   Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Badge" Grid.Column="4" Text="{Binding StatusBadge}" Margin="8,0,0,0"
                                   FontFamily="Consolas, Cascadia Mono" FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                            <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Error}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="SendGlyph" Property="Text" Value="■" />
                            <Setter TargetName="SendGlyph" Property="Foreground" Value="{DynamicResource Error}" />
                            <Setter TargetName="SendButton" Property="ToolTip" Value="取り消す" />
                            <Setter TargetName="Badge" Property="Text" Value="…" />
                            <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource FgDim}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="0" Margin="12,10" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"
                   Text="このファイルにはまだリクエストがありません。&#x0a;GET https://example.com/api のように書くと、ここに並んで ▶ で送れます（### で区切って複数書けます）。" />

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="4"
                      Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext" />

        <!-- 応答 -->
        <DockPanel Grid.Row="2">
            <!-- 1行目は状態と所要時間だけ。ボタンと同じ行に置くと、EditorSupport が細いときに
                 いちばん大事な「200 OK」がボタンに押し潰される。 -->
            <DockPanel DockPanel.Dock="Top" Margin="8,5,6,1" LastChildFill="True">
                <TextBlock x:Name="StatusText" Text="{Binding ResultStatus}" FontWeight="SemiBold"
                           FontFamily="Consolas, Cascadia Mono" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResultFailure}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ResultMeta}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="8,0,6,2" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <ToggleButton Style="{DynamicResource SegmentToggle}" Content="ヘッダー"
                                  IsChecked="{Binding ShowHeaders, Mode=TwoWay}" Margin="0,0,4,0"
                                  ToolTip="本文とヘッダーを切り替える" />
                    <Button Style="{DynamicResource PaneHeaderGhostButton}" Content="ペグボードへ"
                            Command="{Binding PinToPegboardCommand}" Margin="0,0,2,0"
                            ToolTip="リクエスト行と応答を、出典付きでペグボードへ残す" />
                    <Button Style="{DynamicResource PaneHeaderGhostButton}" Content="エディタで開く"
                            Command="{Binding OpenInEditorCommand}" Margin="0,0,2,0"
                            ToolTip="本文を新しいエディタタブで開く（全文・整形済み）" />
                    <Button Style="{DynamicResource PaneHeaderGhostButton}" Content="コピー"
                            Command="{Binding CopyBodyCommand}"
                            ToolTip="いま見ている本文（またはヘッダー）をコピー" />
                </StackPanel>
                <!-- 送った先（変数を解決した後の URL）。細いときはここから省略する。 -->
                <TextBlock Text="{Binding ResultRequestLine}" VerticalAlignment="Center"
                           FontFamily="Consolas, Cascadia Mono" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ResultRequestLine}" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="8,0,8,3" Text="{Binding ResultWarning}"
                       Foreground="{DynamicResource Error}" FontSize="{DynamicResource Fs11}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultWarning}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid>
                <!-- 本文の URL：Ctrl+クリックでブラウザペインへ、右クリックで .http へ GET を書き足す（§24.30.1）。 -->
                <TextBox x:Name="ResponseBody" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                         PreviewMouseLeftButtonUp="OnResponseBodyMouseUp"
                         ContextMenuOpening="OnResponseBodyContextMenuOpening"
                         FontFamily="Consolas, Cascadia Mono, MS Gothic" FontSize="{DynamicResource Fs12}"
                         Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
                         BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}" Padding="6,4"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}"
                         AutomationProperties.AutomationId="HttpResponseBody">
                    <!-- 中身は開くたびに OnResponseBodyContextMenuOpening が詰める（URL の上なら行き先を足す）。 -->
                    <TextBox.ContextMenu>
                        <ContextMenu />
                    </TextBox.ContextMenu>
                    <!-- 本文は折り返さない（JSON の字下げを崩さない）。送れなかった理由の文は折り返す。 -->
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResultError}" Value="True">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Margin="12,8" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                           Text="リクエストの ▶ を押すと、ここに応答が出ます。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
