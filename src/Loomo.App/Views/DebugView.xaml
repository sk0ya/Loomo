<UserControl x:Class="sk0ya.Loomo.App.Views.DebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    xmlns:v="clr-namespace:sk0ya.Loomo.App.Views"
    xmlns:dbg="clr-namespace:sk0ya.Loomo.Core.Debug;assembly=sk0ya.Loomo.Core"
    Background="{DynamicResource BgAlt}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DebugStderr" Color="#E06C75" />

        <!-- インラインタブ（自動・コールスタック）の項目コピー。x:Shared="False" で参照ごとに別インスタンス。 -->
        <ContextMenu x:Key="CopyItemMenu" x:Shared="False">
            <MenuItem Header="コピー" Click="OnCopyItemClick" />
        </ContextMenu>

        <!-- 検査タブ（出力／変数／…／構成）。下線で選択を示すフラットなタブ。 -->
        <Style x:Key="DebugTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="10,5" Margin="0,0,2,0"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DebugTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <!-- タブが増えても折り返さず横スクロールで送る（タブより上には何も足さない）。 -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              PanningMode="HorizontalOnly">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="4,2,4,0" />
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 実行タブのプロジェクト一覧。選択状態を主役にし、行の右端にだけ実行ボタンを出す。 -->
        <Style x:Key="ProjectTabItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ヘッダ（IDE ラベル・状態・デバッグツールバー）はホスト（ペインヘッダ）側が出す。日常の起動は
         「実行」タブ、停止中の変数・スレッド等は「デバッグ」タブ、詳細設定は「構成」タブにまとめる。 -->
    <DockPanel>
        <TabControl x:Name="DebugTabs" Style="{StaticResource DebugTabControl}"
                    Margin="6,0,6,6" SelectedIndex="0" SelectionChanged="OnDebugTabChanged">

            <!-- 0 実行：プロジェクト一覧と直近の出力を同じ画面に置く。 -->
            <TabItem x:Name="ExecutionTab" Style="{StaticResource DebugTabItem}" Header="実行">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="150" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="プロジェクト" Foreground="{DynamicResource FgDim}"
                                       FontSize="{DynamicResource Fs11}" Margin="6,6,6,3" />
                            <TextBlock DockPanel.Dock="Top" Text="クリック／Enter／ダブルクリックでデバッグ開始"
                                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                                       TextWrapping="Wrap" Margin="6,0,6,5" />
                            <Grid>
                                <ListBox ItemsSource="{Binding Profiles.AvailableProjects}"
                                         SelectedItem="{Binding Profiles.SelectedProject, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                                         ItemContainerStyle="{StaticResource ProjectTabItem}"
                                         HorizontalContentAlignment="Stretch"
                                         MouseDoubleClick="OnProjectDoubleClick" KeyDown="OnProjectKeyDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="{DynamicResource Fs12}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                <Button Grid.Column="1" Content="▶" Width="22" Height="20" Padding="0"
                                                        Margin="4,0,0,0" VerticalAlignment="Center"
                                                        FontSize="{DynamicResource Fs10}"
                                                        Command="{Binding DataContext.Launch.RunProjectCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="このプロジェクトをデバッグ実行">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="C# プロジェクトが見つかりません" Foreground="{DynamicResource FgDim}"
                                           FontSize="{DynamicResource Fs11}" TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profiles.AvailableProjects.Count}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{DynamicResource Border}" />

                    <Border Grid.Column="2" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="4,2,4,2">
                                <Button DockPanel.Dock="Left" Content="▶ 実行" Style="{StaticResource FlatButton}"
                                        Height="22" Padding="9,0" Margin="0,2,8,2"
                                        Command="{Binding Launch.RunSelectedProjectCommand}" ToolTip="選択中のプロジェクトをデバッグ実行" />
                                <Button DockPanel.Dock="Right" Content="クリア" Style="{StaticResource SecondaryButton}"
                                        Height="22" Padding="8,0" Margin="0,2,0,2" Click="OnClearOutputClick" />
                                <TextBlock DockPanel.Dock="Left" Text="出力" Foreground="{DynamicResource FgDim}"
                                           FontSize="{DynamicResource Fs11}" VerticalAlignment="Center" />
                            </DockPanel>
                            <RichTextBox x:Name="ConsoleBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         IsDocumentEnabled="True" Background="Transparent" Padding="6,4"
                                         Foreground="{DynamicResource Fg}" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="{DynamicResource Fs12}"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <RichTextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="コピー" Command="Copy" />
                                        <MenuItem Header="すべて選択" Command="SelectAll" />
                                    </ContextMenu>
                                </RichTextBox.ContextMenu>
                            </RichTextBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 1 問題：ビルド系コマンド出力から抽出したエラー/警告。デバッグセッション非依存。 -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="問題">
                <v:DebugProblemsView DataContext="{Binding Problems}" />
            </TabItem>

            <!-- 2 デバッグ検査：セッション中だけ表示し、変数・スレッド等の詳細タブをここへまとめる。 -->
            <TabItem x:Name="DebugTabItem" Style="{StaticResource DebugTabItem}" Header="デバッグ"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TabControl x:Name="InspectionTabs" Style="{StaticResource DebugTabControl}" SelectedIndex="0">

            <!-- 変数（＋ウォッチ） -->
            <TabItem x:Name="VariablesTabItem" Style="{StaticResource DebugTabItem}" Header="変数">
                <v:DebugVariablesView DataContext="{Binding Inspection}" />
            </TabItem>

            <!-- 4 自動（Autos）：停止行とその直前行で使われている変数だけを近似表示する。 -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="自動">
                <Grid Margin="0,4,0,0">
                    <ListBox ItemsSource="{Binding Inspection.Autos}" Background="{DynamicResource Bg}"
                             BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource Fg}"
                             HorizontalContentAlignment="Stretch"
                             ToolTip="現在行とその直前行で使われている変数（ベストエフォート）"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WatchItemViewModel}">
                                <Grid Margin="0,1" ContextMenu="{StaticResource CopyItemMenu}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Expression}" FontSize="{DynamicResource Fs11}" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource Fs11}" FontFamily="Consolas"
                                               Foreground="{DynamicResource Accent}" Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="停止すると自動変数が表示されます" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs11}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsStopped, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="この行に表示できる変数がありません" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs11}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsStopped}" Value="True" />
                                            <Condition Binding="{Binding Inspection.HasAutos}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- 5 コールスタック -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="コールスタック">
                <Grid Margin="0,4,0,0">
                    <ListBox ItemsSource="{Binding Inspection.CallStack}" SelectedItem="{Binding Inspection.SelectedFrame, Mode=TwoWay}"
                             Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                             Foreground="{DynamicResource Fg}"
                             MouseDoubleClick="OnCallStackDoubleClick"
                             ToolTip="クリックでソースをプレビュー、ダブルクリックでジャンプ"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DebugFrameViewModel}">
                                <StackPanel Orientation="Horizontal" ContextMenu="{StaticResource CopyItemMenu}">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs11}" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}" FontSize="{DynamicResource Fs11}" Opacity="0.6" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="停止するとコールスタックが表示されます" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs11}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsStopped, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </TabItem>

            <!-- 6 スレッド：停止時に実行中スレッドを並べ、選択でアクティブ（コールスタック/ステップの対象）を切替。 -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="スレッド">
                <Grid Margin="0,4,0,0">
                    <ListBox ItemsSource="{Binding Inspection.Threads}" SelectedItem="{Binding Inspection.SelectedThread, Mode=TwoWay}"
                             Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                             Foreground="{DynamicResource Fg}"
                             ToolTip="選択でそのスレッドのコールスタック・変数に切り替える"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dbg:DebugThread}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontSize="{DynamicResource Fs11}" FontFamily="Consolas"
                                               Foreground="{DynamicResource FgDim}" Width="40" />
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs11}" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="停止するとスレッドが表示されます" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs11}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsStopped, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </TabItem>

            <!-- 8 ブレークポイント -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="ブレークポイント">
                <v:DebugBreakpointsView DataContext="{Binding Breakpoints}" />
            </TabItem>

            <!-- 9 イミディエイト -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="イミディエイト">
                <v:DebugImmediateView DataContext="{Binding Inspection}" />
            </TabItem>

            <!-- 10 モジュール：ロード済みアセンブリ一覧（停止時に取得、更新で読み直し）。 -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="モジュール">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,4">
                        <Button Content="更新" Style="{StaticResource SecondaryButton}" Height="20" Padding="8,0"
                                Command="{Binding Inspection.RefreshModulesCommand}" ToolTip="ロード済みモジュールを取得し直す" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Inspection.Modules}" Background="{DynamicResource Bg}"
                             BorderBrush="{DynamicResource Border}" BorderThickness="1" Foreground="{DynamicResource Fg}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dbg:DebugModule}">
                                <StackPanel Margin="0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs11}" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Version}" FontSize="{DynamicResource Fs10}" Opacity="0.5" Margin="8,1,0,0"
                                                   Visibility="{Binding Version, Converter={StaticResource NonEmptyToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SymbolStatus}" FontSize="{DynamicResource Fs10}" Opacity="0.6"
                                               Foreground="{DynamicResource FgDim}"
                                               Visibility="{Binding SymbolStatus, Converter={StaticResource NonEmptyToVis}}" />
                                    <TextBlock Text="{Binding Path}" FontSize="{DynamicResource Fs10}" Opacity="0.5"
                                               Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Path, Converter={StaticResource NonEmptyToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="停止するとモジュールが表示されます" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs11}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Inspection.HasModules, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </TabItem>

                </TabControl>
            </TabItem>

            <!-- 3 テスト -->
            <TabItem x:Name="TestsTabItem" Style="{StaticResource DebugTabItem}" Header="テスト">
                <v:DebugTestsView DataContext="{Binding Tests}" />
            </TabItem>

            <!-- 4 構成（起動構成・例外・アタッチ）。普段の実行は「実行」タブから行う。 -->
            <TabItem Style="{StaticResource DebugTabItem}" Header="構成">
                <v:DebugConfigView />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
