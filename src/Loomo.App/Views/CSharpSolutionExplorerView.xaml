<UserControl x:Class="sk0ya.Loomo.App.Views.CSharpSolutionExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    Background="Transparent"
    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
    <DockPanel>
        <!-- 見出し行。折りたたみトグル・構成・ビルド/テスト・実行状態。折りたたんでもこの行だけは残す。 -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Panel}" Padding="4,3">
            <DockPanel LastChildFill="True">
                <!-- 折りたたみトグル。▾＝展開中、▸＝折りたたみ中。 -->
                <Button x:Name="SectionToggle" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}"
                        Width="18" Height="18" Padding="0" Margin="0,0,4,0"
                        FontSize="{DynamicResource Fs10}" Content="▾"
                        Click="OnSectionToggleClick"
                        ToolTip="ソリューションツリーを折りたたむ"
                        AutomationProperties.AutomationId="CSharpSolutionSectionToggle"
                        AutomationProperties.Name="C#ソリューションの折りたたみ" />
                <TextBlock DockPanel.Dock="Left" Text="ソリューション" Foreground="{DynamicResource FgDim}"
                           FontSize="{DynamicResource Fs10}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ConfigurationOptions}"
                          SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}"
                          Visibility="{Binding HasMultipleConfigurations, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,4,0" Padding="4,0" MinWidth="62" Height="20"
                          FontSize="{DynamicResource Fs11}"
                          ToolTip="Build／Test／Run／Debugで使う構成を選択"
                          AutomationProperties.AutomationId="CSharpSolutionConfiguration"
                          AutomationProperties.Name="C#ソリューション構成" />
                <!-- 左列は 220px 程度と狭いので、ラベルではなくアイコンで置く（意味はツールチップ）。 -->
                <Button DockPanel.Dock="Left" Content="🔨" Click="OnBuildClick"
                        Style="{StaticResource SecondaryButton}" Width="22" Height="20" Padding="0" Margin="0,0,3,0"
                        FontSize="{DynamicResource Fs11}"
                        ToolTip="選択中のソリューション／プロジェクトをビルド"
                        AutomationProperties.AutomationId="CSharpSolutionBuild"
                        AutomationProperties.Name="C#選択項目をビルド" />
                <Button DockPanel.Dock="Left" Content="🧪" Click="OnTestClick"
                        Style="{StaticResource SecondaryButton}" Width="22" Height="20" Padding="0" Margin="0,0,5,0"
                        FontSize="{DynamicResource Fs11}"
                        ToolTip="選択中のソリューション／プロジェクトをテスト"
                        AutomationProperties.AutomationId="CSharpSolutionTest"
                        AutomationProperties.Name="C#選択項目をテスト" />
                <TextBlock Text="{Binding ExecutionStatusText}" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource FgDim}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="CSharpSolutionExecutionStatus"
                           AutomationProperties.Name="{Binding ExecutionStatusText}" />
            </DockPanel>
        </Border>
        <Grid x:Name="SectionBody" Background="{DynamicResource Bg}">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs11}" Margin="10,6" TextWrapping="Wrap" />
            <!-- 仮想化は必須。ソリューション全体のツリーは1万を超えるノードになり、実体化すると
                 WPF の視覚要素とバインディングだけでヒープが数百MBに達して、GC のたびに UI が
                 数十秒止まる（AppHang でアプリごと落とされる）。 -->
            <TreeView ItemsSource="{Binding Nodes}" SelectedItemChanged="OnTreeSelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource Fg}" Padding="4,2"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.AutomationId="CSharpSolutionTree"
                      AutomationProperties.Name="C#ソリューションツリー"
                      PreviewMouseDoubleClick="OnTreeDoubleClick"
                      PreviewKeyDown="OnTreePreviewKeyDown"
                      x:Name="SolutionTree">
                <TreeView.ItemContainerStyle>
                    <!-- 既定の TreeViewItem テンプレートは選択・ホバー・開閉矢印をシステム配色
                         （SystemColors.Highlight など）で描くため、テーマを切り替えても青いまま残る。
                         フォルダーツリー（FolderTreeView）と同じ作りへ置き換え、行の塗り・文字色・
                         矢印をすべてパレット（Accent / AccentFg / Border / FgDim）から取る。 -->
                    <Style TargetType="TreeViewItem">
                        <!-- 開閉は各ノードが持つ（既定はソリューションとプロジェクトだけ開く）。
                             ここで一律 True にすると全ファイルぶんの行が実体化される。 -->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <EventSetter Event="ContextMenuOpening" Handler="OnTreeItemContextMenuOpening" />
                        <!-- 既定の BringIntoView は深い項目を見せようと横にもスクロールしてしまう。
                             左列は 220px 程度と狭く、選択のたびに名前の頭が切れるので縦だけに絞る。 -->
                        <EventSetter Event="RequestBringIntoView" Handler="OnItemRequestBringIntoView" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <!-- ヘッダ行（矢印＋名前）だけを Bd で包む。子は含めないので、
                                             子をホバーしても親行が光らない。 -->
                                        <Border x:Name="Bd" Grid.Row="0" Background="Transparent" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                                              ClickMode="Press" Focusable="False"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Width="16" Height="16">
                                                                <Path x:Name="Arrow" Width="8" Height="8" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Fill="{DynamicResource FgDim}" Data="M0,0 L4,4 L0,8 Z" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Fg}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                    <ContentPresenter.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ContentText}" />
                                                    </ContentPresenter.Resources>
                                                </ContentPresenter>
                                            </Grid>
                                        </Border>

                                        <!-- 子。親子関係を追えるよう左端に淡いガイド線を引く。 -->
                                        <Border Grid.Row="1" Margin="16,0,0,0"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                            <ItemsPresenter x:Name="ItemsHost" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Border}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CSharpSolutionNodeViewModel}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <!-- グリフは選択行で AccentFg 側へ寄せたいので、色は行の Foreground を継承させる。 -->
                            <TextBlock Text="{Binding Glyph}" Width="18" Opacity="0.75"
                                       FontSize="{DynamicResource Fs11}" />
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </DockPanel>
</UserControl>
