<UserControl x:Class="sk0ya.Loomo.App.Views.CSharpSolutionExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    Background="{DynamicResource BgAlt}"
    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
    <UserControl.Resources>
        <!-- 見出し行の小さな操作ボタン。フォルダーツリーの流儀（透明・角丸・ホバーで反転）に合わせる。 -->
        <Style x:Key="SolutionIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ContentText}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 見出し。他のサイドバーパネル（GIT・ペグボード）と同じ PanelHeader で揃える。 -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PanelHeader}" Text="ソリューション" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ConfigurationOptions}"
                      SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}"
                      Visibility="{Binding HasMultipleConfigurations, Converter={StaticResource BoolToVis}}"
                      Margin="0,0,4,2" Padding="4,0" MinWidth="62" Height="20"
                      VerticalAlignment="Center"
                      FontSize="{DynamicResource Fs11}"
                      ToolTip="Build／Test／Run／Debugで使う構成を選択"
                      AutomationProperties.AutomationId="CSharpSolutionConfiguration"
                      AutomationProperties.Name="C#ソリューション構成" />
            <Button DockPanel.Dock="Right" Content="⇱" Margin="0,0,4,0"
                    Style="{StaticResource SolutionIconButton}"
                    Command="{Binding CollapseAllCommand}"
                    ToolTip="すべて折りたたむ（ソリューションとプロジェクトの段まで戻す）"
                    AutomationProperties.AutomationId="CSharpSolutionCollapseAll"
                    AutomationProperties.Name="すべて折りたたむ" />
        </DockPanel>

        <!-- 操作行。「何に対して」実行するのかを左に出す。左列は 220px 程度と狭いので、
             ここには対象名とビルド／テストだけを置き、構成（モード設定）は見出し行へ逃がす。 -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,6,4" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="テスト" Click="OnTestClick"
                    Style="{StaticResource SecondaryButton}" Height="20" Padding="6,0" Margin="3,0,0,0"
                    FontSize="{DynamicResource Fs11}"
                    IsEnabled="{Binding CanTestTarget}"
                    ToolTip="{Binding ActionTargetLabel, StringFormat={}{0} をテスト}"
                    AutomationProperties.AutomationId="CSharpSolutionTest"
                    AutomationProperties.Name="C#選択項目をテスト" />
            <Button DockPanel.Dock="Right" Content="ビルド" Click="OnBuildClick"
                    Style="{StaticResource SecondaryButton}" Height="20" Padding="6,0" Margin="3,0,0,0"
                    FontSize="{DynamicResource Fs11}"
                    ToolTip="{Binding ActionTargetLabel, StringFormat={}{0} をビルド}"
                    AutomationProperties.AutomationId="CSharpSolutionBuild"
                    AutomationProperties.Name="C#選択項目をビルド" />
            <!-- 実行対象。ファイルを選んでいてもその持ち主（プロジェクト）が出る。 -->
            <TextBlock Text="{Binding ActionTargetLabel}" VerticalAlignment="Center"
                       FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ActionTargetPath}"
                       AutomationProperties.AutomationId="CSharpSolutionActionTarget"
                       AutomationProperties.Name="{Binding ActionTargetLabel}" />
        </DockPanel>

        <!-- 絞り込み。数千ファイルのツリーを目で追うのは無理なので、名前で刈り込む
             （空白区切りはAND・結果は開いた状態で出す）。 -->
        <Grid DockPanel.Dock="Top" Margin="8,0,6,4">
            <TextBox x:Name="FilterBox" Height="22" Padding="6,0" VerticalContentAlignment="Center"
                     FontSize="{DynamicResource Fs11}"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     PreviewKeyDown="OnFilterKeyDown"
                     ToolTip="名前で絞り込み（空白区切りはAND・Escで解除）"
                     AutomationProperties.AutomationId="CSharpSolutionFilter"
                     AutomationProperties.Name="C#ソリューション絞り込み" />
            <TextBlock Text="🔍 名前で絞り込み" Foreground="{DynamicResource FgDim}"
                       FontSize="{DynamicResource Fs11}" Margin="8,0,0,0" IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Visibility="{Binding FilterText, Converter={StaticResource EmptyToVis}}" />
            <Button HorizontalAlignment="Right" Margin="0,0,2,0" Content="✕"
                    Style="{StaticResource SolutionIconButton}" Width="18" Height="18"
                    FontSize="{DynamicResource Fs10}"
                    Command="{Binding ClearFilterCommand}"
                    Visibility="{Binding FilterText, Converter={StaticResource NonEmptyToVis}}"
                    ToolTip="絞り込みを解除"
                    AutomationProperties.AutomationId="CSharpSolutionFilterClear"
                    AutomationProperties.Name="絞り込みを解除" />
        </Grid>

        <!-- 状態行。空のときは行ごと畳む（予約幅・予約行を作らない）。 -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding FilterStatus}" Margin="10,0,8,4"
                   Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding FilterStatus, Converter={StaticResource NonEmptyToVis}}"
                   AutomationProperties.AutomationId="CSharpSolutionFilterStatus" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ExecutionStatusText}" Margin="10,0,8,4"
                   Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs10}"
                   TextWrapping="Wrap" MaxHeight="48"
                   Visibility="{Binding ExecutionStatusText, Converter={StaticResource NonEmptyToVis}}"
                   AutomationProperties.AutomationId="CSharpSolutionExecutionStatus"
                   AutomationProperties.Name="{Binding ExecutionStatusText}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Margin="10,2,8,4"
                   Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVis}}" />

        <Grid Background="{DynamicResource Bg}">
            <!-- 仮想化は必須。ソリューション全体のツリーは1万を超えるノードになり、実体化すると
                 WPF の視覚要素とバインディングだけでヒープが数百MBに達して、GC のたびに UI が
                 数十秒止まる（AppHang でアプリごと落とされる）。 -->
            <TreeView ItemsSource="{Binding Nodes}" SelectedItemChanged="OnTreeSelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource Fg}" Padding="4,2"
                      AutomationProperties.AutomationId="CSharpSolutionTree"
                      AutomationProperties.Name="C#ソリューションツリー"
                      PreviewMouseDoubleClick="OnTreeDoubleClick"
                      PreviewMouseLeftButtonUp="OnTreeMouseLeftButtonUp"
                      PreviewKeyDown="OnTreePreviewKeyDown"
                      x:Name="SolutionTree">
                <TreeView.ItemContainerStyle>
                    <!-- 既定の TreeViewItem テンプレートは選択・ホバー・開閉矢印をシステム配色
                         （SystemColors.Highlight など）で描くため、テーマを切り替えても青いまま残る。
                         フォルダーツリー（FolderTreeView）と同じ作りへ置き換え、行の塗り・文字色・
                         矢印をすべてパレット（Accent / AccentFg / Border / FgDim）から取る。 -->
                    <Style TargetType="TreeViewItem">
                        <!-- 開閉は各ノードが持つ（既定はソリューションとプロジェクトだけ開く）。
                             ここで一律 True にすると全ファイルぶんの行が実体化される。 -->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <EventSetter Event="ContextMenuOpening" Handler="OnTreeItemContextMenuOpening" />
                        <!-- 既定の BringIntoView は深い項目を見せようと横にもスクロールしてしまう。
                             左列は 220px 程度と狭く、選択のたびに名前の頭が切れるので縦だけに絞る。 -->
                        <EventSetter Event="RequestBringIntoView" Handler="OnItemRequestBringIntoView" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <!-- ヘッダ行（矢印＋名前）だけを Bd で包む。子は含めないので、
                                             子をホバーしても親行が光らない。 -->
                                        <Border x:Name="Bd" Grid.Row="0" Background="Transparent" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                                              ClickMode="Press" Focusable="False"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Width="14" Height="16">
                                                                <Path x:Name="Arrow" Width="7" Height="7" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Fill="{DynamicResource FgDim}" Data="M0,0 L4,4 L0,8 Z" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Fg}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                    <ContentPresenter.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ContentText}" />
                                                    </ContentPresenter.Resources>
                                                </ContentPresenter>
                                            </Grid>
                                        </Border>

                                        <!-- 子。親子関係を追えるよう左端に淡いガイド線を引く。 -->
                                        <Border Grid.Row="1" Margin="14,0,0,0"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                            <ItemsPresenter x:Name="ItemsHost" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Border}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CSharpSolutionNodeViewModel}"
                                              ItemsSource="{Binding Children}">
                        <!-- アイコン／名前／添え字。アイコンはフォルダーツリーと同じ FileIcons の
                             線画（sln・csproj・拡張子ごと／フォルダーは開閉で絵が変わる）で、行が
                             何なのかを一目で読ませる。TFM の段だけはファイルが無いので記号（●／○）。
                             1 個のアイコンが色ちがいの線 数本でできているため、Path ではなく
                             DrawingImage を 1 要素で描く。
                             添え字（TFM名・テスト印・件数）は淡色で、名前が長ければ先に名前を削る。 -->
                        <DockPanel LastChildFill="True">
                            <Image DockPanel.Dock="Left" Source="{Binding IconImage}"
                                   Width="16" Height="16" Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Margin="0,0,4,0"
                                       Opacity="0.75" FontSize="{DynamicResource Fs11}"
                                       Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Margin="6,0,4,0"
                                       Opacity="0.55" FontSize="{DynamicResource Fs10}"
                                       VerticalAlignment="Center"
                                       MaxWidth="96" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </DockPanel>
</UserControl>
