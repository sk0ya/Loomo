<UserControl x:Class="sk0ya.Loomo.App.Views.TerminalSupportPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,10,10,3" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- 押せる行：背景なしのボタン。素の ItemsControl の行はマウスで押せる形にしないと、ダブルクリックの
             受け口を別に作ることになる（Hyperlink／Focusable の罠を避けて Button で受ける）。 -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>

        <!-- 操作キーの一覧（Claude と TUI で共用） -->
        <DataTemplate x:Key="KeyRowTemplate">
            <Grid Margin="10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="3" Padding="5,0" Margin="0,0,8,0" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Mono}" Text="{Binding Keys}" />
                </Border>
                <TextBlock Grid.Column="1" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource Fg}"
                           Text="{Binding Action}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- ツリーに出す種類の切り替え（§39.9）。キー設定の観点チップと同じ丸い形で、色の付いた印と件数を添える。
             点いている種類だけがツリーに出る。 -->
        <Style x:Key="KindChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Margin" Value="0,0,2,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="10" Padding="5,1,6,1" Background="Transparent"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- チップの中身：印（色）・名前・件数（薄く） -->
        <Style x:Key="ChipGlyph" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipCount" TargetType="TextBlock">
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 会話のツリーの行：開閉の矢印・種類の印（色）・題・薄い一言。選んだ行は角丸の淡い面＋左端のアクセントの線、
             子は細いガイド線で字下げ（コードのアウトラインと同じ作法）。 -->
        <Style x:Key="ConversationTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="0,2" Margin="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Bar" Width="2" Margin="0,1,0,1" CornerRadius="1" Background="Transparent" />
                                    <ToggleButton x:Name="Expander" Grid.Column="1" ClickMode="Press" Focusable="False"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="Arrow" Width="6" Height="6" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Fill="{DynamicResource FgDim}" Data="M0,0 L4,4 L0,8 Z" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" CenterX="3" CenterY="3" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Fg}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="2" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border x:Name="ItemsHost" Grid.Row="1" Margin="10,0,0,2"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="2,0,0,0">
                                <ItemsPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 種類の印の色（コードのアウトラインの記号の色を借りる。どのテーマでも馴染む） -->
        <Style x:Key="KindGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Section">
                    <Setter Property="Foreground" Value="{DynamicResource SymInterface}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="File">
                    <Setter Property="Foreground" Value="{DynamicResource SymType}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Agent">
                    <Setter Property="Foreground" Value="{DynamicResource SymMethod}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Command">
                    <Setter Property="Foreground" Value="{DynamicResource SymEnum}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Failure">
                    <Setter Property="Foreground" Value="{DynamicResource Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タブが無い -->
        <TextBlock Grid.RowSpan="2" Margin="12" TextWrapping="Wrap"
                   Text="ターミナルのタブがありません。タブを開くと、そこで動いているものに合わせてここに情報が出ます。">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTab}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 追従しているタブ（Claude のときは頭の帯がこの役をするので出さない） -->
        <Button Style="{StaticResource RowButton}" Command="{Binding GoToTerminalCommand}"
                ToolTip="このタブへ行く" Margin="0,6,0,0">
            <Button.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                    <Binding Path="HasTab" />
                    <Binding Path="IsClaude" Converter="{StaticResource InverseBool}" />
                </MultiBinding>
            </Button.Visibility>
            <StackPanel>
                <TextBlock FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" Text="{Binding TabName}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Dim}" Text="{Binding WorkingDirectory}" ToolTip="{Binding WorkingDirectory}" />
            </StackPanel>
        </Button>

        <!-- ═══ Claude Code：会話を読み物として（§39.4） ═══
             頭の1行（自分の番か・題）と、残りの高さいっぱいの文書。文書は ClaudeConversationView が
             EditorSupport と同じ WebView とページ（テーマ・mermaid・アウトライン・本文差し替え）で描く。 -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsClaude, Converter={StaticResource BoolToVis}}">
            <Border DockPanel.Dock="Top" Padding="10,6,10,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                   Text="{Binding NowHeadline}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowTone}" Value="Human">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowTone}" Value="Working">
                                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Content="記録"
                                Command="{Binding OpenTranscriptCommand}" ToolTip="このセッションの記録（jsonl）をエディタで開く"
                                Visibility="{Binding HasClaudeSession, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource RowButton}" Padding="0" Command="{Binding GoToTerminalCommand}"
                                ToolTip="{Binding TabName}" HorizontalContentAlignment="Left">
                            <TextBlock FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" Text="{Binding ClaudeTitle}"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Dim}" Text="{Binding ClaudeFacts}" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="{Binding ClaudeNotice}"
                               Visibility="{Binding ClaudeNotice, Converter={StaticResource NonEmptyToVis}}" />
                </StackPanel>
            </Border>
            <!-- ツリーに出す種類と絞り込み（§39.9） -->
            <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6"
                        Visibility="{Binding HasClaudeSession, Converter={StaticResource BoolToVis}}">
                <!-- 絞り込み（左に虫眼鏡、空のときだけ説明、入力中だけ ✕） -->
                <Grid>
                    <TextBox x:Name="TreeFilterBox" Padding="24,3,22,3" FontSize="{DynamicResource Fs12}"
                             Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="頼みごと・返事の本文・ファイル名・コマンド・エージェントへの頼みごとで絞り込む" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0" HorizontalAlignment="Left"
                               VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource FgDim}" />
                    <TextBlock Text="会話の中を探す" Margin="25,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource FgDim}"
                               Visibility="{Binding Text, ElementName=TreeFilterBox, Converter={StaticResource EmptyToVis}}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,2,0" Width="20" Height="20"
                            Style="{StaticResource IconButton}" FontSize="{DynamicResource Fs11}"
                            Content="✕" ToolTip="絞り込みを消す" Command="{Binding ClearTreeFilterCommand}"
                            Visibility="{Binding Text, ElementName=TreeFilterBox, Converter={StaticResource NonEmptyToVis}}" />
                </Grid>
                <WrapPanel Margin="0,6,0,0">
                    <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding ShowReplies}" ToolTip="返事を見出しごとの節に分けて出す">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ChipGlyph}" Text="§" Foreground="{DynamicResource SymInterface}" />
                            <TextBlock Text="返事" />
                            <TextBlock Style="{StaticResource ChipCount}" Text="{Binding ReplyCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding ShowChanges}" ToolTip="書き換えたファイル（選ぶと差分）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ChipGlyph}" Text="✎" Foreground="{DynamicResource SymType}" />
                            <TextBlock Text="変更" />
                            <TextBlock Style="{StaticResource ChipCount}" Text="{Binding ChangeCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding ShowAgents}" ToolTip="サブエージェントと、その下にそのエージェントの操作">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ChipGlyph}" Text="◆" Foreground="{DynamicResource SymMethod}" />
                            <TextBlock Text="サブ" />
                            <TextBlock Style="{StaticResource ChipCount}" Text="{Binding AgentCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding ShowCommands}" ToolTip="走らせたコマンド（選ぶと出力を形に合わせて見せる）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ChipGlyph}" Text="$" Foreground="{DynamicResource SymEnum}" />
                            <TextBlock Text="コマンド" />
                            <TextBlock Style="{StaticResource ChipCount}" Text="{Binding CommandCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding ShowFailures}" ToolTip="失敗した操作">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ChipGlyph}" Text="✗" Foreground="{DynamicResource Error}" />
                            <TextBlock Text="失敗" />
                            <TextBlock Style="{StaticResource ChipCount}" Text="{Binding FailureCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding ShowNotes}" ToolTip="作業の途中のメモ">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="メモ" />
                            <TextBlock Style="{StaticResource ChipCount}" Text="{Binding NoteCount}" />
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>
            </StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="80" />
                </Grid.RowDefinitions>
                <TreeView x:Name="ConversationTree" ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0"
                          Padding="4,0,6,4" ItemContainerStyle="{StaticResource ConversationTreeItem}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasClaudeSession, Converter={StaticResource BoolToVis}}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid ToolTip="{Binding Label}" Margin="0,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 種類の印（ターンは開閉の矢印が印を兼ねるので空き） -->
                                <TextBlock Width="16" Style="{StaticResource KindGlyph}" Text="{Binding Icon}"
                                           Visibility="{Binding Icon, Converter={StaticResource NonEmptyToVis}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTurn}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Conversation">
                                                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Note">
                                                    <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                                </DataTrigger>
                                                <!-- コマンドは等幅で（ターミナルで見たときの形のまま探せる） -->
                                                <DataTrigger Binding="{Binding Kind}" Value="Command">
                                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                                    <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <!-- 作業中のターン・エージェント -->
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{DynamicResource AccentHover}" VerticalAlignment="Center"
                                             ToolTip="作業中" Visibility="{Binding Working, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource Fs11}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FgDim}" />
                                    <TextBlock Text="{Binding FailBadge}" FontSize="{DynamicResource Fs11}" VerticalAlignment="Center"
                                               Margin="6,0,0,0" Foreground="{DynamicResource Error}" ToolTip="中で失敗した操作の数"
                                               Visibility="{Binding FailBadge, Converter={StaticResource NonEmptyToVis}}" />
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <!-- 分割線：見た目は 1px、掴める幅は 5px -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Rows" Focusable="False" Cursor="SizeNS">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Border}" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <Grid x:Name="ConversationHost" Grid.Row="2" />
            </Grid>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsProgram, Converter={StaticResource BoolToVis}}">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,0,10">

                <!-- ═══ そのほかのプログラム（TUI など） ═══ -->
                <StackPanel Visibility="{Binding IsProgram, Converter={StaticResource BoolToVis}}">
                    <Border Margin="10,8,10,0" Padding="8,6" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource Border}" Background="{DynamicResource BgAlt}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" Text="{Binding Elapsed}" ToolTip="実行し始めてから" />
                                <TextBlock FontSize="{DynamicResource Fs13}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                           Text="{Binding ProgramName}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Dim}" Text="{Binding ProgramDescription}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Mono}" Text="{Binding CommandLine}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- TUI の操作キーは主役なので畳まない -->
                    <StackPanel Visibility="{Binding HasKeys, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="操作キー" />
                        <ItemsControl ItemsSource="{Binding Keys}" ItemTemplate="{StaticResource KeyRowTemplate}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ シェル（前面に何も居ない）：実行し終えたコマンドと、選んだ回の出力の見せ直し（§39.5・§39.5.1） ═══
             一覧は上に小さく、残りの高さは選んだ回の出力を形に合わせて描くページ（表・JSON のツリー・枝の図・
             テストとビルドの成否と file:line）。ページは Claude の会話と同じ WebView の道具で描く。 -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsShell, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="このタブで実行したコマンド" />
            <TextBlock DockPanel.Dock="Top" Margin="10,0" TextWrapping="Wrap"
                       Text="実行し終えたコマンドと出力がここに並びます。選ぶと出力を形に合わせて見せます（表・JSON・git log --graph・テストやビルドの結果）。出力は再起動で消えます。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRuns}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer DockPanel.Dock="Top" MaxHeight="168" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Grid.IsSharedSizeScope="True">
                <ItemsControl ItemsSource="{Binding Runs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button ToolTip="クリックで出力を下に見せる（右クリックでエディタで開く・前回と比べる・プロンプトへ入れる）"
                                    Command="{Binding DataContext.SelectRunCommand, ElementName=Root}" CommandParameter="{Binding}"
                                    Tag="{Binding DataContext, ElementName=Root}" Style="{StaticResource RowButton}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="出力をエディタで開く"
                                                  Command="{Binding PlacementTarget.Tag.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="前回の出力と比べる" IsEnabled="{Binding CanCompare}"
                                                  Command="{Binding PlacementTarget.Tag.CompareOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="プロンプトへ入れる（Enter は押さない）"
                                                  Command="{Binding PlacementTarget.Tag.InsertCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Badge" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,8,0" FontSize="{DynamicResource Fs11}" Text="{Binding Badge}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Dim}" Text="{Binding Age}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 選んだ回の頭：形の一言と、エディタで開く・前回と比べる -->
            <Border DockPanel.Dock="Top" Margin="0,6,0,0" Padding="10,4" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1"
                    Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Content="前回と比べる"
                            Command="{Binding CompareOutputCommand}" CommandParameter="{Binding SelectedRun}"
                            IsEnabled="{Binding SelectedRun.CanCompare, FallbackValue=False}"
                            ToolTip="同じコマンドの前回の出力と Diff で比べる" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Content="エディタで開く"
                            Command="{Binding OpenOutputCommand}" CommandParameter="{Binding SelectedRun}"
                            ToolTip="出力をそのままエディタで開く（読むための写し・保存しても残らない）" />
                    <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center" Text="{Binding OutputLabel}" ToolTip="{Binding SelectedRun.Title}" />
                </DockPanel>
            </Border>
            <Grid x:Name="OutputHost" Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}" />
        </DockPanel>
    </Grid>
</UserControl>
