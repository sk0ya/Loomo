<UserControl x:Class="sk0ya.Loomo.App.Views.RepositoryChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:sk0ya.Loomo.App.Services"
             d:DataContext="{d:DesignInstance svc:RepositoryChipViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False">
    <!-- リポジトリの印（§40.7）：⎇ ブランチ ↑n ↓n ±n 操作 ⚠n。ブランチ名は常に、それ以外は空なら出さず幅も取らない。
         各部は押せる（ブランチ＝切替、↑↓＝取得／取り込み、±・⚠＝Git パネルの変更一覧）。動作は RepositoryActions に一本化。 -->
    <UserControl.Resources>
        <!-- 押せる文字。枠も背景も持たず、ホバーで薄い下地だけ出す（行の中で目立たせない）。 -->
        <Style x:Key="ChipPart" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- 文字は Button の色を明示的に受ける。アプリ全体の暗黙の TextBlock スタイルが、ContentPresenter が文字列から
                 作る TextBlock の色を上書きしてしまう（↑↓・±・REBASING が全部同じ灰色になっていた）。 -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Content" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Root" Orientation="Horizontal" ToolTip="{Binding ToolTip}" Background="Transparent">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <StackPanel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="ブランチを切り替え…" Command="{Binding SwitchBranchCommand}" />
                <MenuItem Header="取得（fetch）" Command="{Binding FetchCommand}" />
                <MenuItem Header="取り込み（pull）" Command="{Binding PullCommand}" />
                <Separator />
                <MenuItem Header="変更の一覧を開く" Command="{Binding OpenChangesCommand}" />
                <MenuItem Header="ログを開く" Command="{Binding OpenLogCommand}" />
                <MenuItem Header="ターミナルでここへ" Command="{Binding OpenTerminalCommand}" />
                <MenuItem Header="ファイル一覧で開く" Command="{Binding OpenInFilesCommand}" />
            </ContextMenu>
        </StackPanel.ContextMenu>

        <Button Style="{StaticResource ChipPart}" Command="{Binding SwitchBranchCommand}"
                ContentTemplate="{x:Null}" ToolTip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⎇" Margin="0,0,3,0" Foreground="{DynamicResource FgDim}" />
                <TextBlock Text="{Binding Branch}" MaxWidth="160" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FgDim}" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource ChipPart}" Content="{Binding AheadText}" Command="{Binding FetchCommand}"
                ToolTip="送っていないコミット（押すと取得）" />
        <Button Style="{StaticResource ChipPart}" Content="{Binding BehindText}" Command="{Binding PullCommand}"
                Foreground="#4FC1FF" ToolTip="取り込んでいないコミット（押すと取り込み）" />
        <Button Style="{StaticResource ChipPart}" Content="{Binding ChangesText}" Command="{Binding OpenChangesCommand}"
                Foreground="#E2C08D" ToolTip="変更のあるファイル（押すと Git パネル）" />
        <Button Style="{StaticResource ChipPart}" Content="{Binding OperationText}" Command="{Binding OpenChangesCommand}"
                Foreground="#E57373" FontWeight="SemiBold" ToolTip="途中で止まっている操作（押すと Git パネル）" />
        <Button Style="{StaticResource ChipPart}" Content="{Binding ConflictText}" Command="{Binding OpenChangesCommand}"
                Foreground="#E57373" FontWeight="SemiBold" ToolTip="競合（押すと Git パネル）" />
        <TextBlock Text="…" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"
                   FontSize="{DynamicResource Fs11}" ToolTip="取得中">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="✕" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="#E57373"
                   FontSize="{DynamicResource Fs11}" ToolTip="{Binding LastError}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LastError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
