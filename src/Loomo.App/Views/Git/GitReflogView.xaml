<UserControl x:Class="sk0ya.Loomo.App.Views.GitReflogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Panel}">

    <!-- 操作ログ（reflog）の面。DataContext は GitSessionViewModel のまま（操作は履歴の面と同じ経路を
         通すので、親の VM が要る）で、一覧と詳細は Reflog.* を見る。
         左＝「いつ・何をして・どこへ動いたか」を日付で区切った一覧、右＝選んだ記録のコミットの中身と、
         そこへ戻す／そこから取り戻す操作。素の git reflog の「checkout: moving from 3f9a… to main」は
         種類のバッジと日本語の一文に言い換え、git の原文はツールチップに残す（言い換えを疑えるように）。 -->

    <UserControl.Resources>
        <Style x:Key="ReflogToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
        </Style>

        <!-- 詳細の操作ボタン。狭い列で折り返すので、横幅は中身なりにする。 -->
        <Style x:Key="ReflogActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
        </Style>

        <!-- 種類のバッジ。色は「履歴をどう動かしたか」で分ける：作る（緑）・取り込む（紫）・場所を移る（青）・
             履歴を書き換える（橙）・巻き戻す（赤）。取り戻したいものを探すとき、赤と橙の行が当たりどころになる。 -->
        <Style x:Key="ReflogKindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource FgDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Commit">
                    <Setter Property="BorderBrush" Value="#FF6FBF73" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Amend">
                    <Setter Property="BorderBrush" Value="#FFE5A23B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Merge">
                    <Setter Property="BorderBrush" Value="#FFB58CE0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pull">
                    <Setter Property="BorderBrush" Value="#FFB58CE0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="CherryPick">
                    <Setter Property="BorderBrush" Value="#FFB58CE0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Checkout">
                    <Setter Property="BorderBrush" Value="#FF64A8E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Branch">
                    <Setter Property="BorderBrush" Value="#FF64A8E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Rebase">
                    <Setter Property="BorderBrush" Value="#FFE5A23B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Revert">
                    <Setter Property="BorderBrush" Value="#FFE5A23B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Reset">
                    <Setter Property="BorderBrush" Value="#FFE57373" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReflogListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「どの ref からも辿れない」印。一覧の行と詳細の両方で同じ見え方にする。 -->
        <Style x:Key="LostBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="#33E5A23B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="340" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- ===== 一覧 ===== -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Padding="5,3" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ReflogToolbarButton}" Margin="0,1"
                            Width="26" Padding="0" Content="↻" ToolTip="読み直す"
                            Command="{Binding Reflog.ReloadCommand}" />
                    <TextBlock DockPanel.Dock="Right" Margin="6,0,8,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                               Text="{Binding Reflog.CountLabel}" />

                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <!-- 見る ref。HEAD は「いた場所の移動ぜんぶ」、ブランチはそのブランチが指す先の移動だけ
                             （ブランチの付け替え・削除前の位置を探すならこちら）。 -->
                        <ComboBox Width="150" MinHeight="24" Margin="0,1,6,1" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Reflog.RefOptions}"
                                  SelectedItem="{Binding Reflog.SelectedRef}">
                            <ComboBox.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="どの操作ログを見るか" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="HEAD：切り替え・コミット・リセットなど、いた場所の移動すべて。" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="ブランチ名：そのブランチが指す先が動いた記録だけ。" />
                                    </StackPanel>
                                </ToolTip>
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <Grid Width="200" Margin="0,1,6,1" VerticalAlignment="Center">
                            <TextBox x:Name="FilterBox" MinHeight="24" Padding="6,3" VerticalContentAlignment="Center"
                                     PreviewKeyDown="OnFilterKeyDown"
                                     ToolTip="説明・件名・ハッシュ・作者で絞り込み（空白区切りで AND、Esc で解除）"
                                     Text="{Binding Reflog.Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                            <TextBlock Text="🔍 操作・件名・ハッシュ" Foreground="{DynamicResource FgDim}"
                                       FontSize="{DynamicResource Fs12}" Margin="8,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <!-- 取り戻す候補だけに絞る。候補が無いときは出さない（押しても空になるだけ）。 -->
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}" Margin="0,1,6,1" MinHeight="24"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Reflog.LostOnly}"
                                      Visibility="{Binding Reflog.LostCount, Converter={StaticResource CountToVis}}"
                                      ToolTip="どのブランチ・タグからも辿れないコミットだけを表示（リセットやリベースで外れたもの）">
                            <TextBlock FontSize="{DynamicResource Fs12}">
                                <Run Text="⚠ 辿れないコミット" /><Run Text=" " /><Run
                                    Text="{Binding Reflog.LostCount, Mode=OneWay}" Foreground="#FFE5A23B" />
                            </TextBlock>
                        </ToggleButton>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Button DockPanel.Dock="Bottom" Style="{StaticResource ReflogToolbarButton}" Margin="8,4"
                    HorizontalAlignment="Left" Content="さらに古い記録を読み込む"
                    Command="{Binding Reflog.LoadMoreCommand}"
                    Visibility="{Binding Reflog.HasMore, Converter={StaticResource BoolToVis}}" />

            <Grid>
                <ListBox x:Name="ReflogList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Fg}"
                         ItemsSource="{Binding Reflog.RowsView}"
                         SelectedItem="{Binding Reflog.SelectedRow, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ReflogListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseDoubleClick="OnRowDoubleClick"
                         PreviewKeyDown="OnListKeyDown"
                         PreviewMouseRightButtonDown="OnListRightClickSelect"
                         ContextMenuOpening="OnContextMenuOpening">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6,8,2" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgDim}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" ToolTip="{Binding ToolTipText}" Background="Transparent">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShortHash}" Margin="8,0,0,0"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="いま" Margin="6,0,0,0"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center"
                                           ToolTip="この参照がいま指している場所"
                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource LostBadge}" Margin="6,0,0,0"
                                        ToolTip="どのブランチ・タグからも辿れないコミット（ブランチを作れば取り戻せる）"
                                        Visibility="{Binding IsLost, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="辿れない" FontSize="{DynamicResource Fs10}" Foreground="#FFE5A23B" />
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeLabel}" Width="40"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Left" Style="{StaticResource ReflogKindBadge}"
                                        MinWidth="56" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="{DynamicResource Fs10}" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <!-- 行の右クリック。上から「見る」→「取り戻す・戻す」→「写す」。 -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="このコミットの差分を表示" FontWeight="SemiBold" Click="OnShowCommitDiff" />
                            <MenuItem x:Name="MenuOperationDiff" Header="この操作で変わった内容を表示（前 → 後）"
                                      Click="OnShowOperationDiff" />
                            <MenuItem Header="作業ツリーと比較" Click="OnCompareWorkingTree" />
                            <MenuItem x:Name="MenuShowInHistory" Header="コミット履歴で表示" Click="OnShowInHistory" />
                            <Separator />
                            <MenuItem Header="ここから新しいブランチを作成…（取り戻す）" Click="OnCreateBranch" />
                            <MenuItem Header="チェックアウト（detached HEAD）" Click="OnCheckout" />
                            <MenuItem Header="現在のブランチをこの状態へ戻す">
                                <MenuItem Header="soft（コミットだけ戻す・変更はステージに残す）" Click="OnResetSoft" />
                                <MenuItem Header="mixed（ステージも戻す・変更は作業ツリーに残す）" Click="OnResetMixed" />
                                <MenuItem Header="hard（作業ツリーごと戻す）…" Click="OnResetHard" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="コピー">
                                <MenuItem Header="ハッシュ" Click="OnCopyHash" />
                                <MenuItem Header="位置指定（HEAD@{n}）" Click="OnCopySelector" />
                                <MenuItem Header="説明" Click="OnCopyDescription" />
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <TextBlock Margin="16,20" HorizontalAlignment="Center" VerticalAlignment="Top"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                           Foreground="{DynamicResource FgDim}" Text="{Binding Reflog.EmptyMessage}"
                           Visibility="{Binding Reflog.IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />

        <!-- ===== 選んだ記録の詳細 ===== -->
        <Grid Grid.Column="2" Background="{DynamicResource BgAlt}">
            <TextBlock Margin="14,16" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                       Visibility="{Binding Reflog.HasSelection, Converter={StaticResource InverseBoolToVis}}"
                       Text="記録を選ぶと、そのときのコミットの中身と、そこへ戻す・そこから取り戻す操作がここに出ます。&#x0a;&#x0a;リセットやリベースで消えたように見えるコミットは「辿れない」の印が付いた行です。そこからブランチを作れば取り戻せます。" />

            <Grid Visibility="{Binding Reflog.HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="60" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="1*" MinHeight="60" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,8,10,2" DataContext="{Binding Reflog}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" DataContext="{Binding SelectedRow}"
                                Style="{StaticResource ReflogKindBadge}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding KindLabel}" FontSize="{DynamicResource Fs11}" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                        </Border>
                        <TextBlock Text="{Binding SelectedRow.Description}" TextWrapping="Wrap"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectionHeader}" TextWrapping="Wrap"
                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" />
                    <TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="移動: " /><Run Text="{Binding SelectionMove, Mode=OneWay}"
                                                FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Fg}" />
                    </TextBlock>

                    <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="#33E5A23B"
                            BorderBrush="#FFE5A23B" BorderThickness="1"
                            Visibility="{Binding SelectedRow.IsLost, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource Fg}"
                                   Text="このコミットはどのブランチ・タグからも辿れません。放っておくといずれ git が片付けます。取り戻すなら「ブランチを作成」を。" />
                    </Border>

                    <!-- いちばん使う操作は押せる形で見せる（右クリックの奥に置くと、取り戻し方に気づかない）。 -->
                    <WrapPanel Margin="0,10,0,4">
                        <Button Style="{StaticResource ReflogActionButton}" Content="差分" Click="OnShowCommitDiff"
                                ToolTip="このコミットの変更を DIFF ペインで見る（Enter／ダブルクリック）" />
                        <Button Style="{StaticResource ReflogActionButton}" Content="操作の前後" Click="OnShowOperationDiff"
                                IsEnabled="{Binding CanShowOperationDiff}"
                                ToolTip="この操作の前に指していたコミットから後までの差分（リセット・リベースで何が変わったか）" />
                        <Button Style="{StaticResource ReflogActionButton}" Content="＋ ブランチを作成…" Click="OnCreateBranch"
                                ToolTip="このコミットから新しいブランチを作る（辿れないコミットを取り戻す定番の方法）" />
                        <Button x:Name="ResetButton" Style="{StaticResource ReflogActionButton}" Content="この状態へ戻す ▾"
                                Click="OnResetButtonClick"
                                ToolTip="現在のブランチをこのコミットへリセットする（soft／mixed／hard を選ぶ）">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="soft（コミットだけ戻す・変更はステージに残す）" Click="OnResetSoft" />
                                    <MenuItem Header="mixed（ステージも戻す・変更は作業ツリーに残す）" Click="OnResetMixed" />
                                    <MenuItem Header="hard（作業ツリーごと戻す）…" Click="OnResetHard" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>

                    <TextBlock Margin="0,4,0,2" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgDim}">
                        <Run Text="変更ファイル" /><Run Text="  " /><Run
                            Text="{Binding DetailFileSummary, Mode=OneWay}" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>

                <ListBox x:Name="DetailFileList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Fg}" ItemContainerStyle="{StaticResource ReflogListItem}"
                         ItemsSource="{Binding Reflog.DetailFiles}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnDetailFileDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" ToolTip="{Binding DisplayPath}"
                                       Background="Transparent">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ChurnLabel}" Margin="8,0,0,0"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Fs12}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="差分を別ウィンドウで表示" FontWeight="SemiBold" Click="OnDetailFileDiffWindow" />
                            <MenuItem Header="パスをコピー" Click="OnDetailFileCopyPath" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />

                <TextBox Grid.Row="3" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Text="{Binding Reflog.DetailMessage, Mode=OneWay}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}"
                         Foreground="{DynamicResource Fg}" Padding="6,4"
                         BorderThickness="0" Background="Transparent" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
