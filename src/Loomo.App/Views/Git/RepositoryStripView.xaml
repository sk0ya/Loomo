<UserControl x:Class="sk0ya.Loomo.App.Views.RepositoryStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
             xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
             xmlns:svc="clr-namespace:sk0ya.Loomo.App.Services"
             x:Name="Root" Focusable="False">
    <!-- リポジトリの帯（§40.8.3・§40.8.4）：ワークスペースの全リポジトリを印付きで並べ、今見ているものを常に見せる。
         Git パネルでは縦の一覧（IsHorizontal=False）、Git ペインでは横のタブ（IsHorizontal=True）。項目が1つなら出さない。 -->
    <UserControl.Resources>
        <DataTemplate x:Key="StripItem" DataType="{x:Type vm:GitRepositoryStripItem}">
            <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource Fg}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Root}" />
                <ContentControl Content="{Binding Chip}" Margin="6,0,0,0" Focusable="False" VerticalAlignment="Center">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type svc:RepositoryChipViewModel}">
                            <local:RepositoryChip />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="StripItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="Bd" Property="BorderThickness"
                                        Value="{Binding SelectedBorder, ElementName=Root}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMulti}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ItemTemplate="{StaticResource StripItem}" ItemContainerStyle="{StaticResource StripItemContainer}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        <TextBlock Text="{Binding SwitchNotice}" Margin="8,1,8,2" FontSize="{DynamicResource Fs11}"
                   Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SwitchNotice}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
