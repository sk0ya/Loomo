<UserControl x:Class="sk0ya.Loomo.App.Views.RepositoryStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
             xmlns:local="clr-namespace:sk0ya.Loomo.App.Views"
             xmlns:svc="clr-namespace:sk0ya.Loomo.App.Services"
             x:Name="Root" Focusable="False">
    <!-- リポジトリを選ぶ部品（§40.8.3・§40.8.4）。Git パネル・Git ペインのヘッダー・ブランチ切替の3か所で<b>同じ形</b>
         （コンボボックス）にする：閉じていても選んでいるリポジトリの印（ブランチ・ahead/behind・変更数）が見え、開けば全リポジトリが
         印付きで並ぶ。項目が1つ（ふつうの1リポジトリの部屋）なら出さない。
         以前はパネルが縦の一覧・ペインが横のタブで、同じ選択に別々の形があり、縦の一覧は狭いサイドバーでコミット欄を押し下げていた。 -->
    <UserControl.Resources>
        <!-- 印は押せない（項目を押す＝そのリポジトリを選ぶ、の1つだけにする。閉じた箱の上の印が押せると、開くつもりで
             ブランチ切替が開く）。 -->
        <DataTemplate x:Key="PickerItem" DataType="{x:Type vm:GitRepositoryStripItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource Fg}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                <ContentControl Content="{Binding Chip}" Margin="6,0,0,0" Focusable="False" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type svc:RepositoryChipViewModel}">
                            <local:RepositoryChip />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
        <!-- 入れ子のリポジトリの字下げは開いた一覧の行だけに付ける（閉じた箱の中では要らない）。 -->
        <Style x:Key="PickerItemContainer" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Margin" Value="{Binding IndentMargin}" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Host">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMulti}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <ComboBox x:Name="Picker" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  ItemTemplate="{StaticResource PickerItem}" ItemContainerStyle="{StaticResource PickerItemContainer}"
                  MinHeight="26" MinWidth="140"
                  VerticalAlignment="Center" ToolTip="{Binding SelectedItem.Root}" />
        <TextBlock Text="{Binding SwitchNotice}" Margin="8,1,8,2" FontSize="{DynamicResource Fs11}"
                   Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SwitchNotice}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
