<UserControl x:Class="sk0ya.Loomo.App.Views.HarnessPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 一覧の行（TraceSessionView と同じ見た目） -->
        <Style x:Key="HarnessListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HarnessList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HarnessListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,4,8,2" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 頭の帯の数字1つ（見出し＋値） -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="4,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>

        <Style x:Key="DetailBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- 下線で選択を示すフラットなタブ（DebugView と同じ） -->
        <Style x:Key="HarnessTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="10,5" Margin="0,0,2,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HarnessTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HarnessTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              PanningMode="HorizontalOnly">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="4,2,4,0" />
                                </ScrollViewer>
                            </Border>
                            <!-- 名前は PART_SelectedContentHost（UIA が選択中タブの中身を繋ぐため。DebugView 参照） -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyNotice" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 頭の帯：周辺視野（§37.1）。進捗率のような根拠の無い数字は出さない -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgAlt}" Padding="8,4"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Style="{StaticResource Dim}" Text="Run" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding RunsLabel}" />
                <!-- 判定が1件も無い間は出さない（0／0 と「受け入れなし」が並ぶだけになる）。判定は実行タブで付ける -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasVerdicts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Dim}" Text="受け入れ／差し戻し" ToolTip="人間の判定（.harness/runs/verdicts.json）" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding VerdictsLabel}" />
                    <TextBlock Style="{StaticResource Dim}" Text="受け入れ1件あたり"
                               ToolTip="失敗・差し戻し・未判定を含む総トークン ÷ 受け入れ件数（成功だけの平均にしない）" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TokensPerAcceptedLabel}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" Text="総トークン" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TotalTokensLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="キャッシュ読込" ToolTip="cache_read ÷（input + cache_read + cache_creation）" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CacheLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="ツール失敗" ToolTip="is_error ÷ ツール呼び出し（人間の拒否は除く）" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ErrorRateLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="費用" ToolTip="CLI が記録した料金（cost-state）。記録の無い Run は推計で埋めない" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CostLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="{Binding HarnessLabel}" Margin="0,0,14,0" />
                <TextBlock Style="{StaticResource Dim}" Text="{Binding StatusText}" Foreground="{DynamicResource Accent}" />
            </WrapPanel>
        </Border>

        <Grid>
            <TabControl Style="{StaticResource HarnessTabControl}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                <!-- ===== 分析（§37.5）：直し所は規則で当てず、記録を Claude Code に読ませる。渡す中身をそのまま見せる ===== -->
                <TabItem Header="分析">
                    <Grid>
                        <DockPanel Margin="16,12,16,12">
                            <!-- 何を渡して、どう使うか。主役はコピーの1操作だけ -->
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="直し所探しを Claude Code に渡す" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg}" />
                                <TextBlock Text="{Binding AnalysisSummary}" Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource FlatButton}" Content="分析プロンプトをコピー"
                                            Command="{Binding CopyAnalysisPromptCommand}" VerticalAlignment="Center"
                                            ToolTip="期間内の記録の場所・指標・構成要素をまとめたプロンプトをクリップボードへ" />
                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                               Text="① コピー → ② ターミナルの Claude Code に貼る → ③ 返ってきた直し所の表から、直させるものを選ぶ" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Margin="0,16,0,4"
                                       Text="渡す内容" />
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
                                <TextBox x:Name="AnalysisPromptBox" Style="{StaticResource DetailBox}" Padding="10,8"
                                         TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                                         Text="{Binding AnalysisPrompt, Mode=OneWay}" />
                            </Border>
                        </DockPanel>
                        <Border Background="{DynamicResource Panel}"
                                Visibility="{Binding EmptyMessage, Converter={StaticResource NonEmptyToVis}}">
                            <TextBlock Style="{StaticResource EmptyNotice}" Text="{Binding EmptyMessage}" />
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== 実行（Run の一覧と、選んだ Run のツール呼び出し） ===== -->
                <TabItem Header="実行">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.2*" MinWidth="240" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="Run（新しい順）" />
                            <Grid>
                                <ListBox x:Name="RunList" Style="{StaticResource HarnessList}" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <!-- 右の数字は幅を決めて揃える（失敗の有無で版やトークンの列がずれないように） -->
                                                <TextBlock x:Name="verdict" DockPanel.Dock="Right" Text="{Binding VerdictLabel}"
                                                           Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorsLabel}" Width="48" TextAlignment="Right"
                                                           Foreground="{DynamicResource Error}" FontSize="{DynamicResource Fs11}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TokensLabel}" Style="{StaticResource Dim}" Margin="8,0,0,0"
                                                           Width="52" TextAlignment="Right" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" Style="{StaticResource Dim}" Margin="8,0,0,0"
                                                           Width="64" FontFamily="Cascadia Mono, Consolas" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TasksLabel}" Foreground="{DynamicResource Accent}"
                                                           FontSize="{DynamicResource Fs11}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding TasksLabel}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Started}" Width="76" Style="{StaticResource Dim}" />
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAccepted}" Value="True">
                                                    <Setter TargetName="verdict" Property="Foreground" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                    <Setter TargetName="verdict" Property="Foreground" Value="{DynamicResource Error}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyNotice}" Text="{Binding EmptyMessage}" />
                            </Grid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="60" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="120" MinHeight="40" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="8,4" Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolToVis}}">
                                <TextBox Style="{StaticResource DetailBox}" Background="Transparent" TextWrapping="Wrap"
                                         FontFamily="{x:Static SystemFonts.MessageFontFamily}" FontSize="{DynamicResource Fs12}"
                                         Text="{Binding RunDetail, Mode=OneWay}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="受け入れ" Command="{Binding AcceptRunCommand}"
                                            ToolTip="この Run の成果を受け入れた（.harness/runs/verdicts.json に記録）" />
                                    <Button Style="{StaticResource SmallButton}" Content="差し戻し" Command="{Binding RejectRunCommand}"
                                            ToolTip="この Run の成果を受け入れなかった" />
                                    <Button Style="{StaticResource SmallButton}" Content="判定を外す" Command="{Binding ClearVerdictCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="記録を開く" Command="{Binding OpenRunRecordCommand}"
                                            ToolTip="選んだツール呼び出し（無ければ Run の先頭）の記録をエディタで開く" />
                                    <Button Style="{StaticResource SmallButton}" Content="チケットを開く" Command="{Binding OpenRunTicketCommand}"
                                            Visibility="{Binding SelectedRun.HasTicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                            ToolTip="この Run の指示に書かれたチケットをブラウザペインで開く" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource ColumnTitle}" Margin="0,8,0,0" Text="ツール呼び出し（↳＝サブエージェント）" />
                            </StackPanel>
                            <ListBox Grid.Row="1" Style="{StaticResource HarnessList}" ItemsSource="{Binding RunCalls}"
                                     SelectedItem="{Binding SelectedCall}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="64" Foreground="{DynamicResource FgDim}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Tool}" Width="96" x:Name="tool"
                                                       Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CharsLabel}" x:Name="chars"
                                                       Foreground="{DynamicResource FgDim}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Summary}" x:Name="summary" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Fg}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="tool" Property="Foreground" Value="{DynamicResource Error}" />
                                                <Setter TargetName="summary" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                                <Setter TargetName="chars" Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="chars" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />
                            <TextBox Grid.Row="3" Style="{StaticResource DetailBox}" Text="{Binding CallDetail, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== 構成（設定されているもの＋観測された使用） ===== -->
                <TabItem Header="構成">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="0,4,8,4"
                                    Content="開く" Command="{Binding OpenConfigCommand}"
                                    ToolTip="選んだファイルをエディタで開く（ダブルクリック・Enter でも開く）" />
                            <TextBlock Style="{StaticResource ColumnTitle}" TextWrapping="Wrap" Text="{Binding ConfigNote}" />
                        </DockPanel>
                        <!-- 効く範囲（このワークスペース／ユーザー全体）で見出しを分ける。行ごとに範囲を書くと同じ語が並ぶだけになる -->
                        <ListBox x:Name="ConfigList" Style="{StaticResource HarnessList}" ItemsSource="{Binding ConfigView}"
                                 SelectedItem="{Binding SelectedConfig}" MouseDoubleClick="OnConfigDoubleClick"
                                 KeyDown="OnConfigKeyDown" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="8,10,8,3" FontSize="{DynamicResource Fs11}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource FgDim}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="ダブルクリック・Enter で開く" Margin="8,1,0,1">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding KindLabel}" Width="84" Style="{StaticResource Dim}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="220" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Usage}" Width="190" Style="{StaticResource Dim}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Usage}" />
                                        <TextBlock Text="{Binding PathLabel}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Component.Path}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- ===== 版の比較（§37.6） ===== -->
                <TabItem Header="版の比較">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" TextWrapping="Wrap"
                                   Text="版＝Run 開始時点で .harness / CLAUDE.md / AGENTS.md / .claude を最後に変えたコミット（未コミットの変更は区別できない）。試行が少ない版の差で改善と判断しない。" />
                        <!-- 見出し行（GridView の既定ヘッダーはテーマに乗らないので、行と同じ並びで自前に描く） -->
                        <Border DockPanel.Dock="Top" Padding="6,2" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource FgDim}"
                                        TextElement.FontSize="{DynamicResource Fs11}">
                                <TextBlock Width="280" Text="版" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Width="90" Text="日付" Margin="0,0,8,0" />
                                <TextBlock Width="50" Text="Run" Margin="0,0,8,0" TextAlignment="Right" />
                                <TextBlock Width="80" Text="受入／差戻" Visibility="{Binding HasVerdicts, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                <TextBlock Width="120" Text="受け入れ1件あたり" Visibility="{Binding HasVerdicts, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                <TextBlock Width="90" Text="1 Run あたり" Margin="0,0,8,0" TextAlignment="Right" />
                                <TextBlock Width="80" Text="ツール失敗" Margin="0,0,16,0" TextAlignment="Right" />
                                <TextBlock Width="100" Text="" Margin="0,0,8,0" />
                            </StackPanel>
                        </Border>
                        <ListBox Style="{StaticResource HarnessList}" ItemsSource="{Binding Versions}" FontSize="{DynamicResource Fs12}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                <TextBlock Width="280" Text="{Binding VersionLabel}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionLabel}" />
                                <TextBlock Width="90" Text="{Binding DateLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="50" Text="{Binding RunsLabel}" Margin="0,0,8,0" TextAlignment="Right" />
                                <TextBlock Width="80" Text="{Binding VerdictsLabel}" Visibility="{Binding DataContext.HasVerdicts, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                <TextBlock Width="120" Text="{Binding TokensPerAcceptedLabel}" Visibility="{Binding DataContext.HasVerdicts, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                <TextBlock Width="90" Text="{Binding TokensPerRunLabel}" Margin="0,0,8,0" TextAlignment="Right" />
                                <TextBlock Width="80" Text="{Binding ErrorRateLabel}" Margin="0,0,16,0" TextAlignment="Right" />
                                <TextBlock Width="100" Text="{Binding Note}" Margin="0,0,8,0" Foreground="{DynamicResource FgDim}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
