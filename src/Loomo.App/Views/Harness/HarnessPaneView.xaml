<UserControl x:Class="sk0ya.Loomo.App.Views.HarnessPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Panel}" Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 一覧の行（TraceSessionView と同じ見た目） -->
        <Style x:Key="HarnessListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HarnessList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HarnessListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,4,8,2" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 頭の帯の数字1つ（見出し＋値） -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="4,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
        </Style>

        <Style x:Key="DetailBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- 下線で選択を示すフラットなタブ（DebugView と同じ） -->
        <Style x:Key="HarnessTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="10,5" Margin="0,0,2,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HarnessTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HarnessTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              PanningMode="HorizontalOnly">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="4,2,4,0" />
                                </ScrollViewer>
                            </Border>
                            <!-- 名前は PART_SelectedContentHost（UIA が選択中タブの中身を繋ぐため。DebugView 参照） -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyNotice" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 頭の帯：周辺視野（§37.1）。進捗率のような根拠の無い数字は出さない -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgAlt}" Padding="8,4"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Style="{StaticResource Dim}" Text="Run" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding RunsLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="受け入れ／差し戻し" ToolTip="人間の判定（.harness/runs/verdicts.json）" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding VerdictsLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="受け入れ1件あたり"
                           ToolTip="失敗・差し戻し・未判定を含む総トークン ÷ 受け入れ件数（成功だけの平均にしない）" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TokensPerAcceptedLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="総トークン" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TotalTokensLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="キャッシュ読込" ToolTip="cache_read ÷（input + cache_read + cache_creation）" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CacheLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="ツール失敗" ToolTip="is_error ÷ ツール呼び出し（人間の拒否は除く）" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ErrorRateLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="費用" ToolTip="CLI が記録した料金（cost-state）。記録の無い Run は推計で埋めない" />
                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CostLabel}" />
                <TextBlock Style="{StaticResource Dim}" Text="{Binding HarnessLabel}" Margin="0,0,14,0" />
                <TextBlock Style="{StaticResource Dim}" Text="{Binding StatusText}" Foreground="{DynamicResource Accent}" />
            </WrapPanel>
        </Border>

        <Grid>
            <TabControl Style="{StaticResource HarnessTabControl}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                <!-- ===== 改善候補（中心画面） ===== -->
                <TabItem Header="改善候補">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="120" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.3*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="構成要素"
                                       ToolTip="選ぶと、その要素に関連しそうな候補に絞る（関連は推測）" />
                            <ListBox Style="{StaticResource HarnessList}" ItemsSource="{Binding Components}"
                                     SelectedItem="{Binding SelectedComponent}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding ToolTip}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CandidateCountLabel}"
                                                       Style="{StaticResource Dim}" Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding KindLabel}"
                                                       Style="{StaticResource Dim}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />

                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top">
                                <CheckBox DockPanel.Dock="Right" Margin="0,3,8,0" VerticalAlignment="Center"
                                          FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                          Content="1 Run だけの候補を隠す" IsChecked="{Binding HideSingleRunCandidates}"
                                          ToolTip="1回きりの出来事は、ハーネスの直し所というより偶然であることが多い（再発は隠さない）" />
                                <CheckBox DockPanel.Dock="Right" Margin="0,3,8,0" VerticalAlignment="Center"
                                          FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                          Content="対処済みも表示" IsChecked="{Binding ShowHandledCandidates}"
                                          ToolTip="対処中・対処済み・見送りの候補も並べる（既定は未対処と再発だけ）" />
                                <TextBlock Style="{StaticResource ColumnTitle}" Text="改善候補（頻度順・推定トークンは文字数÷4）" />
                            </DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                                <Button Style="{StaticResource SmallButton}" Content="まとめて改善プロンプトをコピー"
                                        ToolTip="一覧に出ている未対処・再発の候補を1つのプロンプトにしてコピーし「対処中」にする。Claude Code に貼って直させる"
                                        Command="{Binding CopyBulkPromptCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="対処中を対処済みに"
                                        ToolTip="エージェントが直し終えたら押す。これより後に起きたものだけが「再発」として戻る"
                                        Command="{Binding ResolveAddressingCommand}" />
                            </WrapPanel>
                            <Grid>
                                <ListBox x:Name="CandidateList" Style="{StaticResource HarnessList}"
                                         ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border x:Name="mark" DockPanel.Dock="Left" Width="3" Margin="0,1,6,1"
                                                        Background="{DynamicResource Accent}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding EstimateLabel}"
                                                           Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RunCountLabel}"
                                                           Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryLabel}"
                                                           Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock x:Name="standing" DockPanel.Dock="Right" Text="{Binding StandingLabel}"
                                                           Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock x:Name="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHandled}" Value="True">
                                                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource FgDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRecurred}" Value="True">
                                                    <Setter TargetName="standing" Property="Foreground" Value="{DynamicResource Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRework}" Value="True">
                                                    <Setter TargetName="mark" Property="Background" Value="{DynamicResource Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsQuality}" Value="True">
                                                    <Setter TargetName="mark" Property="Background" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyNotice}" Text="{Binding EmptyMessage}" />
                            </Grid>
                        </DockPanel>

                        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />

                        <!-- 根拠：どの Run で起きたか／関連しそうな構成要素／方向（推測） -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="60" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="120" MinHeight="40" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="8,4,8,4"
                                        Visibility="{Binding HasSelectedCandidate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Dim}" Text="観測事実" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CandidateObservation}" TextWrapping="Wrap" Margin="0,1,0,4"
                                           Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                <TextBlock Style="{StaticResource Dim}" Text="改善の方向（推測）" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CandidateDirection}" TextWrapping="Wrap" Margin="0,1,0,4"
                                           Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                <TextBlock Style="{StaticResource Dim}" Text="関連しそうな構成要素（推測）" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CandidateRelated}" TextWrapping="Wrap" Margin="0,1,0,6"
                                           Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                <TextBlock Text="{Binding CandidateStatusText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource Dim}" />
                                <WrapPanel>
                                    <Button Style="{StaticResource SmallButton}" Content="タスクにする"
                                            ToolTip=".harness/tasks/ に観測事実・根拠・方向を書き出してエディタで開く"
                                            Command="{Binding CreateTaskCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="コピー"
                                            ToolTip="同じ本文を Markdown でクリップボードへ（エージェントへ渡すとき）"
                                            Command="{Binding CopyCandidateCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="記録を開く"
                                            ToolTip="選んだ根拠の記録（transcript）をエディタで開いて該当行へ"
                                            Command="{Binding OpenEvidenceRecordCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="ファイルを開く"
                                            ToolTip="選んだ根拠で読まれた／変更されたファイルを開く"
                                            Command="{Binding OpenEvidenceFileCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="対処済み"
                                            ToolTip="直した。これより後に起きたものだけが「再発」として戻る"
                                            Command="{Binding ResolveCandidateCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="見送り"
                                            ToolTip="直さない（偶然・誤検出）。再発しても上げない"
                                            Command="{Binding DismissCandidateCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="扱いを外す"
                                            Command="{Binding ClearCandidateStateCommand}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource ColumnTitle}" Margin="0,8,0,0" Text="根拠（新しい順・ダブルクリックで記録を開く）" />
                            </StackPanel>
                            <ListBox x:Name="EvidenceList" Grid.Row="1" Style="{StaticResource HarnessList}"
                                     ItemsSource="{Binding Evidence}" SelectedItem="{Binding SelectedEvidence}"
                                     FontSize="{DynamicResource Fs12}" MouseDoubleClick="OnEvidenceDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding ToolTip}">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="84" Style="{StaticResource Dim}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Tool}" Width="70"
                                                       Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CharsLabel}" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RunTitle}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />
                            <TextBox Grid.Row="3" Style="{StaticResource DetailBox}" Text="{Binding EvidenceDetail, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== 実行（Run の一覧と、選んだ Run のツール呼び出し） ===== -->
                <TabItem Header="実行">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.2*" MinWidth="240" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="Run（新しい順）" />
                            <Grid>
                                <ListBox Style="{StaticResource HarnessList}" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock x:Name="verdict" DockPanel.Dock="Right" Text="{Binding VerdictLabel}"
                                                           Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorsLabel}"
                                                           Foreground="{DynamicResource Error}" FontSize="{DynamicResource Fs11}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TokensLabel}" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" Style="{StaticResource Dim}" Margin="8,0,0,0"
                                                           FontFamily="Cascadia Mono, Consolas" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TasksLabel}" Foreground="{DynamicResource Accent}"
                                                           FontSize="{DynamicResource Fs11}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding TasksLabel}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Started}" Width="84" Style="{StaticResource Dim}" />
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAccepted}" Value="True">
                                                    <Setter TargetName="verdict" Property="Foreground" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                    <Setter TargetName="verdict" Property="Foreground" Value="{DynamicResource Error}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyNotice}" Text="{Binding EmptyMessage}" />
                            </Grid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="60" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="120" MinHeight="40" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="8,4" Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolToVis}}">
                                <TextBox Style="{StaticResource DetailBox}" Background="Transparent" TextWrapping="Wrap"
                                         FontFamily="{x:Static SystemFonts.MessageFontFamily}" FontSize="{DynamicResource Fs12}"
                                         Text="{Binding RunDetail, Mode=OneWay}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="受け入れ" Command="{Binding AcceptRunCommand}"
                                            ToolTip="この Run の成果を受け入れた（.harness/runs/verdicts.json に記録）" />
                                    <Button Style="{StaticResource SmallButton}" Content="差し戻し" Command="{Binding RejectRunCommand}"
                                            ToolTip="この Run の成果を受け入れなかった" />
                                    <Button Style="{StaticResource SmallButton}" Content="判定を外す" Command="{Binding ClearVerdictCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="記録を開く" Command="{Binding OpenRunRecordCommand}"
                                            ToolTip="選んだツール呼び出し（無ければ Run の先頭）の記録をエディタで開く" />
                                    <Button Style="{StaticResource SmallButton}" Content="チケットを開く" Command="{Binding OpenRunTicketCommand}"
                                            Visibility="{Binding SelectedRun.HasTicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                            ToolTip="この Run の指示に書かれたチケットをブラウザペインで開く" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource ColumnTitle}" Margin="0,8,0,0" Text="ツール呼び出し（↳＝サブエージェント）" />
                            </StackPanel>
                            <ListBox Grid.Row="1" Style="{StaticResource HarnessList}" ItemsSource="{Binding RunCalls}"
                                     SelectedItem="{Binding SelectedCall}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs11}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="64" Foreground="{DynamicResource FgDim}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Tool}" Width="96" x:Name="tool"
                                                       Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CharsLabel}" x:Name="chars"
                                                       Foreground="{DynamicResource FgDim}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Summary}" x:Name="summary" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Fg}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="tool" Property="Foreground" Value="{DynamicResource Error}" />
                                                <Setter TargetName="summary" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                                <Setter TargetName="chars" Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="chars" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />
                            <TextBox Grid.Row="3" Style="{StaticResource DetailBox}" Text="{Binding CallDetail, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== 構成（設定されているもの＋観測された使用） ===== -->
                <TabItem Header="構成">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" TextWrapping="Wrap"
                                   Text="{Binding ConfigNote}" />
                        <ListBox Style="{StaticResource HarnessList}" ItemsSource="{Binding ConfigRows}"
                                 SelectedItem="{Binding SelectedConfig}" MouseDoubleClick="OnConfigDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="ダブルクリックで定義ファイルを開く">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding KindLabel}" Width="90" Style="{StaticResource Dim}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="200" TextTrimming="CharacterEllipsis" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Usage}" Width="80" Style="{StaticResource Dim}"
                                                   ToolTip="期間内の使用（観測）。Skill とサブエージェントだけ回数が記録に残る" />
                                        <TextBlock Text="{Binding PathLabel}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- ===== 版の比較（§37.6） ===== -->
                <TabItem Header="版の比較">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" TextWrapping="Wrap"
                                   Text="版＝Run 開始時点で .harness / CLAUDE.md / AGENTS.md / .claude を最後に変えたコミット（未コミットの変更は区別できない）。試行が少ない版の差で改善と判断しない。" />
                        <!-- 見出し行（GridView の既定ヘッダーはテーマに乗らないので、行と同じ並びで自前に描く） -->
                        <Border DockPanel.Dock="Top" Padding="6,2" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource FgDim}"
                                        TextElement.FontSize="{DynamicResource Fs11}">
                                <TextBlock Width="280" Text="版" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Width="90" Text="日付" Margin="0,0,8,0" />
                                <TextBlock Width="50" Text="Run" Margin="0,0,8,0" />
                                <TextBlock Width="80" Text="受入／差戻" Margin="0,0,8,0" />
                                <TextBlock Width="120" Text="受け入れ1件あたり" Margin="0,0,8,0" />
                                <TextBlock Width="90" Text="1 Run あたり" Margin="0,0,8,0" />
                                <TextBlock Width="80" Text="ツール失敗" Margin="0,0,8,0" />
                                <TextBlock Width="70" Text="候補/Run" Margin="0,0,8,0" />
                                <TextBlock Width="100" Text="" Margin="0,0,8,0" />
                            </StackPanel>
                        </Border>
                        <ListBox Style="{StaticResource HarnessList}" ItemsSource="{Binding Versions}" FontSize="{DynamicResource Fs12}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                <TextBlock Width="280" Text="{Binding VersionLabel}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Width="90" Text="{Binding DateLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="50" Text="{Binding RunsLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="80" Text="{Binding VerdictsLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="120" Text="{Binding TokensPerAcceptedLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="90" Text="{Binding TokensPerRunLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="80" Text="{Binding ErrorRateLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="70" Text="{Binding CandidatesPerRunLabel}" Margin="0,0,8,0" />
                                <TextBlock Width="100" Text="{Binding Note}" Margin="0,0,8,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- ===== 点検（§37.10：§37.3 の最小構造と突き合わせて、何が無いかと、なぜ今それが要るか） ===== -->
                <TabItem Header="点検">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="0,3,8,3"
                                    Content="足りないものをまとめて作る" Command="{Binding CreateAllMissingCommand}"
                                    ToolTip="無い必須・推奨の雛形を .harness/ に書き出す（任意の項目と既にあるファイルは触らない）" />
                            <TextBlock Style="{StaticResource ColumnTitle}" TextWrapping="Wrap" Text="{Binding CheckSummary}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.2*" MinWidth="240" />
                            </Grid.ColumnDefinitions>
                            <ListBox Grid.Column="0" Style="{StaticResource HarnessList}" ItemsSource="{Binding CheckRows}"
                                     SelectedItem="{Binding SelectedCheck}" MouseDoubleClick="OnCheckDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock x:Name="status" DockPanel.Dock="Left" Text="{Binding StatusLabel}" Width="60"
                                                       FontSize="{DynamicResource Fs11}" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource Accent}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding LevelLabel}" Width="36"
                                                       Style="{StaticResource Dim}" VerticalAlignment="Top" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding EvidenceMark}" Style="{StaticResource Dim}"
                                                       VerticalAlignment="Top" Margin="8,0,0,0"
                                                       ToolTip="記録の観測が、これが今要る理由を裏づけている" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Finding}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Error}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" />
                            <DockPanel Grid.Column="2" Visibility="{Binding HasSelectedCheck, Converter={StaticResource BoolToVis}}">
                                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,4">
                                    <TextBlock Style="{StaticResource Dim}" Text="何のためか" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedCheck.Item.Purpose}" TextWrapping="Wrap" Margin="0,1,0,4"
                                               Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                    <TextBlock Style="{StaticResource Dim}" Text="現状" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedCheck.Item.Finding}" TextWrapping="Wrap" Margin="0,1,0,4"
                                               Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}" />
                                    <TextBlock Style="{StaticResource Dim}" Text="根拠（観測）" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,1,0,6" Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}"
                                               Text="{Binding SelectedCheck.Item.Evidence, TargetNullValue='期間内の記録からは、まだ裏づけが無い。'}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SmallButton}" Content="作る" Command="{Binding CreateScaffoldCommand}"
                                                Visibility="{Binding SelectedCheck.CanScaffold, Converter={StaticResource BoolToVis}}"
                                                ToolTip="下の雛形を .harness/ に書き出してエディタで開く（既にあるファイルは上書きしない）" />
                                        <Button Style="{StaticResource SmallButton}" Content="開く" Command="{Binding OpenCheckCommand}"
                                                Visibility="{Binding SelectedCheck.CanOpen, Converter={StaticResource BoolToVis}}"
                                                ToolTip="既にある定義ファイルをエディタで開く" />
                                        <Button Style="{StaticResource SmallButton}" Content="実行タブへ" Command="{Binding GoToRunsCommand}"
                                                Visibility="{Binding SelectedCheck.IsVerdicts, Converter={StaticResource BoolToVis}}"
                                                ToolTip="判定は Run に付ける（受け入れ／差し戻し）" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource ColumnTitle}" Margin="0,8,0,0"
                                               Text="雛形（観測したコマンドを入れてある・作ってから人間が直す）" />
                                </StackPanel>
                                <TextBox Style="{StaticResource DetailBox}" Text="{Binding CheckPreview, Mode=OneWay}" />
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
