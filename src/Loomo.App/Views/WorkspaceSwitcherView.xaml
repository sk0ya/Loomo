<UserControl x:Class="sk0ya.Loomo.App.Views.WorkspaceSwitcherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 絞り込み欄の隣に置く表示切替ボタン（BranchSwitcherView の帯のボタンと同じ手触り）。 -->
        <Style x:Key="WorkspaceOpButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行の中に置くピン留めトグル。押しても行の切替は起こさない（OnListClick が Button 上を無視する）。
             留めていない行では消しておく——常に薄く出していると、留めた行との差が読めない。
             行にマウスが載ったときだけ薄く現れ、留めた行では常時はっきり出す。 -->
        <Style x:Key="RowPinButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 行ごとのフォルダー表示トグル。ピン留めと同じ作法で、行にマウスが載ったときだけ薄く現れる
             （常時出していると、名前より印の方が目立つ一覧になる）。開いた状態は保存しない一時的なもの。 -->
        <Style x:Key="RowFolderToggle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 展開したときにぶら下がるフォルダー行。行の切替クリックとは別物なので Tag で見分ける
             （<c>WorkspaceSwitcherView.FindRow</c> がここで打ち切ってワークスペースを切り替えない）。 -->
        <Style x:Key="FolderRow" TargetType="Border">
            <Setter Property="Tag" Value="folder" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgAlt}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="4" Padding="4"
            MinWidth="400" MaxWidth="640" Margin="0,2,8,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>

        <DockPanel>
            <!-- ===== フッター：一覧に無いものを足す＋この場発の操作が失敗した理由 =====
                 ブランチ切替の「＋ 新しいブランチ」と同じ位置づけ。ここはワークスペースの一覧なので
                 足せるのはワークスペースだけ——いま開いているワークスペースへのフォルダー追加は
                 一覧に対する操作ではないので置かない（エクスプローラ側の「フォルダーをワークスペースに
                 追加」ボタンが持ち場）。 -->
            <StackPanel DockPanel.Dock="Bottom">
                <Border Height="1" Background="{DynamicResource Border}" Margin="2,4" />
                <Button Style="{StaticResource BranchMenuItem}" FontSize="{DynamicResource Fs12}"
                        Content="＋ フォルダーを開いてワークスペースにする" Click="OnOpenFolderClick" />
                <TextBlock x:Name="StatusText" Margin="10,2,10,4" FontSize="{DynamicResource Fs11}"
                           Foreground="#FFE57373" TextWrapping="Wrap"
                           MaxHeight="80" Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== 絞り込み（名前・パス。空白区切りは AND）＋一覧の表示切替 =====
                 パスのコピー・エクスプローラ・名前の変更は<em>1件に効く操作</em>なので、ここには置かず
                 行の右クリックに集約する（現在のワークスペースの行も一覧に居るので特別扱いは要らない）。
                 ブランチ切替の同期帯にあたる「リポジトリ全体に効く重い操作」はワークスペースには無い。 -->
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
                <!-- 一覧の表示切替：各ワークスペースのフォルダー（ルート＋マルチルートの追加ぶん）を
                     行の下にまとめて出す＝パス一覧として読むモード。1件だけ見たいときは行のホバーで
                     現れる「🗂」を使う（どちらも保存しない一時的な表示状態）。 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource WorkspaceOpButton}"
                        Margin="4,0,0,0" Height="24"
                        ToolTip="すべてのワークスペースのフォルダー（ルート＋追加ぶん）をまとめて表示／非表示"
                        Click="OnToggleAllFoldersClick">
                    <!-- 点灯（表示中＝アクセント色）は中の TextBlock に直接掛ける。ボタンの Foreground を
                         変えても、既定の TextBlock スタイルが Fg を明示指定しているので content には効かない。 -->
                    <TextBlock Text="🗂 パス" FontSize="{DynamicResource Fs12}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFolders}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Grid>
                    <TextBox x:Name="FilterBox" MinHeight="24" Padding="6,3"
                             VerticalContentAlignment="Center"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             PreviewKeyDown="OnFilterKeyDown" />
                    <TextBlock Text="🔍 名前・パスで絞り込み" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs12}" Margin="8,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="{Binding Filter, Converter={StaticResource EmptyToVis}}" />
                </Grid>
            </DockPanel>

            <!-- ===== ワークスペース一覧 =====
                 クリック（Enter）＝そのワークスペースへ切替。ピン留めは行内のトグル、
                 それ以外の1件ぶんの操作は右クリックメニュー。 -->
            <ListBox x:Name="List" MaxHeight="360"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding FilteredWorkspaces}"
                     SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="OnListClick"
                     PreviewMouseRightButtonDown="OnListRightClickSelect"
                     PreviewKeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- ホバー／選択の塗りは DataTemplate 側の見出し行だけに付ける（ここで塗ると、
                             展開したフォルダー行まで一緒に光って「行が1件」に見えなくなる）。 -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="このワークスペースへ切替" Click="OnMenuActivate" />
                                    <MenuItem Header="ピン留め／解除" Click="OnMenuTogglePin" />
                                    <Separator />
                                    <MenuItem Header="名前を変更…" Click="OnMenuRename" />
                                    <MenuItem Header="パスをコピー" Click="OnMenuCopyPath" />
                                    <MenuItem Header="エクスプローラで開く" Click="OnMenuReveal" />
                                    <Separator />
                                    <MenuItem Header="一覧から削除（フォルダは消えません）" Click="OnMenuRemove" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <!-- 見出し行（ワークスペース本体）。ホバー／選択の塗りはこの行だけ。 -->
                        <Border Padding="4,2" CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BgAlt}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Border}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        <DockPanel ToolTip="{Binding ToolTip}" Background="Transparent">
                            <!-- ピン留めトグル（留めている行は常時、それ以外はホバーで浮く） -->
                            <Button DockPanel.Dock="Left" Style="{StaticResource RowPinButton}"
                                    Content="📌" FontSize="{DynamicResource Fs10}"
                                    ToolTip="ピン留め（一覧の上部に固定）"
                                    Click="OnRowPinClick" />

                            <!-- 現在開いている印。文字の ● はフォント次第で潰れるので図形で描く。
                                 Hidden で幅を残す（有無で名前の左端がずれると一覧として読めない） -->
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="4,0,6,0"
                                     Fill="{DynamicResource Accent}" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- 右側：最終利用と、ホバーで現れるフォルダー表示トグル -->
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastUsedLabel}"
                                       FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource FgDim}"
                                       VerticalAlignment="Center" Margin="8,0,2,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource RowFolderToggle}"
                                    Content="🗂" FontSize="{DynamicResource Fs10}"
                                    Foreground="{DynamicResource FgDim}"
                                    ToolTip="このワークスペースのフォルダー（ルート＋追加ぶん）を表示／非表示"
                                    Click="OnRowFoldersClick" />
                            <TextBlock DockPanel.Dock="Right" Text="見つかりません"
                                       FontSize="{DynamicResource Fs10}" Foreground="#FFE57373"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       ToolTip="ルートフォルダが存在しません（切り替えても内容は復元できません）"
                                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}" />
                            <!-- 左：名前。パスは行に出さず ToolTip へ（1行1件の密度を優先。同名フォルダの
                                 見分けは ToolTip とフィルタでできる） -->
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Fs12}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        </Border>

                        <!-- 開いたときのフォルダー行（プライマリ以外）。切替の対象ではないので
                             ListBox の項目にはせず、見出し行の下にぶら下げる。右クリックでこの
                             フォルダー1つに効く操作（パスのコピー・エクスプローラ・取り除く）。 -->
                        <ItemsControl ItemsSource="{Binding Folders}" Margin="38,1,0,3"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FolderRow}" ToolTip="{Binding Path}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="パスをコピー" Click="OnFolderMenuCopyPath" />
                                                <MenuItem Header="エクスプローラで開く" Click="OnFolderMenuReveal" />
                                                <Separator />
                                                <!-- ルートは外せない（それはワークスペースを消すこと） -->
                                                <MenuItem Header="ワークスペースから取り除く（フォルダは消えません）"
                                                          Click="OnFolderMenuRemove"
                                                          IsEnabled="{Binding IsPrimary,
                                                              Converter={StaticResource InverseBool}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="↳" Margin="0,0,5,0"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource FgDim}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="ルート" Margin="8,0,2,0"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource FgDim}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="ワークスペースのルートフォルダ（取り除けません）"
                                                       Visibility="{Binding ShowPrimaryTag,
                                                           Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Path}" FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource FgDim}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
