<UserControl x:Class="sk0ya.Loomo.App.Views.TodoTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
    FontSize="{DynamicResource Fs12}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:TodoGroup}" ItemsSource="{Binding Entries}">
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:TodoEntry}">
            <StackPanel ToolTip="{Binding ToolTip}">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Hit.RelativePath}" Foreground="{DynamicResource FgDim}"
                           FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GroupByTag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="↻" Style="{StaticResource PaneHeaderGhostButton}" Command="{Binding RefreshCommand}" ToolTip="再検索"
                        AutomationProperties.Name="TODO を再検索" Padding="5,0" />
                <TextBlock Text="TODO TREE" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="8,5">
            <DockPanel>
            <TextBlock Text="絞込" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="本文・タグ・ファイル名で絞り込み"
                     AutomationProperties.Name="TODO の絞り込み" />
            </DockPanel>
            <DockPanel Margin="0,5,0,0">
                <CheckBox Content="タグ別" IsChecked="{Binding GroupByTag}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="除外" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding ExcludeGlob, UpdateSourceTrigger=PropertyChanged}" ToolTip="除外 glob（例: **/generated/**）。空欄でも検索基盤の標準除外が適用されます"
                         AutomationProperties.Name="TODO 検索の除外 glob" />
            </DockPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource FgDim}"
                   FontSize="{DynamicResource Fs11}" TextWrapping="Wrap" Margin="8,4" />
        <TreeView x:Name="TodoTree" ItemsSource="{Binding Groups}" BorderThickness="0"
                  Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                  SelectedItemChanged="OnSelectedItemChanged" PreviewKeyDown="OnTreeKeyDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource BranchTreeItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </DockPanel>
</UserControl>
