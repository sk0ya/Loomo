<Window x:Class="sk0ya.Loomo.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:sk0ya.Loomo.App.Views"
        Title="設定 — Loomo"
        Width="820" Height="620" MinWidth="520" MinHeight="320"
        Background="{DynamicResource Panel}"
        Foreground="{DynamicResource Fg}"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 本体・切り離しウィンドウと同じ自前キャプション方式（WindowChrome はリサイズ枠のみ担当）。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsCaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- キャプション：左は空きスペース（ドラッグでウィンドウ移動）、右にボタン。
             タイトル文字は左ナビの「設定」見出しが兼ねるので置かない。 -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource BgAlt}"
              MouseLeftButtonDown="OnCaptionMouseDown">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button Style="{StaticResource SettingsCaptionButton}" Content="—"
                        FontSize="{DynamicResource Fs13}" ToolTip="最小化" Click="OnMinimize" />
                <Button x:Name="MaxRestoreButton" Style="{StaticResource SettingsCaptionButton}" Content="□"
                        FontSize="{DynamicResource Fs13}" ToolTip="最大化/元に戻す" Click="OnMaxRestore" />
                <Button Style="{StaticResource SettingsCaptionButton}" Content="✕"
                        FontSize="{DynamicResource Fs13}" ToolTip="閉じる（Esc）" Click="OnCloseWindow" />
            </StackPanel>
        </Grid>

        <views:SettingsView x:Name="Settings" />
    </DockPanel>
</Window>
