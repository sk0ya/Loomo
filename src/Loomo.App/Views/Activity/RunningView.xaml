<UserControl x:Class="sk0ya.Loomo.App.Views.RunningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:sk0ya.Loomo.App.ViewModels"
    xmlns:svc="clr-namespace:sk0ya.Loomo.App.Services"
    Background="{DynamicResource BgAlt}" Foreground="{DynamicResource Fg}"
    FontSize="{DynamicResource Fs12}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="RunningVisibility" />
        <!-- 行全体が押せるボタン。押すとその出所（タブ・ペイン）へ行く。 -->
        <Style x:Key="RunningRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4,28,4">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RunningItemTemplate" DataType="{x:Type vm:RunningItemViewModel}">
            <!-- Tag に面の VM を持たせ、右クリックのメニュー（視覚ツリーの外）から命令を引けるようにする。 -->
            <Grid x:Name="RowRoot" Margin="2,0"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ContextMenu>
                    <!-- 行のテンプレートの中に置く（Style の Setter に置くと Click が結線されない）。 -->
                    <ContextMenu>
                        <MenuItem Header="あとで（状態が変わったら戻す）"
                                  Visibility="{Binding IsSnoozed, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.Tag.SnoozeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="あとでをやめる"
                                  Visibility="{Binding IsSnoozed, Converter={StaticResource RunningVisibility}}"
                                  Command="{Binding PlacementTarget.Tag.UnsnoozeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Button Style="{StaticResource RunningRowButton}" ToolTip="{Binding ToolTip}"
                        AutomationProperties.Name="{Binding Title}"
                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon" Text="{Binding Icon}" Foreground="{DynamicResource FgDim}"
                                   VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Fs12_5}" />
                            <TextBlock x:Name="Detail" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Elapsed}" FontFamily="Consolas"
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource FgDim}"
                                   Margin="6,1,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Button>
                <!-- 止める：ターミナルは Ctrl+C を送る、デバッグはセッションを止める。 -->
                <Button x:Name="StopButton" Content="■" Style="{StaticResource PaneHeaderGhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        ToolTip="止める（ターミナルは Ctrl+C を送る）" AutomationProperties.Name="止める"
                        Visibility="{Binding CanStop, Converter={StaticResource RunningVisibility}}"
                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static svc:RunningEntryTone.Attention}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static svc:RunningEntryTone.Failed}">
                    <Setter TargetName="Icon" Property="Foreground" Value="#E57373" />
                    <Setter TargetName="Detail" Property="Foreground" Value="#E57373" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static svc:RunningEntryTone.Quiet}">
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource FgDim}" />
                </DataTrigger>
                <!-- 「あとで」の行は薄く（§24.71）。 -->
                <DataTrigger Binding="{Binding IsSnoozed}" Value="True">
                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,5,4,5">
            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis">
                <Run Text="動いているもの" FontWeight="SemiBold" /><Run Text="  " /><Run
                     Text="{Binding RunningCount, Mode=OneWay, StringFormat={}{0}件}" Foreground="{DynamicResource FgDim}" />
            </TextBlock>
        </Border>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RunningList" ItemsSource="{Binding View}" Margin="2,4"
                              ItemTemplate="{StaticResource RunningItemTemplate}" Focusable="False">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FgDim}"
                                               FontSize="{DynamicResource Fs10}" Margin="10,6,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="いま部屋の中で動いているものはありません"
                       Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource RunningVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
