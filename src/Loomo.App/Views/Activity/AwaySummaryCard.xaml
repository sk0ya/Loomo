<UserControl x:Class="sk0ya.Loomo.App.Views.AwaySummaryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 「留守中に起きたこと」（§24.22）。DataContext は AwaySummaryViewModel。トーストと同じ右下の束の上段に置き、
         自動では消えない。各行を押すとその出来事の次の一手（差分・出力・ファイル）を開く。 -->
    <Border Width="420" Margin="0,6,0,0"
            Background="{DynamicResource Panel}" CornerRadius="4" Padding="10,8"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="20" Height="20"
                        VerticalAlignment="Top" Content="×" Foreground="{DynamicResource FgDim}"
                        ToolTip="閉じる" Command="{Binding CloseCommand}" />
                <!-- 日報の下書きなどへ貼れるよう、並んでいる行を Markdown でクリップボードへ（§24.23）。 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Height="20" Padding="6,0"
                        Margin="0,0,2,0" VerticalAlignment="Top" Content="コピー" Foreground="{DynamicResource FgDim}"
                        FontSize="{DynamicResource Fs11}"
                        ToolTip="この一覧を Markdown でコピー（日報の下書きに）" Command="{Binding CopyCommand}" />
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Fg}"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Counts}" Foreground="{DynamicResource FgDim}"
                               FontSize="{DynamicResource Fs11}" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BranchMenuItem}" HorizontalContentAlignment="Stretch"
                                    Padding="4,3" Margin="0,1,0,0"
                                    ToolTip="{Binding Detail}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="KindGlyph" Grid.Column="0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FgDim}" FontSize="{DynamicResource Fs11}" Text="›" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                                   FontSize="{DynamicResource Fs12}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource FgDim}"
                                                   FontSize="{DynamicResource Fs11}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="BadgeText" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding Badge}" Foreground="{DynamicResource Success}"
                                               FontSize="{DynamicResource Fs11}" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Command">
                                    <Setter TargetName="KindGlyph" Property="Text" Value="›_" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Git">
                                    <Setter TargetName="KindGlyph" Property="Text" Value="⎇" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="File">
                                    <Setter TargetName="KindGlyph" Property="Text" Value="✎" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Bookmark">
                                    <Setter TargetName="KindGlyph" Property="Text" Value="⚑" />
                                    <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
