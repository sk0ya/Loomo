<UserControl x:Class="sk0ya.Loomo.App.Views.TerminalPeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource Fg}" FontSize="{DynamicResource Fs12}">
    <!-- タブを切り替えずに覗く窓（§24.108）。上にそのタブの画面の末尾、下に 1 行の入力欄。Enter で送り、Esc で閉じる。 -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="4" Padding="8,6" Width="620">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="Enter で送る・Esc で閉じる" Foreground="{DynamicResource FgDim}"
                           FontSize="{DynamicResource Fs11}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run
                         Text="  を覗いています（タブは切り替えていません）" Foreground="{DynamicResource FgDim}"
                         FontSize="{DynamicResource Fs11}" />
                </TextBlock>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource FgDim}"
                           FontSize="{DynamicResource Fs11}" Margin="2,3,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Left" Text="›" Foreground="{DynamicResource Accent}" Margin="2,0,6,0"
                           VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}" Padding="4,2"
                         IsEnabled="{Binding IsUnavailable, Converter={StaticResource InverseBool}}"
                         AutomationProperties.Name="このタブへ送る文字列"
                         ToolTip="このタブへ送る文字列。Enter で送る（空なら Enter だけ）。Ctrl+C などの制御キーは送らない"
                         PreviewKeyDown="OnInputPreviewKeyDown" />
            </DockPanel>
            <TextBox x:Name="ScreenBox" Text="{Binding ScreenText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     TextWrapping="NoWrap" BorderThickness="0" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Fs12}" Padding="6,4"
                     Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="このタブの画面の末尾" TextChanged="OnScreenTextChanged" />
        </DockPanel>
    </Border>
</UserControl>
