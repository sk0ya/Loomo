<Project>

  <!-- 実行環境を win-x64 に固定する（ソリューション全体に横展開）。

       RID 未指定の framework-dependent ビルドでは、NuGet パッケージのネイティブ資産
       （runtimes/<rid>/native/…）が全 RID 分そのまま出力へコピーされ、実行時に deps.json の
       runtimeTargets から現在の RID に合うものだけがロードされる。Loomo は Windows 専用の
       WPF アプリなのに、ONNX Runtime GenAI / LLamaSharp / SQLitePCLRaw が 1 パッケージで
       全プラットフォームを同梱する作りのため、android の .aar や ios の .xcframework.zip、
       linux-arm64 の libonnxruntime-genai.so（単体 192MB）まで出力されて runtimes/ だけで
       862MB あった（App と Tests でそれぞれ）。RID を固定すると win-x64 の分だけが出力ルート
       直下へ平坦にコピーされる。 -->
  <PropertyGroup>
    <!-- 通常は公開パッケージ（nuget.org の sk0ya.Editor.Controls）を参照する。
         Editor 側を同時に直しながら動かすときだけ -p:UseLocalEditor=true として
         C:\Projects\Editor のプロジェクト参照へ切り替える。

         1.0.90 でガターのクイックフィックス電球とスクロールバーの診断マーカーを公開した。
         1.0.100（Vim 無効時の IDE 標準キー・Ctrl+クリックで定義へ・workspace/configuration の受け口・
         常に合流するホスト補完候補。§36 が使う）（2026-10-11 公開）。
         1.0.101（フッターの改行・文字コード表示のクリック〔FileFormatClicked／FileEncodingClicked〕と、
         保存時の改行・文字コードを切り替える SetFileFormat／SetFileEncoding。§23.3.4 が使う）（2026-10-17 公開）。
         1.0.103（折りたたみの保存・復元 GetClosedFolds／RestoreClosedFolds と、カーソル行の blame ShowCaretLineBlame。
         §24.42・§24.43 が使う）（2026-10-18 公開）。
         1.0.104（VimEditorControlOptions.WatchFileOnDisk でエディタの監視を切り、VimEditorControl.ReloadFromDisk で取り消せる読み直し。
         §24.57 が使う）（2026-10-19 公開）。
         1.0.106（Vim の移動・挿入の打鍵あたりの費用。§31.20）（2026-10-24 公開）を nuget.org 最新版として使用する。 -->
    <UseLocalEditor Condition="'$(UseLocalEditor)' == ''">false</UseLocalEditor>
    <EditorPackageVersion Condition="'$(EditorPackageVersion)' == ''">1.0.108</EditorPackageVersion>
    <!-- sk0ya.Terminal.Controls の版。本体（Loomo.Services）と端末の常駐ホスト（Loomo.Pty.Host、§34）が
         同じ版を参照するので、ここ一か所で決める。版ごとの変更点は Loomo.Services.csproj の注記にある。 -->
    <TerminalPackageVersion Condition="'$(TerminalPackageVersion)' == ''">1.0.49</TerminalPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- RID 指定は自己完結（ランタイム同梱）を意味しない。既定に頼らず明示する。 -->
    <SelfContained>false</SelfContained>
    <!-- 出力先に RID のサブフォルダを付けない。Loomo.App は AppendTargetFrameworkToOutputPath=false で
         exe のパスを bin/Debug/ に固定しており（タスクバー等のショートカットが古い exe を指さないため）、
         RID を付けると bin/Debug/win-x64/ へずれて同じ事故が起きる。 -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- 翻訳リソース（サテライトアセンブリ）は日本語だけ出力する。Roslyn や Humanizer は 13 言語分を
         同梱しており、指定しないと cs/de/es/…/zh-Hant の 13 フォルダ（出力ごとに約 10MB・78 ファイル）が
         App・Tests・各ライブラリの bin に出る。英語はアセンブリ本体に入っているので指定不要。 -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
