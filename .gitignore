*.suo
*.userprefs
*.sln.docstates

# Rider
*.sln.iml

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
!packages/
*.nuget.props
*.nuget.targets

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

